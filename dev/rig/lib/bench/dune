(library
 (name rig_bench)
 (modules)
 (libraries rig_edge)
 (foreign_stubs
  (language c)
  (names rig_bench_stubs)))

(executable
 (name bench_core)
 (modules bench_core)
 (libraries rig rig_bench rig_support thumper))

; The GPU rows link every GPU driver, which makes each full collection longer:
; they run in an executable of their own, beside the host rows' lean one.

(executable
 (name bench_gpu)
 (modules bench_gpu)
 (libraries
  rig
  rig_bench
  rig_metal
  rig_cuda
  rig_amd
  rig_amd_amdgpu
  rig_nv
  rig_nv_nvidia
  rig_metal_support
  rig_cuda_support
  rig_nv_support
  rig_amd_support
  rig_amd_abi
  thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper)
  (source_tree fixtures))
 (action
  (progn
   (run %{exe:bench_core.exe})
   (run %{exe:bench_gpu.exe}))))
