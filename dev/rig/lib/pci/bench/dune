(library
 (name rig_pci_bench_probe)
 (modules)
 (libraries rig_pci)
 (foreign_stubs
  (language c)
  (names bench_window_stubs)))

(executable
 (name bench_window)
 (modules bench_window)
 (libraries rig_pci rig_pci_bench_probe thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_window.exe})))

