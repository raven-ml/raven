; The channels take GPU addresses below 2^40, which on x86_64 lie in
; AddressSanitizer's shadow gap: the kernel path's reservation there needs the
; gap unprotected. CI's other options stay as dev/rig/dune sets them.

(env
 (sanitize
  (env-vars
   (ASAN_OPTIONS
    halt_on_error=1:detect_leaks=0:use_sigaltstack=0:allocator_may_return_null=1:protect_shadow_gap=0))))

; test_files forks and lowers the child's file limit: an executable of its
; own, which runs no other test.

(tests
 (names test_nvidia test_files)
 (modules test_nvidia test_files)
 (libraries rig rig_edge rig_nv rig_nv_nvidia rig_nv_nvidia_support unix windtrap))

; test_walk forks a child per failure, which alone carries the limit: an
; executable of its own, which runs no other test.

(test
 (name test_walk)
 (modules test_walk)
 (libraries rig rig_edge rig_nv rig_nv_nvidia rig_nv_nvidia_support unix windtrap)
 (foreign_stubs
  (language c)
  (names rig_nv_nvidia_walk_stubs)))
