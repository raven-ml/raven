; The channels take GPU addresses below 2^40, which on x86_64 lie in
; AddressSanitizer's shadow gap: the kernel path's reservation there needs the
; gap unprotected. CI's other options stay as dev/rig/dune sets them.

(env
 (sanitize
  (env-vars
   (ASAN_OPTIONS
    halt_on_error=1:detect_leaks=0:use_sigaltstack=0:allocator_may_return_null=1:protect_shadow_gap=0))))

(test
 (name test_nv)
 (modules test_nv)
 (libraries
  rig
  rig_gpu_support
  rig_nv
  rig_nv_abi
  rig_nv_nvidia
  rig_nv_support
  rig_support
  windtrap)
 (deps
  (glob_files fixtures/*)))

; test_fault faults the GPU, one fault per run in a forked child: a suite of
; its own, which runs no other test.

(test
 (name test_fault)
 (modules test_fault)
 (libraries rig rig_nv rig_nv_nvidia rig_nv_support unix windtrap)
 (deps
  (glob_files fixtures/*)))

; test_template fills the ring writer's templates with no GPU: its stubs read a
; device state through the driver's own header.

(test
 (name test_template)
 (modules test_template)
 (libraries rig_nv rig_nv_abi rig_edge windtrap)
 (foreign_stubs
  (language c)
  (include_dirs
   (lib rig_nv))
  (names test_template_stubs)))
