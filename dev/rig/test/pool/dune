; The pool's suites. Their probes are the C stubs of libraries of their own,
; which call rig_pool.h as a consumer's stubs do: rig_pool_probe, in support/,
; which both suites share, and rig_pool_thread_probe. test_pool runs on every
; system.
; test_threads forks and reads signal masks and thread states, so it runs
; where POSIX does. test_interleavings holds interleavings of the protocol
; in a second copy of the pool, compiled with its hook points defined
; (rig_pool_hooked_probe); it forks and tells workers apart by pthread_t, so
; it runs where POSIX does too, natively: what it holds is C.

(library
 (name rig_pool_thread_probe)
 (modules rig_pool_thread_probe)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries rig_pool rig_pool_probe)
 (foreign_stubs
  (language c)
  (names rig_pool_thread_probe_stubs)))

(library
 (name rig_pool_hooked_probe)
 (modules rig_pool_hooked_probe)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries rig_pool_probe)
 (foreign_stubs
  (language c)
  (names rig_pool_hooked_probe_stubs)
  (extra_deps ../../lib/pool/rig_pool.c ../../lib/pool/rig_pool.h ../../lib/pool/rig_pool_cgroup.h)))

(executable
 (name test_pool)
 (modules test_pool)
 (modes native byte)
 (libraries rig_pool_probe unix windtrap))

(executable
 (name test_interleavings)
 (modules test_interleavings)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries rig_pool_hooked_probe rig_pool_probe windtrap))

(executable
 (name test_threads)
 (modules test_threads)
 (modes native byte)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries rig_pool_probe rig_pool_thread_probe unix windtrap))

(rule
 (alias runtest)
 (action
  (run %{dep:test_pool.exe})))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (run %{dep:test_threads.exe})))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (run %{dep:test_interleavings.exe})))

; ocamlrun loads each library's stubs as a shared library of its own, found
; on CAML_LD_LIBRARY_PATH; the pool's symbols resolve at load. windtrap's
; stubs sit in the stublibs directory beside its library. ':' separates the
; path's directories off Windows only, so the bytecode runs are POSIX's.
; Under the sanitize profile the stubs need the sanitizer runtime, which is
; linked into the native executables and absent from ocamlrun, so the
; bytecode runs are skipped.

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps ../../lib/pool/dllrig_pool_stubs.so support/dllrig_pool_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "../../lib/pool:.:support:%{lib:windtrap:../stublibs}"
   (run %{dep:test_pool.bc}))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps
  ../../lib/pool/dllrig_pool_stubs.so
  support/dllrig_pool_probe_stubs.so
  dllrig_pool_thread_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "../../lib/pool:.:support:%{lib:windtrap:../stublibs}"
   (run %{dep:test_threads.bc}))))
