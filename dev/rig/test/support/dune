; What rig's suites and benches share: Polled, a host-memory driver
; whose queue runs only when its sleep runs it.

(library
 (name rig_support)
 (modules rig_support)
 (libraries rig rig_edge threads.posix unix)
 (foreign_stubs
  (language c)
  (names rig_support_stubs)))

; The machine's GPU lock, which suites that link no rig take too.

(library
 (name rig_gpu_lock)
 (modules rig_gpu_lock)
 (foreign_stubs
  (language c)
  (names rig_gpu_lock_stubs)))

; What the GPU suites and benches share: host memory, and a GPU of one
; driver opened through rig.

(library
 (name rig_gpu_support)
 (modules rig_gpu_support)
 (libraries rig rig_gpu_lock windtrap)
 (foreign_stubs
  (language c)
  (names rig_gpu_support_stubs)))

; The model of rig's API, which the model's suites share. It opens a device
; of every driver the machine has.

(library
 (name rig_model)
 (modules rig_model)
 (libraries
  rig
  rig_support
  rig_disk
  rig_metal
  rig_metal_support
  rig_cuda
  rig_cuda_support
  rig_nv
  rig_nv_nvidia
  rig_nv_support
  rig_amd
  rig_amd_amdgpu
  rig_amd_support
  rig_gpu_lock
  threads.posix
  unix
  windtrap))
