; test_fault loses a device to a page fault of its work, after which the
; kernel driver runs no queue of the process on that GPU; test_fork forks,
; which a process may do only before it spawns a domain. Each is a suite of
; its own.

(tests
 (names test_amd test_fault test_fork)
 (modules test_amd test_fault test_fork)
 (libraries
  rig
  rig_amd
  rig_amd_abi
  rig_amd_amdgpu
  rig_amd_support
  rig_gpu_support
  unix
  windtrap)
 (deps
  (glob_files fixtures/*)))

; test_template fills the ring writer's templates with no GPU: its stubs read a
; device state through the driver's own header.

(test
 (name test_template)
 (modules test_template)
 (libraries rig_amd rig_amd_abi rig_edge windtrap)
 (foreign_stubs
  (language c)
  (include_dirs
   (lib rig_amd))
  (names test_template_stubs)))
