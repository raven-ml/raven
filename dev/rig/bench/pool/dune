(library
 (name rig_pool_bench_probe)
 (modules)
 (libraries rig_pool rig_pool_probe)
 (foreign_stubs
  (language c)
  (names bench_pool_stubs)))

(executable
 (name bench_pool)
 (modules bench_pool)
 (libraries rig_pool_bench_probe rig_pool_probe thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_pool.exe})))
