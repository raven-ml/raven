(executables
 (names bench_program bench_agent)
 (libraries rig rig_program rig_remote rig_support thumper unix))

(rule
 (alias bench)
 (enabled_if
  (<> %{os_type} Win32))
 (locks %{workspace_root}/bench)
 (deps
  ../../bin/main.exe
  bench_agent.exe
  (glob_files ../../test/program/fixtures/*.o)
  (glob_files *.thumper))
 (action
  (run %{exe:bench_program.exe})))
