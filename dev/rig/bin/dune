(executable
 (name main)
 (public_name rig)
 (package rig)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries
  rig
  rig.remote
  rig.metal
  rig.cuda
  rig.nv
  rig.nv.nvidia
  rig.nv.pci
  rig.amd
  rig.amd.amdgpu
  rig.amd.pci
  rig.pci
  unix
  threads.posix)
 (foreign_stubs
  (language c)
  (names rig_bin_stubs)))

(rule
 (with-stdout-to
  version.ml
  (echo "let v = \"%{version:rig}\"\n")))

; Each driver-less driver's list of firmware images, the one its gen.py
; makes its pins from.

(rule
 (with-stdout-to
  images.ml
  (progn
   (echo "let amd = {|")
   (cat %{dep:../lib/amd/pci/gen/headers/firmware.tsv})
   (echo "|}\n\nlet nv = {|")
   (cat %{dep:../lib/nv/pci/gen/headers/firmware.tsv})
   (echo "|}\n"))))
