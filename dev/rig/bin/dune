(executable
 (name main)
 (public_name rig)
 (package rig)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries
  rig
  rig.remote
  rig.metal
  rig.cuda
  rig.nv
  rig.nv.nvidia
  rig.nv.pci
  rig.amd
  rig.amd.amdgpu
  rig.amd.pci
  unix
  threads.posix)
 (foreign_stubs
  (language c)
  (names rig_bin_stubs)))

(rule
 (with-stdout-to
  version.ml
  (echo "let v = \"%{version:rig}\"\n")))
