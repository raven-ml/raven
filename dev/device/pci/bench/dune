; The process memory and the in-process transport are the tests' own.

(copy_files# ../test/test_stubs.c)

(executable
 (name bench_window)
 (modules bench_window)
 (libraries device_pci nx.device.support thumper)
 (foreign_stubs
  (language c)
  (names test_stubs bench_window_stubs)
  (extra_deps ../device_pci.h)
  (flags :standard -std=c11 -O2 -Wall -Wextra -I ..)))

; Not attached to runtest on purpose: run with `dune build @bench`, or run the
; built exe from this directory under _build/default.

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend for
 ; cores and distort measurements.
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_window.exe})))

(executable
 (name bench_space)
 (modules bench_space)
 (libraries device_pci nx.device.support thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_space.exe})))
