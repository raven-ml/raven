; GPUs driven through their PCI function.

(library
 (name device_pci)
 (private_modules tlsf sysmem bus_address ops sysfs vfio local fail)
 (modules_without_implementation ops)
 (libraries unix)
 (install_c_headers device_pci)
 (foreign_stubs
  (language c)
  (names
   device_pci_window
   device_pci_sysmem
   device_pci_vfio
   device_pci_machine)))
