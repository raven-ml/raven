; The Mac's GPU, driven through Metal. The ring is plain C; the other stubs
; are Objective-C over Metal on macOS, and plain C elsewhere.

(library
 (name device_metal)
 (libraries device_edge device_metal_abi)
 (install_c_headers device_metal device_metal_ring)
 (foreign_stubs
  (language c)
  (names device_metal_ring))
 (foreign_stubs
  (language c)
  (names device_metal_queue device_metal_stubs)
  (flags
   (:standard
    (:include objc_flags.sexp))))
 (c_library_flags
  (:include frameworks.sexp)))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "(-x objective-c -fblocks)"))
   (with-stdout-to
    frameworks.sexp
    (echo "(-framework Metal -framework Foundation)")))))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "()"))
   (with-stdout-to
    frameworks.sexp
    (echo "()")))))
