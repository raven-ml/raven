; The pool's suites. Their probes are the C stubs of libraries of their own,
; which call device_pool.h as a consumer's stubs do. test_pool runs on every
; system. test_threads forks and reads signal masks and thread states, so it
; runs where POSIX does.

(library
 (name device_pool_probe)
 (modules device_pool_probe)
 (libraries device_pool unix windtrap)
 (foreign_stubs
  (language c)
  (names device_pool_probe_stubs)))

(library
 (name device_pool_thread_probe)
 (modules device_pool_thread_probe)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries device_pool)
 (foreign_stubs
  (language c)
  (names device_pool_thread_probe_stubs)))

(executable
 (name test_pool)
 (modules test_pool)
 (modes native byte)
 (libraries device_pool_probe unix windtrap))

(executable
 (name test_threads)
 (modules test_threads)
 (modes native byte)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries device_pool_probe device_pool_thread_probe unix windtrap))

(rule
 (alias runtest)
 (action
  (run %{dep:test_pool.exe})))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (run %{dep:test_threads.exe})))

; ocamlrun loads each library's stubs as a shared library of its own, found
; on CAML_LD_LIBRARY_PATH; the pool's symbols resolve at load. windtrap's
; stubs sit in the stublibs directory beside its library. ':' separates the
; path's directories off Windows only, so the bytecode runs are POSIX's.
; Under the sanitize profile the stubs need the sanitizer runtime, which is
; linked into the native executables and absent from ocamlrun, so the
; bytecode runs are skipped.

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps ../dlldevice_pool_stubs.so dlldevice_pool_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "..:.:%{lib:windtrap:../stublibs}"
   (run %{dep:test_pool.bc}))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps
  ../dlldevice_pool_stubs.so
  dlldevice_pool_probe_stubs.so
  dlldevice_pool_thread_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "..:.:%{lib:windtrap:../stublibs}"
   (run %{dep:test_threads.bc}))))
