; The pool's suites. Their probes are the C stubs of libraries of their own,
; which call nx_pool.h as a consumer's stubs do: pool_probe, in support/,
; which both suites share, and thread_probe. test_pool runs on every system.
; test_threads forks and reads signal masks and thread states, so it runs
; where POSIX does.

(library
 (name thread_probe)
 (modules thread_probe)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries device_pool pool_probe)
 (foreign_stubs
  (language c)
  (names thread_probe_stubs)))

(executable
 (name test_pool)
 (modules test_pool)
 (modes native byte)
 (libraries pool_probe unix windtrap))

(executable
 (name test_threads)
 (modules test_threads)
 (modes native byte)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries pool_probe thread_probe unix windtrap))

(rule
 (alias runtest)
 (action
  (run %{dep:test_pool.exe})))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (run %{dep:test_threads.exe})))

; ocamlrun loads each library's stubs as a shared library of its own, found
; on CAML_LD_LIBRARY_PATH; the pool's symbols resolve at load. windtrap's
; stubs sit in the stublibs directory beside its library. ':' separates the
; path's directories off Windows only, so the bytecode runs are POSIX's.
; Under the sanitize profile the stubs need the sanitizer runtime, which is
; linked into the native executables and absent from ocamlrun, so the
; bytecode runs are skipped.

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps ../dlldevice_pool_stubs.so support/dllpool_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "..:.:support:%{lib:windtrap:../stublibs}"
   (run %{dep:test_pool.bc}))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)))
 (deps
  ../dlldevice_pool_stubs.so
  support/dllpool_probe_stubs.so
  dllthread_probe_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "..:.:support:%{lib:windtrap:../stublibs}"
   (run %{dep:test_threads.bc}))))
