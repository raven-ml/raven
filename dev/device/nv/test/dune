; The channels take GPU addresses below 2^40, which on x86_64 lie in
; AddressSanitizer's shadow gap: the kernel path's reservation there needs the
; gap unprotected. CI's other options stay as dev/device/dune sets them.

(env
 (sanitize
  (env-vars
   (ASAN_OPTIONS
    halt_on_error=1:detect_leaks=0:use_sigaltstack=0:protect_shadow_gap=0))))

(test
 (name test_nv)
 (libraries
  device_core
  device_nv
  device_nv_abi
  device_nv_nvidia
  device_nv_support
  windtrap)
 (deps
  (glob_files fixtures/*)))
