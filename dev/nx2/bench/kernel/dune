; The CPU's floors, in C: loops that move a row's bytes, and codecs.

(library
 (name nx_cpu_bench)
 (modules)
 (libraries nx_cpu rig.pool)
 (foreign_stubs
  (language c)
  (include_dirs ../../lib/array ../../lib/cpu)
  (names nx_cpu_bench_stubs nx_cpu_bench_codec)))

(executable
 (name bench_kernels)
 (modules bench_kernels)
 (libraries nx_array nx_kernel nx_cpu nx_cpu_bench rig thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_kernels.exe})))
