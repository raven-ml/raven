; bench_amd.exe holds the AMD rows against this machine's baseline;
; bench_amd.exe gate prints their device times and floors for a batch's gate.

(executable
 (name bench_amd)
 (modules rows bench_amd)
 (libraries
  nx_array
  nx_amd_support
  nx_gpu_ref
  rig
  rig.amd.amdgpu
  thumper
  unix))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_amd.exe})))
