; nx.amd's code object, which build.py compiles by hand on a machine with
; comgr. It is not committed: a checkout without it fails here, naming the
; script.

(rule
 (targets gfx1201.co)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/lib/amd/kernels/gfx1201.co is missing: build it with `uv run dev/nx2/lib/amd/kernels/build.py`, or copy it in\n")
   (system "exit 1"))))
