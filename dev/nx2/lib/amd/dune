 (name nx_amd)
 (modules)
 (libraries nx_array)
 (foreign_stubs
  (language c)
  (include_dirs ../array)
  (extra_deps kernels/gfx1201.co)
  (flags :standard -DNX_AMD_KERNELS_DIR=kernels)
  (names fill_amd plan nx_amd_stubs)))
