; nx.metal: nx's kernels for Apple GPUs, compiled ahead of time into one
; metallib (kernels/) and embedded. C only until the binding: launch
; records, the plans that make them, and the fill that encodes them through
; rig.metal.

(library
 (name nx_metal)
 (modules)
 (foreign_stubs
  (language c)
  (names plan nx_metal_stubs)
  (include_dirs ../array)
  (extra_deps kernels/kernels.metallib)
  (flags
   (:standard -DNX_METAL_METALLIB=kernels/kernels.metallib)))
 (foreign_stubs
  (language c)
  (names fill_metal)
  (flags
   (:standard
    (:include objc_flags.sexp))))
 (c_library_flags
  (:include frameworks.sexp)))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "(-x objective-c -fblocks)"))
   (with-stdout-to
    frameworks.sexp
    (echo "(-framework Metal -framework Foundation)")))))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "()"))
   (with-stdout-to
    frameworks.sexp
    (echo "()")))))
