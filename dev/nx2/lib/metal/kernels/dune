; nx.metal's metallib, which build.sh compiles by hand on a Mac with the
; Metal toolchain. It is not committed: a checkout without it fails here,
; naming the script.

(rule
 (targets kernels.metallib)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/lib/metal/kernels/kernels.metallib is missing: build it with `dev/nx2/lib/metal/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))
