; The metallibs of nx.metal's kernels and of the Metal suite's harness,
; which gen.py compiles ahead of time on a Mac with the pinned Metal
; toolchain. Their digests are checked here on every machine.

(rule
 (alias runtest)
 (deps
  (:pins pins.json)
  gen.py
  ../kernels.h
  ../../array/nx_dtype.h
  kernels.metallib
  (glob_files src/*.metal)
  ../../../test/metal/support/harness.h
  (glob_files ../../../test/metal/support/*.metal)
  (glob_files ../../../test/metal/support/*.metallib))
 (action
  (run %{exe:../../../tools/pins/pins.exe} %{pins} lib/metal/kernels %{deps})))
