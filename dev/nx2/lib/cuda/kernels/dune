; nx.cuda's cubin, which build.sh compiles by hand on a machine with the
; CUDA toolkit. It is not committed: a checkout without it fails here,
; naming the script.

(rule
 (targets sm_89.cubin)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/lib/cuda/kernels/sm_89.cubin is missing: build it with `dev/nx2/lib/cuda/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))
