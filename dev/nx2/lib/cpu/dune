; Kernels for host memory.
;
; convert.c, gemm_generic.c and rows.c are compiled once per target: as
; themselves for base, and as their copies convert_v3.c, gemm_generic_v3.c
; and rows_v3.c for v3,
; with v3's instructions on x86-64 and as empty units elsewhere.
; gemm_neon.c holds arm64's kernels, in base; gemm_avx2.c, compiled with
; v3's instructions, x86-64's. target.c picks the table at run time.

(library
 (name nx_cpu)
 (libraries nx_array nx_kernel rig rig.pool)
 (foreign_stubs
  (language c)
  (include_dirs ../array ../kernel)
  (names target job walk stage copy apply iota rows convert gemm gemm_generic gemm_neon))
 (foreign_stubs
  (language c)
  (include_dirs ../array ../kernel)
  (flags :standard -DNX_CPU_V3 (:include v3_flags.sexp))
  (names convert_v3 gemm_generic_v3 rows_v3 gemm_avx2)))

(rule
 (copy convert.c convert_v3.c))

(rule
 (copy gemm_generic.c gemm_generic_v3.c))

(rule
 (copy rows.c rows_v3.c))

(rule
 (target v3_flags.sexp)
 (enabled_if
  (= %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (echo "(-mavx2 -mfma -mf16c -mbmi2)"))))

(rule
 (target v3_flags.sexp)
 (enabled_if
  (<> %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))
