; What the CUDA suite and bench share: the GPU lock, the harness's kernels,
; launch records and runs, device time, and operands.

(library
 (name nx_cuda_support)
 (libraries nx_array nx_cuda rig rig.cuda rig.gpu_lock windtrap)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/cuda ../../../lib/array)
  (extra_deps sm_89.cubin)
  (flags :standard -DNX_HARNESS_CUBIN=sm_89.cubin)
  (names nx_cuda_support_stubs)))

(rule
 (targets sm_89.cubin)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/test/cuda/support/sm_89.cubin is missing: build it with `dev/nx2/lib/cuda/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))
