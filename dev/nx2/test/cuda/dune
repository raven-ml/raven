; Correctness on the NVIDIA GPU 0, through CUDA and again through rig.nv,
; skipping without one; and kernels.ml against kernels.h, on any machine.

(tests
 (names test_cuda)
 (locks %{workspace_root}/gpu)
 (modules test_cuda)
 (libraries nx_array nx_kernel nx_cuda_support nx_gpu_ref rig windtrap))

(rule
 (alias runtest)
 (locks %{workspace_root}/gpu)
 (action
  (setenv
   NX_CUDA_RIG
   nv
   (run %{exe:test_cuda.exe}))))

(tests
 (names test_cuda_place)
 (locks %{workspace_root}/gpu)
 (modules test_cuda_place)
 (libraries nx nx_array nx_cuda_support rig rig.cuda windtrap))

; The library's kernels.ml, built here beside a stub that reads kernels.h.

(tests
 (names test_cuda_kernels)
 (modules test_cuda_kernels kernels)
 (libraries windtrap)
 (foreign_stubs
  (language c)
  (include_dirs ../../lib/cuda)
  (extra_deps ../../lib/cuda/kernels.h)
  (names test_cuda_kernels_stubs)))

(rule
 (copy ../../lib/cuda/kernels.ml kernels.ml))

(cram
 (deps ../../lib/cuda/kernels/fresh.exe))
