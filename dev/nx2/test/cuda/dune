; Correctness on CUDA's GPU 0, skipping without one; and kernels.ml against
; kernels.h, on any machine.

(tests
 (names test_cuda)
 (modules test_cuda)
 (libraries nx_array nx_kernel nx_cuda_support nx_gpu_ref rig windtrap))

(tests
 (names test_cuda_place)
 (modules test_cuda_place)
 (libraries nx nx_array nx_cuda_support rig rig.cuda windtrap))

; The library's kernels.ml, built here beside a stub that reads kernels.h.

(tests
 (names test_cuda_kernels)
 (modules test_cuda_kernels kernels)
 (libraries windtrap)
 (foreign_stubs
  (language c)
  (include_dirs ../../lib/cuda ../../lib/kernel)
  (extra_deps ../../lib/cuda/kernels.h ../../lib/kernel/nx_spec.h)
  (names test_cuda_kernels_stubs)))

(rule
 (copy ../../lib/cuda/kernels.ml kernels.ml))
