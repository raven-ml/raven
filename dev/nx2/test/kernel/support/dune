; nx_kinds.h's kinds by name, compiled with every dev/nx2 C library's flags,
; and their loops per target as nx.cpu compiles its conversions.

(library
 (name nx_kinds_support)
 (modules nx_kinds_support)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/array ../../../lib/kernel)
  (extra_deps
   ../../../lib/kernel/nx_kinds.h
   ../../../lib/kernel/nx_kinds_real.h
   ../../../lib/array/nx_dtype.h
   nx_kinds_support.h
   nx_kinds_strata.h)
  (names nx_kinds_support_stubs nx_kinds_support_loops))
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/array ../../../lib/kernel)
  (extra_deps
   ../../../lib/kernel/nx_kinds.h
   ../../../lib/kernel/nx_kinds_real.h
   ../../../lib/array/nx_dtype.h
   nx_kinds_support.h)
  (flags
   :standard
   -DNX_CPU_V3
   (:include ../../../lib/cpu/v3_flags.sexp))
  (names nx_kinds_support_loops_v3)))

(rule
 (copy nx_kinds_support_loops.c nx_kinds_support_loops_v3.c))

; nx_spec.h's structs as C reads them.

(library
 (name nx_kernel_support)
 (modules nx_kernel_support)
 (libraries nx_kernel)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/kernel)
  (names nx_kernel_support_stubs)))

; The kernel libraries the suite runs its laws through, and nx.cpu's target
; tables.

(library
 (name nx_kernels_support)
 (modules nx_kernels_support)
 (libraries nx_kernel nx_cpu rig.pool)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/cpu ../../../lib/array)
  (names nx_kernels_support_stubs)))
