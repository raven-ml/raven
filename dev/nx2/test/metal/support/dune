; What the Metal suite and bench share: the GPU through rig with the
; harness's metallib, operands, and runs of the harness's launches and of
; nx.metal's contractions. The harness's metallib is built with nx.metal's
; by lib/metal/kernels/build.sh and embedded here.

(library
 (name nx_metal_support)
 (libraries
  nx_array
  nx_kernel
  nx_metal
  rig
  rig.metal
  rig.gpu_lock)
 (foreign_stubs
  (language c)
  (names nx_metal_support_stubs)
  (include_dirs ../../../lib/array)
  (extra_deps embedded.metallib)
  (flags
   (:standard
    -DNX_HARNESS_METALLIB=embedded.metallib
    (:include objc_flags.sexp))))
 (c_library_flags
  (:include frameworks.sexp)))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "(-x objective-c -fblocks)"))
   (with-stdout-to
    frameworks.sexp
    (echo "(-framework Metal -framework Foundation)")))))

(rule
 (targets objc_flags.sexp frameworks.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (progn
   (with-stdout-to
    objc_flags.sexp
    (echo "()"))
   (with-stdout-to
    frameworks.sexp
    (echo "()")))))

; nx.metal's kernels.ml, for the names of its library's kernels.

(rule
 (copy ../../../lib/metal/kernels.ml kernels.ml))

(rule
 (targets harness.metallib)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/test/metal/support/harness.metallib is missing: build it with `dev/nx2/lib/metal/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))

; The harness's metallib the library embeds: on a Mac, the one build.sh makes
; from the tree's sources, listed here in build.sh's order; elsewhere a copied
; one, as it is.

(rule
 (targets embedded.metallib)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (chdir
    %{workspace_root}
    (run
     %{exe:../../../lib/metal/kernels/fresh.exe}
     %{dep:harness.metallib}
     %{dep:../../../lib/metal/kernels/build.sh}
     %{dep:harness.h}
     %{dep:../../../lib/array/nx_dtype.h}
     %{dep:harness.metal}))
   (copy harness.metallib embedded.metallib))))

(rule
 (targets embedded.metallib)
 (enabled_if
  (<> %{system} macosx))
 (action
  (copy harness.metallib embedded.metallib)))
