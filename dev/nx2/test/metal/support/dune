; What the Metal suite and bench share: the GPU through rig with the
; harness's metallib, operands, and runs of launch records through
; nx.metal's fill. The harness's metallib is built with nx.metal's by
; lib/metal/kernels/build.sh and embedded here.

(library
 (name nx_metal_support)
 (libraries nx_array nx_metal rig rig.metal rig.metal.abi rig.gpu_lock)
 (foreign_stubs
  (language c)
  (names nx_metal_support_stubs)
  (include_dirs ../../../lib/metal ../../../lib/array)
  (extra_deps harness.metallib)
  (flags
   (:standard
    -DNX_HARNESS_METALLIB=harness.metallib
    (:include ../../../lib/metal/objc_flags.sexp)))))

(rule
 (targets harness.metallib)
 (mode fallback)
 (action
  (progn
   (echo "dev/nx2/test/metal/support/harness.metallib is missing: build it with `dev/nx2/lib/metal/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))
