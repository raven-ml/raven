; nx.io's suites. They read files of the formats written by numpy, torch,
; Python's zipfile, Pillow and a minimal PNG writer, with each image's pixels
; as an npy file, as Pillow decodes it, or as PNG-3 states it where Pillow
; differs, which gen/generate.py writes into support/.

(tests
 (names
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image)
 (modules
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image
  io_support)
 (libraries nx nx_array nx_io nx_support rig unix windtrap)
 (deps
  (glob_files support/*))
 ; A stack of 8 MiB, a common system default, so that a parser that recurses
 ; once per nesting level of a file overflows here.
 (action
  (setenv
   OCAMLRUNPARAM
   l=1M
   (run %{test}))))

; Opens this machine's first GPU in a child, so it holds the lock GPU tests
; share.

(test
 (name test_io_gpu)
 (modules test_io_gpu)
 (locks %{workspace_root}/gpu)
 (libraries nx nx_io rig rig.gpus unix windtrap))
