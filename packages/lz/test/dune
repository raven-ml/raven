; lz's suites, through Lz's interface. Each reads the goldens of golden/,
; which gen/generate.py writes with the vendors.

(tests
 (package lz)
 (names
  test_deflate
  test_deflate_enc
  test_zstd
  test_zstd_enc
  test_lz4
  test_snappy
  test_lzw
  test_lzf
  test_checksum
  test_hostile
  test_lock)
 (modules :standard \ test_step)
 (libraries lz lz_support windtrap)
 ; windtrap selects tests and raises counts by the environment, so a run
 ; under other settings, as CI's sanitizer step makes, runs the suites again.
 (deps
  (glob_files golden/*)
  (env_var WINDTRAP_TAG)
  (env_var WINDTRAP_EXCLUDE_TAG)
  (env_var WINDTRAP_PROP_COUNT)))

; test_step alone links threads.posix: it holds a step from another thread of
; the domain.

(test
 (name test_step)
 (package lz)
 (modules test_step)
 (libraries lz lz_support windtrap threads.posix)
 ; windtrap selects tests and raises counts by the environment, so a run
 ; under other settings, as CI's sanitizer step makes, runs the suite again.
 (deps
  (glob_files golden/*)
  (env_var WINDTRAP_TAG)
  (env_var WINDTRAP_EXCLUDE_TAG)
  (env_var WINDTRAP_PROP_COUNT)))
