; lz.bytesrw is optional: the example builds and runs only where bytesrw is
; installed.

(executable
 (name main)
 (optional)
 (libraries lz lz.bytesrw bytesrw))

(rule
 (alias runtest)
 (enabled_if %{lib-available:lz.bytesrw})
 (action
  (progn
   (with-stdout-to
    main.output
    (run ./main.exe))
   (diff? main.expected main.output))))
