; lock_cost.exe with the systhreads library linked: its hooks then release
; and take the master lock around every blocking section.

(copy_files
 (files ../lock_cost.ml))

(copy_files
 (files ../lock_stubs.c))

(executable
 (name lock_cost)
 (modules lock_cost)
 (libraries threads.posix)
 (link_flags (-linkall))
 (foreign_stubs
  (language c)
  (names lock_stubs)))
