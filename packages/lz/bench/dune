; lz's bench suite. Not attached to runtest: run it with `dune build
; @packages/lz/bench/bench` after reference.py has written data/, or run the
; built exe from its directory under _build/default.

(data_only_dirs data)

(executable
 (name bench_lz)
 (libraries lz thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper)
  (source_tree data))
 (action
  (run %{exe:bench_lz.exe})))
