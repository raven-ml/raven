; lz's bench suite, not attached to runtest: run it with `dune build
; @packages/lz/bench/bench`, or run the built exe from this directory.
; Every bench rule takes the workspace lock %{workspace_root}/bench.

(executable
 (name bench_lz)
 (modules bench_lz)
 (libraries lz lz_support thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_lz.exe})))
