; The tests run quill as a command. A dependency on the package quill puts its
; executable on the test's PATH, its libraries on OCAMLPATH and its stub
; libraries, which the bytecode executable loads at startup, on
; CAML_LD_LIBRARY_PATH; a dependency on the install alias does none of this.
; quill run loads each raven package it finds, and the tests use none, so a
; build of quill alone (dune build -p quill) runs them as the workspace does.

(cram
 (package quill)
 (deps
  (package quill)))

; preload.t puts packages first on OCAMLPATH, whose separator and paths
; differ on Windows.

(cram
 (package quill)
 (applies_to preload)
 (enabled_if
  (<> %{os_type} Win32)))
