; dist/ is committed so building quill needs no node toolchain. The bundle's
; bytes depend on the local esbuild install, so it is refreshed only via
; `dune build @assets --auto-promote`. The rule declares no targets: a
; directory build such as `dune build packages/quill` builds every target in
; the tree whatever alias its rule carries, so a target would pull esbuild
; into every build.

(rule
 (alias assets)
 (deps
  (sandbox always)
  (glob_files src/*.js)
  (glob_files css/*.css)
  (glob_files fonts/*.woff2)
  esbuild.config.mjs
  (source_tree node_modules))
 (action
  (progn
   (setenv
    ESBUILD_OUTDIR
    build
    (run node esbuild.config.mjs --production))
   (diff? dist/app.js build/app.js)
   (diff? dist/app.css build/app.css))))
