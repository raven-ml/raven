(library
 (name quill_server)
 (public_name quill.server)
 (modules quill_server httpd protocol assets)
 (private_modules httpd protocol assets)
 (libraries
  quill
  quill.project
  quill.markdown
  jsont
  jsont.bytesrw
  unix
  threads.posix)
 (foreign_stubs
  (language c)
  (names quill_socket_stubs))
 (c_library_flags
  (:include socket_flags.sexp)))

; On Windows the stubs call Winsock, which their DLL links itself, as the unix
; library's does: flexdll resolves at load only what the executable and the
; DLLs loaded before export, and none exports Winsock.

(rule
 (target socket_flags.sexp)
 (enabled_if
  (= %{os_type} Win32))
 (action
  (write-file %{target} "(-lws2_32)")))

(rule
 (target socket_flags.sexp)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (write-file %{target} "()")))

; Generate assets.ml from committed frontend/dist

(rule
 (targets assets.ml)
 (deps
  (glob_files frontend/dist/*.js)
  (glob_files frontend/dist/*.css)
  (glob_files frontend/fonts/*.woff2)
  frontend/index.html
  support/gen_assets.ml)
 (action
  (run ocaml support/gen_assets.ml frontend assets.ml)))
