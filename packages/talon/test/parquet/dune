(test
 (name test_parquet)
 (modules test_parquet)
 (package talon)
 (libraries windtrap talon talon.parquet talon_held nx rig rig.disk lz bytesrw)
 (deps
  (source_tree golden)
  (source_tree support))
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_parquet.ml test_parquet.ml.corrected))))

