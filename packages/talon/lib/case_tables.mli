(** The Unicode 18.0.0 case mappings of {!Strings}, generated by
    [test/gen/case.py]. *)

val unicode_version : string
(** [unicode_version] is the version of the data, ["18.0.0"]. *)

val block_bits : int
(** [block_bits] is the number of low bits of a scalar value that select its
    entry within a block. *)

(** The type for a two-stage table of one mapping direction. A scalar value
    [u] below [limit] has the entry
    [Char.code blocks.[(Char.code index.[u lsr block_bits] lsl block_bits) + (u land mask)]].
    Entry 0 means no mapping. *)
type table = {
  limit : int;  (** Scalars from here on have no mapping. *)
  index : string;  (** A block number per [2^block_bits] scalars. *)
  blocks : string;  (** The blocks, [2^block_bits] entries each. *)
  deltas : int array;
      (** What an entry below its length adds to the scalar, entry 0 holding
          [0]. *)
  full : string array;
      (** An entry [e] at or above [Array.length deltas] maps to the bytes
          [full.(e - Array.length deltas)]. *)
}

val lower : table
(** [lower] is the full lowercase mapping, without the sigma context. *)

val upper : table
(** [upper] is the full uppercase mapping. *)

val cased : int array
(** [cased] are the ascending bounds of the scalars with the Cased property:
    each range is [bounds.(2 * i)] to [bounds.(2 * i + 1) - 1]. *)

val case_ignorable : int array
(** [case_ignorable] are the bounds of the scalars with the Case_Ignorable
    property, as in {!cased}. *)
