; The sanitize profile compiles talon's C with AddressSanitizer and
; UndefinedBehaviorSanitizer and links the sanitizer runtimes into every
; executable: CI runs the Parquet suite under it, with halt_on_error, so that
; a decoder that reads or writes out of bounds on malformed data fails there.
;
; An odoc warning is an error in every profile.

(env
 (sanitize
  (c_flags
   (:standard -g -fno-omit-frame-pointer -fsanitize=address,undefined))
  (link_flags
   (:standard -cclib -fsanitize=address,undefined))
  (odoc (warnings fatal)))
 (_
  (odoc (warnings fatal))))
