(executable
 (name main)
 (libraries hugin nx))

; The images are committed and their bytes depend on the local cairo, so an
; ordinary build never regenerates them: the rule is off unless asked for.
; Refresh with REFRESH_ASSETS=true dune build @assets

(rule
 (targets errorbar.png)
 (deps main.exe)
 (enabled_if
  (= %{env:REFRESH_ASSETS=false} true))
 (action
  (run ./main.exe))
 (mode
  (promote (until-clean))))

(alias
 (name assets)
 (deps errorbar.png))
