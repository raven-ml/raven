(executable
 (name main)
 (libraries hugin nx))

; The image is committed. dune build @assets renders it under render/ in
; _build and fails where it differs from the committed one by more than
; rounding moves a pixel between systems (support/agree.ml), which dune
; promote then replaces. The render is no rule's target, so a plain build
; never runs the example, and no-infer keeps cmp from asking for it as a
; dependency.

(subdir
 render
 (rule
  (alias assets)
  (deps ../main.exe ../bars.png)
  (action
   (progn
    (run ../main.exe)
    (run %{exe:../../support/agree.exe} ../bars.png bars.png)
    (no-infer
     (cmp ../bars.png bars.png))))))
