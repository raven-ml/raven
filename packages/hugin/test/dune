; The call sites only need to compile, so they form a library that
; nothing links.

(library
 (name hugin_test_callsites)
 (modules test_callsites)
 (libraries
  hugin
  hugin.gg.kit
  hugin.vg.raster
  hugin.vg.svg
  nx))

(tests
 (names test_figure)
 (modules test_figure)
 (package hugin)
 (libraries hugin hugin.kit nx windtrap))

(test
 (name test_resolve)
 (modules test_resolve)
 (package hugin)
 (libraries hugin hugin.kit hugin_test_figures nx windtrap)
 (deps golden/resolved.expected)
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/resolved.expected golden/resolved.expected.corrected))))

(test
 (name test_layout)
 (modules test_layout)
 (package hugin)
 (libraries hugin hugin.kit hugin_test_figures nx windtrap)
 (deps golden/layout.expected)
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/layout.expected golden/layout.expected.corrected))))

(test
 (name test_draw)
 (modules test_draw)
 (package hugin)
 (libraries
  hugin
  hugin.vg.raster
  hugin.vg.svg
  hugin_test_figures
  hugin_test_marks
  nx
  nx.io
  windtrap)
 (deps
  (glob_files golden/*.{png,svg})))
