; The call sites only need to compile, so they form a library that
; nothing links.

(library
 (name hugin_test_callsites)
 (modules test_callsites)
 (libraries
  hugin
  hugin.gg.kit
  hugin.vg.raster
  hugin.vg.svg
  nx))

(tests
 (names test_figure)
 (modules test_figure)
 (package hugin)
 (libraries hugin hugin.kit nx windtrap))

(test
 (name test_resolve)
 (modules test_resolve)
 (package hugin)
 (libraries hugin hugin.kit hugin_test_figures nx windtrap)
 (deps golden/resolved.expected)
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/resolved.expected golden/resolved.expected.corrected))))

(test
 (name test_layout)
 (modules test_layout)
 (package hugin)
 (libraries hugin hugin.kit hugin_test_figures nx windtrap)
 (deps golden/layout.expected)
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/layout.expected golden/layout.expected.corrected))))

(test
 (name test_draw)
 (modules test_draw)
 (package hugin)
 (libraries
  hugin
  hugin.vg.raster
  hugin.vg.svg
  hugin_test_figures
  nx
  nx.io
  windtrap)
 (deps
  (glob_files golden/*.{png,svg}))
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/attention.svg golden/attention.svg.corrected)
   (diff? golden/bands.svg golden/bands.svg.corrected)
   (diff? golden/confusion.svg golden/confusion.svg.corrected)
   (diff? golden/dashboard.svg golden/dashboard.svg.corrected)
   (diff? golden/embedding.svg golden/embedding.svg.corrected)
   (diff? golden/embedding-dense.svg golden/embedding-dense.svg.corrected)
   (diff? golden/images.svg golden/images.svg.corrected)
   (diff? golden/landscape.svg golden/landscape.svg.corrected)
   (diff? golden/legends.svg golden/legends.svg.corrected)
   (diff? golden/paper.svg golden/paper.svg.corrected)
   (diff? golden/stacks.svg golden/stacks.svg.corrected)
   (diff? golden/timeline.svg golden/timeline.svg.corrected))))
