(test
 (name test_font)
 (modules test_font)
 (package hugin)
 (libraries hugin.gg hugin.font hugin_test_build windtrap)
 (deps
  ../../lib/font/fonts/Inter-Regular.ttf
  ../../lib/font/fonts/Inter-Bold.ttf
  golden/cmap.expected
  golden/kerning.expected)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_font.ml test_font.ml.corrected)
   (diff? golden/cmap.expected golden/cmap.expected.corrected)
   (diff? golden/kerning.expected golden/kerning.expected.corrected))))

