(executable
 (name bench_plot)
 (libraries hugin hugin.vg.raster nx thumper))

; Not attached to runtest on purpose: run with
; `dune build --profile release @packages/hugin/test/plot/bench/bench`.

(rule
 (alias bench)
 (locks %{project_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_plot.exe})))
