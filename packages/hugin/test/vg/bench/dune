(executable
 (name bench_vg)
 (libraries
  hugin.gg
  hugin.vg
  hugin.vg.raster
  hugin.vg.svg
  hugin.vg.pdf
  thumper))

; Not attached to runtest on purpose: run with
; `dune build --profile release @packages/hugin/test/vg/bench/bench`.

(rule
 (alias bench)
 (locks %{project_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_vg.exe})))
