(test
 (name test_scale)
 (modules test_scale)
 (package hugin)
 (libraries hugin.gg hugin.kit nx windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_scale.ml test_scale.ml.corrected))))

