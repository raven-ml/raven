(test
 (name test_drawing)
 (modules test_drawing)
 (package hugin)
 (libraries
  hugin.gg
  hugin.font
  hugin.vg
  hugin.vg.svg
  hugin.text
  text_support
  windtrap)
 (deps
  (glob_files golden/*.svg))
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/axis_title.svg golden/axis_title.svg.corrected)
   (diff? golden/fallback.svg golden/fallback.svg.corrected)
   (diff? golden/notdef.svg golden/notdef.svg.corrected))))
