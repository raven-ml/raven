(copy_files ../font/build.ml)

(library
 (name text_support)
 (wrapped false)
 (modules text_support build)
 (libraries hugin.gg hugin.font hugin.text windtrap))

(test
 (name test_text)
 (modules test_text)
 (package hugin)
 (libraries hugin.gg hugin.text text_support windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_text.ml test_text.ml.corrected))))

(test
 (name test_layout)
 (modules test_layout)
 (package hugin)
 (libraries
  hugin.gg
  hugin.font
  hugin.text
  text_support
  windtrap)
 (action
  (progn
   (run %{test} --corrected)
