(executable
 (name bench_vg)
 (libraries hugin.next.gg hugin.next.vg hugin.next.vg.raster thumper))

; Not attached to runtest on purpose: run with
; `dune build --profile release @packages/hugin/next/test/vg/bench/bench`.

(rule
 (alias bench)
 (locks %{project_root}/bench)
 (action
  (progn
   (run %{exe:bench_vg.exe})
   (diff? hugin_next_vg.thumper hugin_next_vg.thumper.corrected))))
