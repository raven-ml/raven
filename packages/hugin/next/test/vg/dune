(test
 (name test_picture)
 (modules test_picture)
 (package hugin)
 (libraries
  hugin.next.gg
  hugin.next.font
  hugin.next.vg
  vg_corpus
  nx
  windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_picture.ml test_picture.ml.corrected))))

(test
 (name test_raster)
 (modules test_raster)
 (package hugin)
 (libraries
  hugin.next.gg
  hugin.next.font
  hugin.next.vg
  hugin.next.vg.raster
  vg_corpus
  nx
  nx.io
  windtrap)
 (deps
  (glob_files golden/*.png))
 (action
  (progn
   (run %{test} --corrected)
   (diff? golden/shapes.png golden/shapes.png.corrected)
   (diff? golden/strokes.png golden/strokes.png.corrected)
   (diff? golden/marks.png golden/marks.png.corrected))))

(test
 (name test_svg)
 (modules test_svg)
 (package hugin)
 (libraries
  hugin.next.gg
  hugin.next.font
  hugin.next.vg
  hugin.next.vg.raster
  hugin.next.vg.svg
  vg_corpus
  nx
  windtrap)
 (deps
  (glob_files golden/*.svg))
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_svg.ml test_svg.ml.corrected)
   (diff? golden/shapes.svg golden/shapes.svg.corrected)
   (diff? golden/strokes.svg golden/strokes.svg.corrected)
   (diff? golden/marks.svg golden/marks.svg.corrected))))
