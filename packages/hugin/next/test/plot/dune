; The Guide's call sites only need to compile, so they form a library that
; nothing links.

(library
 (name hugin_next_test_callsites)
 (modules test_callsites)
 (libraries
  hugin.next
  hugin.next.gg.kit
  hugin.next.vg.raster
  hugin.next.vg.svg
  nx))

(tests
 (names test_figure)
 (modules test_figure)
 (package hugin)
 (libraries hugin.next hugin.next.kit nx windtrap))

(test
 (name test_resolve)
 (modules test_resolve)
 (package hugin)
 (libraries hugin.next hugin.next.kit nx windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_resolve.ml test_resolve.ml.corrected))))

(test
 (name test_layout)
 (modules test_layout)
 (package hugin)
 (libraries hugin.next hugin.next.kit nx windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_layout.ml test_layout.ml.corrected))))

(test
 (name test_draw)
 (modules test_draw)
 (package hugin)
 (libraries
  hugin.next
  hugin.next.vg.raster
  hugin.next.vg.svg
  hugin_next_test_figures
  hugin_next_test_marks
  nx
  nx.io
  windtrap)
 (deps
  (glob_files golden/*)))
