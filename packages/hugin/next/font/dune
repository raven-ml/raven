(library
 (name hugin_next_font)
 (public_name hugin.next.font)
 (private_modules font_data literal)
 (libraries hugin.next.gg)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

(rule
 (target font_data.ml)
 (deps fonts/Inter-Regular.ttf fonts/Inter-Bold.ttf)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:embed/embed.exe}
    inter_regular
    fonts/Inter-Regular.ttf
    inter_bold
    fonts/Inter-Bold.ttf))))
