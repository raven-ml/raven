(executable
 (name main)
 (libraries hugin.next nx))

; The image is committed. dune build @assets renders it under render/ in
; _build and fails where it differs from the committed one, which dune
; promote then replaces. The render is no rule's target, so a plain build
; never runs the example, and no-infer keeps cmp from asking for it as a
; dependency.

(subdir
 render
 (rule
  (alias assets)
  (deps ../main.exe ../area.png)
  (action
   (progn
    (run ../main.exe)
    (no-infer
     (cmp ../area.png area.png))))))
