; The stage benchmarks of tolk's compiler, over programs recorded from
; tinygrad. They are not attached to runtest: run them with `dune build @bench`,
; or run the executable directly, never through `dune exec`, which sets
; INSIDE_DUNE and redirects `--bless`.

(executable
 (name bench_tolk)
 (modules bench_tolk programs kernels lorenz)
 (libraries
  tolk
  tolk.engine
  tolk_test
  tolk_run
  nx.device
  nx.cuda.device
  thumper))

(executable
 (name embed)
 (modules embed)
 (libraries tolk_test))

; The programs are the graphs prepare_rangeify receives, recorded for its
; suite, built into the executable so that it runs from anywhere.

(rule
 (target programs.ml)
 (deps
  (:goldens
   ../test/schedule/prepare/attention.golden
   ../test/schedule/prepare/conv.golden
   ../test/schedule/prepare/cumsum.golden
   ../test/schedule/prepare/embedding.golden
   ../test/schedule/prepare/gpt_oss_decode.golden
   ../test/schedule/prepare/gpt_oss_prefill.golden
   ../test/schedule/prepare/matmul.golden
   ../test/schedule/prepare/softmax.golden
   ../test/schedule/prepare/sort.golden
   ../test/schedule/prepare/split_sum.golden))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{goldens}))))

; The kernels are the sinks the Heuristic suite optimises: gpt-oss-20b's
; decode products.

(rule
 (target kernels.ml)
 (deps
  (:goldens
   ../test/codegen/opt/heuristic/gpt_oss_qkv.golden
   ../test/codegen/opt/heuristic/gpt_oss_kv.golden
   ../test/codegen/opt/heuristic/gpt_oss_router.golden
   ../test/codegen/opt/heuristic/gpt_oss_gate_up.golden
   ../test/codegen/opt/heuristic/gpt_oss_down.golden))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{goldens}))))

; The lorenz kernels are kernel graphs of lorenz_simple's step (sofo-raven), each
; with the optimisations a beam search of width 2 chose for it on the host, and
; the name it then gets.

(rule
 (target lorenz.ml)
 (deps
  (:graphs
   r_128_16_3_4_4_3_3_400_400.graph
   r_32_256_50_4_4_2_4_4.graph
   r_32_3_2_4_3_400.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; Benchmarks serialize across the workspace, since concurrent suites contend for
; cores and distort what they measure.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_tolk.exe})))
