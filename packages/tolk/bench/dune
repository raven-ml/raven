; The stage benchmarks of tolk's compiler, over programs recorded from
; tinygrad. They are not attached to runtest: run them with `dune build @bench`,
; or run the executable directly, never through `dune exec`, which sets
; INSIDE_DUNE and redirects `--bless`.

(executable
 (name bench_tolk)
 (modules bench_tolk programs lorenz host_kernels gpt_oss_kernels
  stream_kernels contract_kernels)
 (libraries tolk tolk.engine tolk_test tolk_run rig rig.gpus thumper unix))

(executable
 (name embed)
 (modules embed)
 (libraries tolk_test))

; The programs are the graphs prepare_rangeify receives, recorded for the
; benchmarks in test/support/programs, built into the executable so that it
; runs from anywhere.

(rule
 (target programs.ml)
 (deps
  (:goldens
   (glob_files ../test/support/programs/*.golden)
   (glob_files ../test/support/programs/*.tolk)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{goldens}))))

; The lorenz kernels are kernel graphs of lorenz_simple's step (sofo-raven), each
; with the optimisations a beam search of width 2 chose for it on the host, and
; the name it then gets.

(rule
 (target lorenz.ml)
 (deps
  (:graphs
   r_128_16_3_4_4_3_3_400_400.graph
   r_32_256_50_4_4_2_4_4.graph
   r_32_3_2_4_3_400.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The host kernels are kernel graphs whose lanes the host's register budget
; decides: the Heuristic suite's matmul, conv, conv_half, tangent_products,
; paired_products and max_rows, matmul_f64 its matmul over doubles,
; sin_nested_8 eight nested float64 sines over 1024 elements, as rune compiles
; them, select_zero a float32 selection of zero over 4M elements,
; normal_f64 rune's float64 normal sampler of 1024 values (its compile bench's
; rng/normal-f64), and the Heuristic suite's gpt_oss_kv and vecmat_1000,
; products of 512 and 1000 outputs, which take lanes, and matvec_tall, 8
; products of 2^20 values, whose lanes leave its launch 2 blocks.

(rule
 (target host_kernels.ml)
 (deps
  (:graphs
   ../test/codegen/opt/heuristic/matmul.golden
   (glob_files ../test/codegen/opt/heuristic/matmul.tolk)
   matmul_f64.graph
   ../test/codegen/opt/heuristic/conv.golden
   (glob_files ../test/codegen/opt/heuristic/conv.tolk)
   ../test/codegen/opt/heuristic/conv_half.golden
   (glob_files ../test/codegen/opt/heuristic/conv_half.tolk)
   ../test/codegen/opt/heuristic/tangent_products.golden
   (glob_files ../test/codegen/opt/heuristic/tangent_products.tolk)
   ../test/codegen/opt/heuristic/paired_products.golden
   (glob_files ../test/codegen/opt/heuristic/paired_products.tolk)
   ../test/codegen/opt/heuristic/max_rows.golden
   (glob_files ../test/codegen/opt/heuristic/max_rows.tolk)
   sin_nested_8.graph
   select_zero.graph
   normal_f64.graph
   ../test/codegen/opt/heuristic/gpt_oss_kv.golden
   (glob_files ../test/codegen/opt/heuristic/gpt_oss_kv.tolk)
   ../test/codegen/opt/heuristic/vecmat_1000.golden
   (glob_files ../test/codegen/opt/heuristic/vecmat_1000.tolk)
   ../test/codegen/opt/heuristic/matvec_tall.golden
   (glob_files ../test/codegen/opt/heuristic/matvec_tall.tolk)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The gpt-oss kernels are kernel graphs of gpt-oss-20b's step at bfloat16 as
; rune compiles it for CUDA (apps/gpt-oss), without optimisations: a
; decode step's attention values, a prefill's router, and the scaled output
; of a prefill's norm of 512 tokens by 2880, a map (D501).

(rule
 (target gpt_oss_kernels.ml)
 (deps
  (:graphs
   gpt_oss_decode_values.graph
   gpt_oss_prefill_router.graph
   gpt_oss_prefill_norm.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The stream kernels are kernel graphs of products as rune compiles them for
; CUDA, without optimisations, each weight past the RTX 5000 Ada's 64 MiB of L2
; but the decode step's keys, key and value projection, router and output
; projection: a row's kernels are [row.i], run in the order of [i]. decode-kv
; and decode-router are the Heuristic suite's gpt_oss_kv and gpt_oss_router
; kernels on CUDA, key-projection a prefill's key projection of 512 tokens by
; 512 over 2880, as the Heuristic suite's attention_values reads its bfloat16
; operands, key-projection-64 the same of 64 tokens, whose calls read their
; operands from memory (bench_tolk.ml's [cold]), routed-argmax-16-bf16 16 rows each multiplying the [2880; 2880]
; bfloat16 matrix of one of 32 experts, which an argmax over a score of the
; row's and the expert's positions in the kernel finds, and
; output-projection-64 a prefill's attention output projection of 64 tokens by
; 2880 over 4096, with its bias and residual, whose operand the kernel computes:
; the bfloat16 of the attention output times the share of each head's row the
; sink leaves, and mxfp4-64 and mxfp4-512 a dense product of 64 and 512 tokens
; by gpt-oss-20b's MXFP4 gate and up matrix, 5760 by 2880, unrouted, and
; q8_0-core-64 a prefill's key projection of 64 tokens by 512 over 2880 by
; gpt-oss-20b's Q8_0 matrix, which a tensor core takes a block at a time,
; and q8_0-512 a prefill's query, key and value projection of 512 tokens by
; 5120 over 2880 by its Q8_0 matrix, with its bias, the calls of both reading
; their operands from memory.

(rule
 (target stream_kernels.ml)
 (deps
  (:graphs
   (glob_files stream/*.graph)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The contract kernels are kernel graphs of dense contractions as rune compiles
; them for CUDA, without optimisations, each operand widened to float32 by a
; cast where it is narrower: a row's kernels are [row.i], run in the order of
; [i]. batched-biased-f32, 8 float32 products of 1024 cubed plus a bias of
; each output, and scores-masked-f32, attention's float32 scores of 4 batches
; of 8 heads at 1024 positions over 64 plus an additive mask of each query
; and key, are recorded from tinygrad's schedule of the same programs, as the
; Heuristic suite's kernels are: no batch or head reads the bias or the mask.

(rule
 (target contract_kernels.ml)
 (deps
  (:graphs
   (glob_files contract/*.graph)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; Benchmarks serialize across the workspace, since concurrent suites contend for
; cores and distort what they measure. [--warm] fills tolk's disk cache with the
; kernels the cases compile, so the measurement compiles nothing.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_tolk.exe} --warm)
   (run %{exe:bench_tolk.exe}))))
