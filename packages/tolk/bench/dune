; The stage benchmarks of tolk's compiler, over programs recorded from
; tinygrad. They are not attached to runtest: run them with `dune build @bench`,
; or run the executable directly, never through `dune exec`, which sets
; INSIDE_DUNE and redirects `--bless`.

(executable
 (name bench_tolk)
 (modules bench_tolk programs lorenz host_kernels gpt_oss_kernels
  stream_kernels)
 (libraries tolk tolk.engine tolk_test tolk_run rig rig.cuda thumper unix))

(executable
 (name embed)
 (modules embed)
 (libraries tolk_test))

; The programs are the graphs prepare_rangeify receives, recorded for the
; benchmarks in test/support/programs, built into the executable so that it
; runs from anywhere.

(rule
 (target programs.ml)
 (deps
  (:goldens
   (glob_files ../test/support/programs/*.golden)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{goldens}))))

; The lorenz kernels are kernel graphs of lorenz_simple's step (sofo-raven), each
; with the optimisations a beam search of width 2 chose for it on the host, and
; the name it then gets.

(rule
 (target lorenz.ml)
 (deps
  (:graphs
   r_128_16_3_4_4_3_3_400_400.graph
   r_32_256_50_4_4_2_4_4.graph
   r_32_3_2_4_3_400.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The host kernels are kernel graphs whose lanes the host's register budget
; decides: the Heuristic suite's matmul, conv, conv_half, tangent_products,
; paired_products and max_rows, matmul_f64 its matmul over doubles,
; sin_nested_8 eight nested float64 sines over 1024 elements, as rune compiles
; them, select_zero a float32 selection of zero over 4M elements, and
; normal_f64 rune's float64 normal sampler of 1024 values (its compile bench's
; rng/normal-f64).

(rule
 (target host_kernels.ml)
 (deps
  (:graphs
   ../test/codegen/opt/heuristic/matmul.golden
   matmul_f64.graph
   ../test/codegen/opt/heuristic/conv.golden
   ../test/codegen/opt/heuristic/conv_half.golden
   ../test/codegen/opt/heuristic/tangent_products.golden
   ../test/codegen/opt/heuristic/paired_products.golden
   ../test/codegen/opt/heuristic/max_rows.golden
   sin_nested_8.graph
   select_zero.graph
   normal_f64.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The gpt-oss kernels are kernel graphs of gpt-oss-20b's step at bfloat16 as
; rune compiles it for CUDA (examples/06-gpt-oss), without optimisations: a
; decode step's attention values and a prefill's router.

(rule
 (target gpt_oss_kernels.ml)
 (deps
  (:graphs gpt_oss_decode_values.graph gpt_oss_prefill_router.graph))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; The stream kernels are kernel graphs of products as rune compiles them for
; CUDA, without optimisations, each weight past the RTX 5000 Ada's 64 MiB of L2
; but the decode step's keys, key and value projection and router: a row's
; kernels are [row.i], run in the order of [i]. decode-kv and decode-router are
; the Heuristic suite's gpt_oss_kv and gpt_oss_router kernels on CUDA, and
; key-projection a prefill's key projection of 512 tokens by 512 over 2880, as
; the Heuristic suite's attention_values reads its bfloat16 operands.

(rule
 (target stream_kernels.ml)
 (deps
  (:graphs
   (glob_files stream/*.graph)))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed.exe} %{graphs}))))

; Benchmarks serialize across the workspace, since concurrent suites contend for
; cores and distort what they measure. [--warm] fills tolk's disk cache with the
; kernels the cases compile, so the measurement compiles nothing.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_tolk.exe} --warm)
   (run %{exe:bench_tolk.exe}))))
