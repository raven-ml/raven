; The tests of schedules on disk make their caches under the working
; directory, which the sandbox makes fresh.

(test
 (name test_schedule)
 (modules test_schedule)
 (package tolk)
 (libraries windtrap tolk tolk_test unix)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk)))

; The launches run their schedules on the host and on each GPU present.

(test
 (name test_launch)
 (modules test_launch calls)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  tolk_gpus
  rig))

; The laws of Calls on Metal run again under Metal's API validation, which
; aborts a launch whose bound arguments break the rules of the function it
; calls. GitHub's macOS machines have a device without residency sets, and
; there the validation layer aborts in the call that opens it.

(rule
 (alias runtest)
 (package tolk)
 (enabled_if
  (and
   (= %{system} macosx)
   (<> %{env:GITHUB_ACTIONS=false} true)))
 (action
  (setenv
   MTL_DEBUG_LAYER
   1
   (run
    %{exe:test_launch.exe}
    -f
    "GPUs › Metal › a loop reads each run"
    -f
    "GPUs › Metal › a store through"))))

; A launch's members write what its graph states, in any order of them, on
; the host and on each GPU present.

(test
 (name test_launch_law)
 (modules test_launch_law)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  tolk_gpus
  rig
  unix)
 (deps
  (sandbox always)))
