; The tests of schedules on disk make their caches under the working
; directory, which the sandbox makes fresh.

(test
 (name test_schedule)
 (modules test_schedule)
 (package tolk)
 (libraries windtrap tolk tolk_test str unix)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk)))

