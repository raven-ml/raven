30 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct interleaved_args { device int* arg0; int arg1; device int* arg2; };\nkernel void interleaved(constant struct interleaved_args* args, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device int* data0_4 = args->arg0;\n  int n_ = args->arg1;\n  device int* data2_4 = args->arg2;\n  int4 val0 = (*((device int4*)((data2_4+0))));\n  *((device int4*)((data0_4+0))) = int4((val0.x+n_),(val0.y+n_),(val0.z+n_),(val0.w+n_));\n}"
