(library
 (name tolk_test)
 (modules golden dtypes interpreter kernel_graphs tensors uops kernel_opts
  disk_cache args cores clang)
 (wrapped false)
 (libraries windtrap tolk tolk.engine rig unix))

; Running kernels and schedules on rig's host and software devices through the
; engine.

(library
 (name tolk_run)
 (modules run)
 (wrapped false)
 (libraries tolk tolk.engine tolk_test rig unix windtrap))

; The GPUs the suites run on, apart so that only the suites that open them
; link their drivers.

(library
 (name tolk_gpus)
 (modules gpus)
 (wrapped false)
 (libraries
  windtrap
  tolk.engine
  rig
  rig.metal
  rig.cuda
  rig.nv.nvidia
  rig.amd.amdgpu))

; Forbidding a process to start another, for the compilers' suites.

(library
 (name tolk_spawn)
 (modules spawn)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names spawn_stubs)))

; The law that a rewrite keeps the value, and the random expressions it is
; checked on, for the suites of Shape's rules and of Symbolic.

(library
 (name tolk_simplification)
 (modules simplification expressions)
 (wrapped false)
 (libraries windtrap tolk tolk_test))

