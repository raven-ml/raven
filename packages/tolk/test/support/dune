(library
 (name tolk_test)
 (modules golden dtypes interpreter kernel_graphs tensors uops kernel_opts
  disk_cache)
 (wrapped false)
 (libraries windtrap tolk unix))

; Running kernels and schedules on rig's host and memory devices through the
; engine, apart so that only the tests that run them link rig.

(library
 (name tolk_run)
 (modules run)
 (wrapped false)
 (libraries tolk tolk.engine tolk_test rig unix))

; Forbidding a process to start another, for the compilers' suites.

(library
 (name tolk_spawn)
 (modules spawn)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names spawn_stubs)))

(tests
 (names test_golden test_interpreter test_kernel_graphs test_tensors)
 (modules test_golden test_interpreter test_kernel_graphs test_tensors)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (glob_files *.golden)
  ../schedule/schedule/chained_functions.golden))

; The cache's directory is read when the program starts, so CACHEDB is set
; here, to a directory of the sandbox, for the graphs the suite keeps on disk.

(test
 (name test_graph)
 (modules test_graph)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test}))))
