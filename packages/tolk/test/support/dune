(library
 (name tolk_test)
 (modules golden dtypes interpreter kernel_graphs tensors uops kernel_opts
  disk_cache args)
 (wrapped false)
 (libraries windtrap tolk unix))

; Running kernels and schedules on rig's host and memory devices through the
; engine, apart so that only the tests that run them link rig.

(library
 (name tolk_run)
 (modules run)
 (wrapped false)
 (libraries tolk tolk.engine tolk_test rig unix))

; The GPUs the suites run on, apart so that only the suites that open them
; link their drivers.

(library
 (name tolk_gpus)
 (modules gpus)
 (wrapped false)
 (libraries
  windtrap
  tolk.engine
  rig
  rig.metal
  rig.cuda
  rig.nv.nvidia
  rig.amd.amdgpu))

; Forbidding a process to start another, for the compilers' suites.

(library
 (name tolk_spawn)
 (modules spawn)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names spawn_stubs)))

(tests
 (names
  test_golden
  test_interpreter
  test_kernel_graphs
  test_tensors
  test_uops)
 (modules
  test_golden
  test_interpreter
  test_kernel_graphs
  test_tensors
  test_uops)
 (package tolk)
 (libraries windtrap tolk tolk_test unix)
 (deps
  (glob_files *.golden)
  (glob_files *.tolk)
  ../schedule/schedule/chained_functions.golden
  (glob_files ../schedule/schedule/chained_functions.tolk)))

; The cache's directory is read when the program starts, so CACHEDB is set
; here, to a directory of the sandbox, for the graphs the suite keeps on disk.

(test
 (name test_graph)
 (modules test_graph)
 (package tolk)
 (libraries windtrap tolk tolk_test unix)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test}))))
