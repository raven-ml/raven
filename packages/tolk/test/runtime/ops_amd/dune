(test
 (name test_ops_amd)
 (modules test_ops_amd)
 (package tolk)
 (libraries windtrap tolk tolk_test nx.amd.packet)
 (deps
  (glob_files *.golden)))

; Running batches on the GPU needs an AMD GPU: without one, each test skips.

(executable
 (name test_ops_amd_exec)
 (modules test_ops_amd_exec)
 (libraries windtrap tolk tolk.engine nx.device nx.amd.device))

(rule
 (alias runtest)
 (package tolk)
 (action
  (run %{exe:test_ops_amd_exec.exe})))
