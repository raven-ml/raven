(test
 (name test_ops_metal)
 (modules test_ops_metal)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (glob_files *.golden)))

; Running batches on the GPU needs a Mac.

(executable
 (name test_ops_metal_exec)
 (modules test_ops_metal_exec)
 (enabled_if
  (= %{system} macosx))
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  nx.device
  nx.metal.device))

(rule
 (alias runtest)
 (package tolk)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{exe:test_ops_metal_exec.exe})))
