(test
 (name test_ops_nv)
 (modules test_ops_nv)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (glob_files *.golden)))

; Running batches on the GPU needs an NVIDIA GPU: without one, each test skips.

(executable
 (name test_ops_nv_exec)
 (modules test_ops_nv_exec)
 (libraries windtrap tolk tolk.engine nx.device nx.nv.device))

(rule
 (alias runtest)
 (package tolk)
 (action
  (run %{exe:test_ops_nv_exec.exe})))
