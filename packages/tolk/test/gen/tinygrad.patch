+# the bits a value of the emulated float moves from storage without arithmetic: a load, a constant, a selection between
+# such values, and stacks and lanes of them. a move keeps every code, a signalling NaN's included
+def f2f_moved(ctx:tuple, x:UOp) -> UOp|None:
+  fr, tdt = ctx[0], f2f_dt[ctx[0]]
+  if x.op in (Ops.CONST, Ops.CAST) and x.dtype in (fr, dtypes.weakfloat):
+    c = x if x.op is Ops.CONST else x.src[0]
+    if c.op is not Ops.CONST or not isinstance(c.arg, float) or struct.pack('<d', fr.const(c.arg)) != struct.pack('<d', c.arg): return None
+    return UOp.const(exact_bitcast(fr.const(c.arg), fr, tdt), tdt)
+  if x.dtype != fr: return None
+  if x.op is Ops.LOAD and len(x.src) == 1: return f2f_rewrite(ctx, x.src[0]).load()
+  if x.op is Ops.WHERE:
+    a, b = f2f_moved(ctx, x.src[1]), f2f_moved(ctx, x.src[2])
+    return None if a is None or b is None else x.src[0].where(a, b)
+  if x.op is Ops.STACK:
+    srcs = [f2f_moved(ctx, s) for s in x.src]
+    return None if any(s is None for s in srcs) else UOp(Ops.STACK, src=tuple(srcs))
+  if x.op is Ops.INDEX and x.addrspace is AddrSpace.ALU:
+    return None if (v:=f2f_moved(ctx, x.src[0])) is None else v.index(*x.src[1:])
+  return None
