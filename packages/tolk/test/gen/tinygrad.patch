+# A host program's launch runs blocks of its largest output loop that every store to memory reads in its address on the
+# host's cores at once. The loop runs block_lo + r for r below block_hi - block_lo, two variables the launch sets for each block.
+# The launch knows the two by their slots, the first past those already taken; their names, fresh among the kernel's
+# variables, only name them in its source.
+def writes_memory(st:UOp) -> bool:
+  at = st.src[0].src[0] if st.src[0].op is Ops.CAST else st.src[0]
+  return at.op in (Ops.INDEX, Ops.SHRINK) and at.src[0].buf_uop.addrspace == AddrSpace.GLOBAL
+
+def split_blocks(sink:UOp) -> UOp:
+  nodes = list(sink.backward_slice_with_self)
+  stores = [u for u in nodes if u.op is Ops.STORE and writes_memory(u)]
+  def qualifies(r:UOp) -> bool:
+    return r.op is Ops.RANGE and r.axis_type == AxisType.WEAK and not r.src[0].ranges and int(r.src[0].vmax) >= 2 and \
+      all(r in st.src[0].backward_slice for st in stores)
+  cands = [r for r in nodes if qualifies(r)]
+  if not stores or not cands: return sink
+  r = cands[0]
