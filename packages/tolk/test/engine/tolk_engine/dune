; The suite runs the Schedule suite's recorded programs and the Linearizer
; suite's loops. Metal exists on macOS alone, and its tests are slow. CACHEDB
; is a directory of the sandbox, as Clang's compiler is made with its cache.

(test
 (name test_tolk_engine)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  nx.device
  nx.dtype
  (select
   metal.ml
   from
   (nx.metal.device -> metal.macos.ml)
   (-> metal.other.ml)))
 (deps
  (sandbox always)
  (glob_files ../../schedule/schedule/*.golden)
  (glob_files ../../codegen/late/linearizer/*.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test} --exclude-tag slow))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files ../../schedule/schedule/*.golden)
  (glob_files ../../codegen/late/linearizer/*.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_tolk_engine.exe} --tag slow))))
