; The suite runs the Schedule suite's recorded programs and the Linearizer
; suite's loops. Metal exists on macOS alone. A test that loses a NULL device
; for good runs in a process of its own (tag lost-device).

(test
 (name test_tolk_engine)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  nx.device
  nx.dtype
  (select
   metal.ml
   from
   (nx.metal.device -> metal.macos.ml)
   (-> metal.other.ml)))
 (deps
  (glob_files ../../schedule/schedule/*.golden)
  (glob_files ../../codegen/late/linearizer/*.golden))
 (action
  (progn
   (run %{test} --exclude-tag lost-device)
   (run %{test} --tag lost-device))))
