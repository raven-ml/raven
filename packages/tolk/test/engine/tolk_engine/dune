; The suite runs the Schedule suite's recorded programs and the Linearizer
; suite's loops, and runs them on each GPU it opens.

(test
 (name test_tolk_engine)
 (modules test_tolk_engine)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  tolk_gpus
  rig
  rig.disk)
 (deps
  (glob_files ../../schedule/schedule/*.golden)
  (glob_files ../../schedule/schedule/*.tolk)
  (glob_files ../../codegen/late/linearizer/*.golden)
  (glob_files ../../codegen/late/linearizer/*.tolk)))

; The Metal tests run again under Metal's API validation, which aborts a
; launch whose bound arguments break the rules of the function it calls.
; GitHub's macOS machines have a device without residency sets, and there
; the validation layer aborts in the call that opens it.

(rule
 (alias runtest)
 (package tolk)
 (enabled_if
  (and
   (= %{system} macosx)
   (<> %{env:GITHUB_ACTIONS=false} true)))
 (deps
  (glob_files ../../schedule/schedule/*.golden)
  (glob_files ../../schedule/schedule/*.tolk)
  (glob_files ../../codegen/late/linearizer/*.golden)
  (glob_files ../../codegen/late/linearizer/*.tolk))
 (action
  (setenv
   MTL_DEBUG_LAYER
   1
   (run %{exe:test_tolk_engine.exe} -f Metal))))

; Timing on another machine's host, served by rig's test agent over the
; loopback.

(test
 (name test_tolk_engine_remote)
 (modules test_tolk_engine_remote)
 (package tolk)
 (deps support/agent.exe)
 (libraries windtrap tolk tolk.engine rig rig_remote rig_remote_job))
