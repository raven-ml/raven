38 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void E_i_j(float* restrict data0_100, float* restrict data1_100, const int block_lo_, const int block_hi_, const int j_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    for (int Lidx1 = 0; Lidx1 < j_; Lidx1++) {\n      int alu0 = (((block_lo_+Lidx0)*10)+Lidx1);\n      float val0 = (*(data1_100+alu0));\n      float alu1 = (val0-val0);\n      *(data0_100+alu0) = (alu1*alu1*((float)(__builtin_inff())));\n    }\n  }\n}\n"
