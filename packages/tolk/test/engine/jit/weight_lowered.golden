54 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid r_5_5(float* restrict data0_5, float* restrict data1_25, float* restrict data2_5, const int block_lo_, const int block_hi_) {\n  float val0 = (*(data2_5+4));\n  float4 val1 = (*((float4*)((data2_5+0))));\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    int alu1 = (alu0*5);\n    float val2 = (*(data1_25+(alu1+1)));\n    float val3 = (*(data1_25+(alu1+2)));\n    float val4 = (*(data1_25+(alu1+3)));\n    float val5 = (*(data1_25+(alu1+4)));\n    float val6 = (*(data1_25+alu1));\n    *(data0_5+alu0) = __builtin_fmaf(val5,val0,__builtin_fmaf(val4,val1[3],__builtin_fmaf(val3,val1[2],__builtin_fmaf(val2,val1[1],(val6*val1[0])))));\n  }\n}\n"
