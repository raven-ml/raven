76 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void r_4_16(int* restrict data0_4, float* restrict data1_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    int alu1 = (alu0<<4);\n    float4 val0 = (*((float4*)((data1_64+(alu1+12)))));\n    float4 val1 = (*((float4*)((data1_64+(alu1+4)))));\n    float4 val2 = (*((float4*)((data1_64+(alu1+8)))));\n    float4 val3 = (*((float4*)((data1_64+alu1))));\n    *(data0_4+alu0) = __builtin_bit_cast(int, (float)((val3[0]+val3[1]+val3[2]+val3[3]+val1[0]+val1[1]+val1[2]+val1[3]+val2[0]+val2[1]+val2[2]+val2[3]+val0[0]+val0[1]+val0[2]+val0[3]+5.0f)));\n  }\n}\n"
