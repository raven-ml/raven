(test
 (name test_jit)
 (modules test_jit)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk.engine
  tolk_test
  tolk_run
  nx.device)
 (deps
  (glob_files *.golden)))

; JITBEAM is read once per process, so each of its settings is a run of its
; own.

(test
 (name test_jitbeam)
 (modules test_jitbeam)
 (package tolk)
 (libraries windtrap tolk tolk.engine tolk_run)
 (action
  (progn
   (run %{test} -f "JITBEAM unset")
   (setenv
    JITBEAM
    3
    (run %{test} -f "JITBEAM=3"))
   (setenv
    JITBEAM
    0
    (run %{test} -f "JITBEAM=0")))))
