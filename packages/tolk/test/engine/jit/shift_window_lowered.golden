24 Ops.SOURCE dtypes.void [] "\nvoid E_8_2(int* restrict data0_16, int* restrict data1_8, int* restrict data2_16, const int block_lo_, const int block_hi_) {\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    int val0 = (*(data1_8+alu0));\n    int alu1 = (alu0+8);\n    int val1 = (*(data2_16+alu1));\n    *(data0_16+alu0) = val1;\n    *(data0_16+alu1) = val0;\n  }\n}\n"
