46 Ops.SOURCE dtypes.void [] "typedef float float2 __attribute__((aligned(8),ext_vector_type(2)));\nvoid E_16_2(float* restrict data0_32, float* restrict data1_16, float* restrict data2_16, const int block_lo_, const int block_hi_) {\n  for (int Lidx0_1 = 0; Lidx0_1 < (block_hi_-block_lo_); Lidx0_1++) {\n    int alu0 = (block_lo_+Lidx0_1);\n    float val0 = (*(data1_16+alu0));\n    float val1 = (*(data2_16+alu0));\n    float2 alu1 = ((float2){val1,val0}+1.0f);\n    *(data0_32+alu0) = alu1[0];\n    *(data0_32+(alu0+16)) = alu1[1];\n  }\n}\n"
