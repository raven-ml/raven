44 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid r_4_8(float* restrict data0_4, float* restrict data1_32, const int block_lo_, const int block_hi_) {\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    int alu1 = (alu0<<3);\n    float4 val0 = (*((float4*)((data1_32+(alu1+4)))));\n    float4 val1 = (*((float4*)((data1_32+alu1))));\n    *(data0_4+alu0) = (val1[0]+val1[1]+val1[2]+val1[3]+val0[0]+val0[1]+val0[2]+val0[3]);\n  }\n}\n"
