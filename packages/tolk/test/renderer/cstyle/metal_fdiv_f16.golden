# tinygrad b98af4a4bbfab0afec39b37c122f792d4120812e
#include <metal_stdlib>
using namespace metal;
struct fdiv_args { device half* arg0; device half* arg1; device half* arg2; };
kernel void fdiv(constant struct fdiv_args* args, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device half* data0_16 = args->arg0;
  device half* data1_16 = args->arg1;
  device half* data2_16 = args->arg2;
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    half val0 = (*(data1_16+Lidx0));
    half val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}
