# tinygrad 79af1ca70e7021f504919c4ff5631245acc33ed6

void fdiv(double* restrict data0_16, double* restrict data1_16, double* restrict data2_16) {
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    double val0 = (*(data1_16+Lidx0));
    double val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}

