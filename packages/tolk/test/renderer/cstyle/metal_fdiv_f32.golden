kernel void fdiv(device float* data0_16, device float* data1_16, device float* data2_16, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
