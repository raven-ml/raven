# tinygrad 37132d7553a831fdaf900e2334d80380702c5564
#include <metal_stdlib>
using namespace metal;
struct args_t { device bfloat* data0_16; device bfloat* data1_16; device bfloat* data2_16; };
kernel void fdiv(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device bfloat* data0_16 = args.data0_16; device bfloat* data1_16 = args.data1_16; device bfloat* data2_16 = args.data2_16;
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    bfloat val0 = (*(data1_16+Lidx0));
    bfloat val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}
