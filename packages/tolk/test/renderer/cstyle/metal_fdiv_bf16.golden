#include <metal_stdlib>
using namespace metal;
kernel void fdiv(device bfloat* data0_16, device bfloat* data1_16, device bfloat* data2_16, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    bfloat val0 = (*(data1_16+Lidx0));
    bfloat val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}
