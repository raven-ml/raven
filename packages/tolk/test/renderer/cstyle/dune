; Settings are read once per process, so the cases rendered under EXPAND_SSA
; run in a process of their own, with its variable set.

(test
 (name test_cstyle)
 (package tolk)
 (libraries
  windtrap
  tolk
  tolk_test
  tolk_run
  tolk.engine
  rig
  rig.elf
  rig.metal)
 (deps
  comgr_stand_in
  (glob_files *.golden))
 (action
  (setenv
   COMGR_PATH
   ./comgr_stand_in
   (progn
    (run %{test} --exclude-tag expand-ssa)
    (setenv
     EXPAND_SSA
     1
     (run %{test} --tag expand-ssa))))))

; No machine here has comgr: COMGR_PATH names a file that stands in for it,
; which HIP's compiler finds to name its table. A compile with it fails, and
; its tests skip.

(rule
 (target comgr_stand_in)
 (action
  (write-file %{target} "This file stands in for comgr.\n")))
