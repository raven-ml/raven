# tinygrad f0abe5fa732e6e6afbad199692c0eb93ed6e8ce2

struct fdiv_args { __fp16* data0_16; __fp16* data1_16; __fp16* data2_16; };
__attribute__((min_vector_width(512))) void fdiv(const struct fdiv_args* args) {
  __fp16* restrict data0_16 = args->data0_16;
  __fp16* restrict data1_16 = args->data1_16;
  __fp16* restrict data2_16 = args->data2_16;
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    __fp16 val0 = (*(data1_16+Lidx0));
    __fp16 val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}

