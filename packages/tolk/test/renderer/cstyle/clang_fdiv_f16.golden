# tinygrad b98af4a4bbfab0afec39b37c122f792d4120812e

struct fdiv_args { __fp16* arg0; __fp16* arg1; __fp16* arg2; };
__attribute__((min_vector_width(512))) void fdiv(const struct fdiv_args* args) {
  __fp16* data0_16 = args->arg0;
  __fp16* data1_16 = args->arg1;
  __fp16* data2_16 = args->arg2;
  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {
    __fp16 val0 = (*(data1_16+Lidx0));
    __fp16 val1 = (*(data2_16+Lidx0));
    *(data0_16+Lidx0) = (val0/val1);
  }
}

