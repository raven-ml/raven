; The cache's directory is read when the program starts, so CACHEDB is set
; here, to a directory of the sandbox: the suite clears the cache it writes to.

(test
 (name test_helpers)
 (package tolk)
 (libraries windtrap tolk tolk_test unix)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test}))))
