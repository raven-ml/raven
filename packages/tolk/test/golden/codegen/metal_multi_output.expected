#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_256; device float* data1_256; device float* data2_256; };
kernel void multi_output(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_256 = args.data0_256; device float* data1_256 = args.data1_256; device float* data2_256 = args.data2_256;
  int gidx0 = gid.x; /* 256 */
  float val0 = (*(data0_256+gidx0));
  *(data1_256+gidx0) = (val0+1.0f);
  *(data2_256+gidx0) = (val0*2.0f);
}
