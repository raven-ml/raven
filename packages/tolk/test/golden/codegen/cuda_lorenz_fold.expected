typedef unsigned int uint;
#define INFINITY (__int_as_float(0x7f800000))
#define NAN (__int_as_float(0x7fffffff))
template <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }
extern "C" __global__ void __launch_bounds__(1) lorenz_fold(float* data0_16, float* data1_16, float* data2_16, float* data3_16) {
  int gidx0 = blockIdx.x; /* 16 */
  float val0 = (*(data0_16+gidx0));
  float val1 = (*(data1_16+gidx0));
  float val2 = (*(data2_16+gidx0));
  float alu0 = (val0+(0.0625f*(10.0f*(val1-val0))));
  float alu1 = (val1+(0.0625f*((val0*(28.0f-val2))-val1)));
  float alu2 = (val2+(0.0625f*((val0*val1)-(2.5f*val2))));
  float alu3 = (alu0+(0.0625f*(10.0f*(alu1-alu0))));
  float alu4 = (alu1+(0.0625f*((alu0*(28.0f-alu2))-alu1)));
