  float val1 = (*(data1_16+gidx0));
  float val2 = (*(data2_16+gidx0));
  float alu0 = (val1-val0);
  float alu1 = (val0+(alu0*0.625f));
  float alu2 = ((val0*(28.0f-val2))-val1);
