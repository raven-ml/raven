#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_16; device float* data1_16; device float* data2_16; device float* data3_16; };
kernel void lorenz_fold(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_16 = args.data0_16; device float* data1_16 = args.data1_16; device float* data2_16 = args.data2_16; device float* data3_16 = args.data3_16;
