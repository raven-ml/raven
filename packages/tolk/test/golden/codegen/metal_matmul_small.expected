#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_16; device float* data1_16; device float* data2_16; };
kernel void matmul_small(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_16 = args.data0_16; device float* data1_16 = args.data1_16; device float* data2_16 = args.data2_16;
  float buf0[1];
  int gidx0 = gid.x; /* 4 */
  int gidx1 = gid.y; /* 4 */
  int alu0 = (gidx1<<2);
  *(buf0+0) = 0.0f;
  for (int Ridx2 = 0; Ridx2 < 4; Ridx2++) {
    float val0 = (*(data0_16+(alu0+Ridx2)));
    float val1 = (*(data1_16+(gidx0+(Ridx2<<2))));
    *(buf0+0) = ((*(buf0+0))+(val0*val1));
  }
  *(data2_16+(gidx0+alu0)) = (*(buf0+0));
}
