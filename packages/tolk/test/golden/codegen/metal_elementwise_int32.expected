#include <metal_stdlib>
using namespace metal;
struct args_t { device int* data0_-1; device int* data1_-1; device int* data2_-1; };
kernel void elementwise_int32(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device int* data0_-1 = args.data0_-1; device int* data1_-1 = args.data1_-1; device int* data2_-1 = args.data2_-1;
  int gidx0 = gid.x; /* 256 */
  int val0 = (*(data0_-1+gidx0));
  int val1 = (*(data1_-1+gidx0));
  *(data2_-1+gidx0) = (val0+val1);
}
