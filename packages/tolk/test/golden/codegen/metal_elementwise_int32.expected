#include <metal_stdlib>
using namespace metal;
struct args_t { device int* data0_256; device int* data1_256; device int* data2_256; };
kernel void elementwise_int32(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device int* data0_256 = args.data0_256; device int* data1_256 = args.data1_256; device int* data2_256 = args.data2_256;
  int gidx0 = gid.x; /* 256 */
  int val0 = (*(data0_256+gidx0));
  int val1 = (*(data1_256+gidx0));
  *(data2_256+gidx0) = (val0+val1);
}
