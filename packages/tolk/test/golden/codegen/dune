(rule
 (package tolk)
 (target amd_llama_ffn_gate.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:amd_llama_ffn_gate.expected} %{dep:amd_llama_ffn_gate.actual}))))

