struct args_t { device float* data0_256; device float* data1_1; };
kernel void sum_reduce(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_256 = args.data0_256; device float* data1_1 = args.data1_1;
