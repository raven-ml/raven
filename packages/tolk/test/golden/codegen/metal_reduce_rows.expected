#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_256; device float* data1_8; };
kernel void reduce_rows(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_256 = args.data0_256; device float* data1_8 = args.data1_8;
  float buf0[1];
  int gidx0 = gid.x; /* 8 */
  *(buf0+0) = 0.0f;
  for (int Ridx1 = 0; Ridx1 < 32; Ridx1++) {
    float val0 = (*(data0_256+((gidx0<<5)+Ridx1)));
    *(buf0+0) = ((*(buf0+0))+val0);
  }
  *(data1_8+gidx0) = (*(buf0+0));
}
