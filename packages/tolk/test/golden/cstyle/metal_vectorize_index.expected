#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_-1; device float* data1_-1; };
kernel void test(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_-1 = args.data0_-1; device float* data1_-1 = args.data1_-1;
  float val0 = (*(data0_-1+0));
  float val1 = (*(data0_-1+1));
  float val2 = (*(data0_-1+2));
  float val3 = (*(data0_-1+3));
  *(data1_-1+0) = float4(val0,val1,val2,val3).z;
}
