#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_-1; };
kernel void test(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_-1 = args.data0_-1;
  for (int Lidx0 = 0; Lidx0 < 10; Lidx0++) {
    for (int Lidx1 = 0; Lidx1 < 5; Lidx1++) {
      int alu0 = (Lidx0+Lidx1);
      float val0 = (*(data0_-1+alu0));
      *(data0_-1+alu0) = val0;
    }
  }
}
