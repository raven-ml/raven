#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_-1; device float* data1_-1; device float* data2_-1; };
kernel void test(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_-1 = args.data0_-1; device float* data1_-1 = args.data1_-1; device float* data2_-1 = args.data2_-1;
  float val0 = (*(data0_-1+0));
  float val1 = (*(data1_-1+0));
  float alu0 = (1?val0:val1);
  *(data2_-1+0) = alu0;
}
