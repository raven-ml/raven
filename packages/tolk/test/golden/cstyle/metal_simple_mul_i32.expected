#include <metal_stdlib>
using namespace metal;
struct args_t { device int* data0_1; device int* data1_1; device int* data2_1; };
kernel void test(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device int* data0_1 = args.data0_1; device int* data1_1 = args.data1_1; device int* data2_1 = args.data2_1;
  int val0 = (*(data0_1+0));
  int val1 = (*(data1_1+0));
  *(data2_1+0) = (val0*val1);
}
