; MV is read once per process, so the cases under it run in a process of
; their own, with the variable set.

(test
 (name test_heuristic)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (glob_files *.golden))
 (action
  (progn
   (run %{test} --exclude-tag slow --exclude-tag mv_0)
   (setenv
    MV
    0
    (run %{test} --tag mv_0)))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_heuristic.exe} --tag slow)))
