; The search's environment variables are read once per process, so what they
; change is checked in a process of its own, with the variables set. CACHEDB is
; a directory of the sandbox, which the cache's tests fill with the results of
; made-up measurements.

(test
 (name test_search)
 (modules test_search)
 (package tolk)
 (libraries windtrap tolk tolk_test)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (progn
    (run %{test} --exclude-tag environment)
    (setenv
     BEAM_PADTO
     1
     (setenv
      TC
      2
      (setenv
       BEAM_TC_OPT
       0
       (setenv
        BEAM_STRICT_MODE
        1
        (setenv
         BEAM_UOPS_MAX
         43
         (setenv
          BEAM_LOG_SURPASS_MAX
          1
          (setenv
           BEAM_DEBUG
           2
           (run %{test} --tag environment))))))))))))

; The searches of kernels on the host compile each candidate with its C
; compiler and time it through the engine.

(executable
 (name test_search_exec)
 (modules test_search_exec)
 (libraries windtrap tolk tolk_test tolk_run tolk.engine nx.device))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_search_exec.exe})))
