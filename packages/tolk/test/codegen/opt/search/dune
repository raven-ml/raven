; CACHEDB is a directory of the sandbox, set by the root dune's env stanza:
; the cache's tests fill it with the results of made-up measurements.

(test
 (name test_search)
 (modules test_search)
 (package tolk)
 (libraries windtrap tolk tolk_test unix)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk)))

; The searches of kernels on the host compile each candidate with its C
; compiler and time it through the engine.

(executable
 (name test_search_exec)
 (modules test_search_exec)
 (libraries windtrap tolk tolk_test tolk_run tolk.engine rig))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (run %{exe:test_search_exec.exe})))
