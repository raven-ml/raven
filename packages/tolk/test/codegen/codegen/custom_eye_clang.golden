79 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid custom_eye_64(float* restrict data0_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    int alu1 = (alu0<<1);\n    int alu2 = (alu1+1);\n    int alu3 = (alu0<<4);\n    *((float4*)((data0_64+(alu3+12)))) = (float4){((float)((alu2==4))),((float)((alu2==5))),((float)((alu2==6))),((float)((alu2==7)))};\n    *((float4*)((data0_64+(alu3+4)))) = (float4){((float)((alu1==4))),((float)((alu1==5))),((float)((alu1==6))),0.0f};\n    *((float4*)((data0_64+(alu3+8)))) = (float4){0.0f,((float)((alu2==1))),((float)((alu2==2))),((float)((alu2==3)))};\n    *((float4*)((data0_64+alu3))) = (float4){((float)((alu1==0))),((float)((alu1==1))),((float)((alu1==2))),((float)((alu1==3)))};\n  }\n}\n"
