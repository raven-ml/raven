22 Ops.SOURCE dtypes.void [] "\nvoid custom_eye_64(float* restrict data0_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 8; Lidx1++) {\n      *(data0_64+((alu0<<3)+Lidx1)) = ((float)((alu0==Lidx1)));\n    }\n  }\n}\n"
