38 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid custom_eye_64(float* restrict data0_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 2; Lidx1++) {\n      int alu1 = (Lidx1<<2);\n      *((float4*)((data0_64+((alu0<<3)+alu1)))) = (float4){((float)((alu0==alu1))),((float)((alu0==(alu1+1)))),((float)((alu0==(alu1+2)))),((float)((alu0==(alu1+3))))};\n    }\n  }\n}\n"
