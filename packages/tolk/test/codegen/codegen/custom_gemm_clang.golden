45 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void custom_gemm_16_16_16(float* restrict data0_256, float* restrict data1_256, float* restrict data2_256, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<4);\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      int alu1 = (alu0+Lidx1);\n      *(data0_256+alu1) = 0.0f;\n      for (int Lidx2 = 0; Lidx2 < 16; Lidx2++) {\n        float val0 = (*(data1_256+(alu0+Lidx2)));\n        float val1 = (*(data2_256+((Lidx2<<4)+Lidx1)));\n        float val2 = (*(data0_256+alu1));\n        *(data0_256+alu1) = (val2+(val0*val1));\n      }\n    }\n  }\n}\n"
