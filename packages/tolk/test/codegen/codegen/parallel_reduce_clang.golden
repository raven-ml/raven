90 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid parallel_reduce(float* restrict data0_128, float* restrict data1_1, float* restrict data2_1) {\n  float buf0[1];\n  float buf1[1];\n  *(buf0+0) = 0.0f;\n  *(buf1+0) = 0.0f;\n  for (int Ridx0 = 0; Ridx0 < 32; Ridx0++) {\n    float4 val0 = (*((float4*)((data0_128+(Ridx0<<2)))));\n    *(buf0+0) = ((*(buf0+0))+val0[0]+val0[1]+val0[2]+val0[3]);\n    *(buf1+0) = ((*(buf1+0))+__builtin_fmaf(val0[3],val0[3],__builtin_fmaf(val0[2],val0[2],__builtin_fmaf(val0[1],val0[1],(val0[0]*val0[0])))));\n  }\n  *(data1_1+0) = (*(buf0+0));\n  *(data2_1+0) = (*(buf1+0));\n}\n"
