92 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(4),ext_vector_type(4)));\nstruct parallel_reduce_args { float* data0_128; float* data1_1; float* data2_1; };\n__attribute__((min_vector_width(512))) void parallel_reduce(const struct parallel_reduce_args* args) {\n  float* restrict data0_128 = args->data0_128;\n  float* restrict data1_1 = args->data1_1;\n  float* restrict data2_1 = args->data2_1;\n  float buf0[1];\n  float buf1[1];\n  *(buf0+0) = 0.0f;\n  *(buf1+0) = 0.0f;\n  for (int Lidx0 = 0; Lidx0 < 32; Lidx0++) {\n    float4 val0 = (*((float4*)((data0_128+(Lidx0<<2)))));\n    *(buf0+0) = ((*(buf0+0))+(val0[0]+val0[1]+val0[2]+val0[3]));\n    *(buf1+0) = ((*(buf1+0))+__builtin_fmaf(val0[3],val0[3],__builtin_fmaf(val0[2],val0[2],__builtin_fmaf(val0[1],val0[1],(val0[0]*val0[0])))));\n  }\n  *(data1_1+0) = (*(buf0+0));\n  *(data2_1+0) = (*(buf1+0));\n}\n"
