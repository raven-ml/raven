27 Ops.SOURCE dtypes.void [] "\nvoid E_16_16(float* restrict data0_256, float* restrict data1_16, float* restrict data2_256, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_16+alu0));\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      int alu1 = ((alu0<<4)+Lidx1);\n      float val1 = (*(data2_256+alu1));\n      *(data0_256+alu1) = (val0+val1);\n    }\n  }\n}\n"
