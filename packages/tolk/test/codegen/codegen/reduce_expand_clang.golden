43 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_16_4_4(float* restrict data0_256, float* restrict data1_16, float* restrict data2_256, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_16+alu0));\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      int alu1 = ((alu0<<4)+(Lidx1<<2));\n      float4 val1 = (*((float4*)((data2_256+alu1))));\n      *((float4*)((data0_256+alu1))) = (float4){(val0+val1[0]),(val0+val1[1]),(val0+val1[2]),(val0+val1[3])};\n    }\n  }\n}\n"
