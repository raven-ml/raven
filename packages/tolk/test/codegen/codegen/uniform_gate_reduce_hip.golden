59 Ops.SOURCE dtypes.void [] "\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) uniform_gate_reduce(float* data0_256, float* data1_8) {\n  float buf0[1];\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    bool alu0 = (Lidx0<5);\n    int alu1 = (alu0?32:0);\n    *(buf0+0) = 0.0f;\n    for (int Lidx1 = 0; Lidx1 < alu1; Lidx1++) {\n      float val0 = (*(data0_256+((Lidx0<<5)+Lidx1)));\n      *(buf0+0) = ((*(buf0+0))+val0);\n    }\n    float alu5 = (alu0?(*(buf0+0)):0.0f);\n    *(data1_8+Lidx0) = alu5;\n  }\n}"
