55 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(8) varying_gate_reduce(float* data0_256, float* data1_8) {\n  float buf0[1];\n  int lidx0 = threadIdx.x; /* 8 */\n  *(buf0+0) = 0.0f;\n  for (int Lidx1 = 0; Lidx1 < 32; Lidx1++) {\n    float val0 = (*(data0_256+((lidx0<<5)+Lidx1)));\n    *(buf0+0) = ((*(buf0+0))+val0);\n  }\n  float alu3 = ((lidx0<5)?(*(buf0+0)):0.0f);\n  *(data1_8+lidx0) = alu3;\n}"
