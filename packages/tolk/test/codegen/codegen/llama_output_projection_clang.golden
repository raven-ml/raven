66 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid r_2_32_8(float* restrict data0_64, float* restrict data1_16, float* restrict data2_256, const int block_lo_, const int block_hi_) {\n  for (int Lidx1 = 0; Lidx1 < 2; Lidx1++) {\n    int alu0 = (Lidx1<<3);\n    float4 val0 = (*((float4*)((data1_16+(alu0+4)))));\n    float4 val1 = (*((float4*)((data1_16+alu0))));\n    for (int Lidx2 = 0; Lidx2 < (block_hi_-block_lo_); Lidx2++) {\n      int alu1 = (block_lo_+Lidx2);\n      int alu2 = (alu1<<3);\n      float4 val2 = (*((float4*)((data2_256+(alu2+4)))));\n      float4 val3 = (*((float4*)((data2_256+alu2))));\n      *(data0_64+((Lidx1<<5)+alu1)) = __builtin_fmaf(val0[3],val2[3],__builtin_fmaf(val0[2],val2[2],__builtin_fmaf(val0[1],val2[1],__builtin_fmaf(val0[0],val2[0],__builtin_fmaf(val1[3],val3[3],__builtin_fmaf(val1[2],val3[2],__builtin_fmaf(val1[1],val3[1],(val1[0]*val3[0]))))))));\n    }\n  }\n}\n"
