24 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void E_3(float* restrict data0_3, float* restrict data1_4, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_4+alu0));\n    float val1 = (*(data1_4+(alu0+1)));\n    *(data0_3+alu0) = (val0+val1);\n  }\n}\n"
