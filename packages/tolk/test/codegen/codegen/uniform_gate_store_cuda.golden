58 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) uniform_gate_store(float* data0_256, float* data1_8) {\n  float buf0[1];\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    *(buf0+0) = 0.0f;\n    for (int Lidx1 = 0; Lidx1 < 32; Lidx1++) {\n      float val0 = (*(data0_256+((Lidx0<<5)+Lidx1)));\n      *(buf0+0) = ((*(buf0+0))+val0);\n    }\n    if ((Lidx0<5)) {\n      *(data1_8+Lidx0) = (*(buf0+0));\n    }\n  }\n}"
