58 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_256_64_4(float* restrict data0_65536, float* restrict data1_65536, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 64; Lidx1++) {\n      int alu1 = (Lidx1<<2);\n      int alu2 = ((alu0<<8)+alu1);\n      float val0 = ((((alu1+1)<alu0)!=1)?*(data1_65536+(alu2+1)):0.0f);\n      float val1 = ((((alu1+2)<alu0)!=1)?*(data1_65536+(alu2+2)):0.0f);\n      float val2 = ((((alu1+3)<alu0)!=1)?*(data1_65536+(alu2+3)):0.0f);\n      float val3 = (((alu1<alu0)!=1)?*(data1_65536+alu2):0.0f);\n      *((float4*)((data0_65536+alu2))) = (float4){val3,val0,val1,val2};\n    }\n  }\n}\n"
