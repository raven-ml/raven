30 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void E_n(float* restrict data0_64, float* restrict data1_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_64+alu0));\n    *(data0_64+alu0) = ((val0*2.0f)+1.0f);\n  }\n}\n"
