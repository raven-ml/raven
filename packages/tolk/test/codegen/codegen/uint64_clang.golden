18 Ops.SOURCE dtypes.void [] "\nvoid E_16(unsigned long* restrict data0_16, unsigned long* restrict data1_16, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    unsigned long val0 = (*(data1_16+alu0));\n    *(data0_16+alu0) = (val0>>3ul);\n  }\n}\n"
