43 Ops.SOURCE dtypes.void [] "\nvoid E_4_4(unsigned long* restrict data0_16, unsigned long* restrict data1_16, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<2);\n    int alu1 = (alu0+1);\n    unsigned long val0 = (*(data1_16+alu1));\n    int alu2 = (alu0+2);\n    unsigned long val1 = (*(data1_16+alu2));\n    int alu3 = (alu0+3);\n    unsigned long val2 = (*(data1_16+alu3));\n    unsigned long val3 = (*(data1_16+alu0));\n    *(data0_16+alu1) = (val0>>3ul);\n    *(data0_16+alu2) = (val1>>3ul);\n    *(data0_16+alu3) = (val2>>3ul);\n    *(data0_16+alu0) = (val3>>3ul);\n  }\n}\n"
