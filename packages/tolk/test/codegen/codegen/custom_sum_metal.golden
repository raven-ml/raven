24 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_1; device float* data1_64; };\nkernel void custom_sum_64(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_1 = args.data0_1; device float* data1_64 = args.data1_64;\n  int gidx0 = gid.x; /* 64 */\n  float val0 = (*(data1_64+gidx0));\n  *(data0_1+0) = 0.0f;\n  float val1 = (*(data0_1+0));\n  *(data0_1+0) = (val1+val0);\n}"
