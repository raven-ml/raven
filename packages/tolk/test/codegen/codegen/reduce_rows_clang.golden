121 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void reduce_rows(float* restrict data0_256, float* restrict data1_8) {\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    int alu0 = (Lidx0<<5);\n    float4 val0 = (*((float4*)((data0_256+(alu0+12)))));\n    float4 val1 = (*((float4*)((data0_256+(alu0+16)))));\n    float4 val2 = (*((float4*)((data0_256+(alu0+20)))));\n    float4 val3 = (*((float4*)((data0_256+(alu0+24)))));\n    float4 val4 = (*((float4*)((data0_256+(alu0+28)))));\n    float4 val5 = (*((float4*)((data0_256+(alu0+4)))));\n    float4 val6 = (*((float4*)((data0_256+(alu0+8)))));\n    float4 val7 = (*((float4*)((data0_256+alu0))));\n    *(data1_8+Lidx0) = (val7[0]+val7[1]+val7[2]+val7[3]+val5[0]+val5[1]+val5[2]+val5[3]+val6[0]+val6[1]+val6[2]+val6[3]+val0[0]+val0[1]+val0[2]+val0[3]+val1[0]+val1[1]+val1[2]+val1[3]+val2[0]+val2[1]+val2[2]+val2[3]+val3[0]+val3[1]+val3[2]+val3[3]+val4[0]+val4[1]+val4[2]+val4[3]);\n  }\n}\n"
