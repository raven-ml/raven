49 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void slice_sum_8_16(float* restrict data0_8, float* restrict data1_128, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    *(buf0+0) = 0.0f;\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      float val0 = (*(data1_128+((Lidx1+(alu0<<4))&127)));\n      *(buf0+0) = ((*(buf0+0))+val0);\n    }\n    *(data0_8+alu0) = (*(buf0+0));\n  }\n}\n"
