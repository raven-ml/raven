92 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void r_64_16_4(float* restrict data0_64, float* restrict data1_64, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    *(buf0+0) = 0.0f;\n    for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n      int alu2 = ((Lidx0<<2)+alu0);\n      float val0 = ((59<alu2)?*(data1_64+(alu2+-60)):0.0f);\n      float val1 = ((60<alu2)?*(data1_64+(alu2+-61)):0.0f);\n      float val2 = ((61<alu2)?*(data1_64+(alu2+-62)):0.0f);\n      float val3 = ((62<alu2)?*(data1_64+(alu2+-63)):0.0f);\n      *(buf0+0) = ((*(buf0+0))+(val3+val2+val1+val0));\n    }\n    *(data0_64+alu0) = (*(buf0+0));\n  }\n}\n"
