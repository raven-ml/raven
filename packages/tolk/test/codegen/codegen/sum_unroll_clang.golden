75 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(4),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void r_64_16_4(float* restrict data0_64, float* restrict data1_4096, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    *(buf0+0) = 0.0f;\n    for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n      float4 val0 = (*((float4*)((data1_4096+((Lidx0<<2)+(alu0<<6))))));\n      *(buf0+0) = ((*(buf0+0))+(val0[0]+val0[1]+val0[2]+val0[3]));\n    }\n    *(data0_64+alu0) = (*(buf0+0));\n  }\n}\n"
