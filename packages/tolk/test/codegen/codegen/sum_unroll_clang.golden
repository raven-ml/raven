71 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid r_64_16_4(float* restrict data0_64, float* restrict data1_4096, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    *(buf0+0) = 0.0f;\n    for (int Ridx0 = 0; Ridx0 < 16; Ridx0++) {\n      float4 val0 = (*((float4*)((data1_4096+((Ridx0<<2)+(alu0<<6))))));\n      *(buf0+0) = ((*(buf0+0))+val0[0]+val0[1]+val0[2]+val0[3]);\n    }\n    *(data0_64+alu0) = (*(buf0+0));\n  }\n}\n"
