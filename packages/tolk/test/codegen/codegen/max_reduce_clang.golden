64 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void max_reduce(float* restrict data0_64, float* restrict data1_1) {\n  float buf0[1];\n  *(buf0+0) = ((float)(-__builtin_inff()));\n  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n    float val0 = (*(buf0+0));\n    float4 val1 = (*((float4*)((data0_64+(Lidx0<<2)))));\n    float alu1 = ((val1[0]<val1[1])?val1[1]:val1[0]);\n    float alu2 = ((alu1<val1[2])?val1[2]:alu1);\n    float alu3 = ((alu2<val1[3])?val1[3]:alu2);\n    float alu4 = ((val0<alu3)?alu3:val0);\n    *(buf0+0) = alu4;\n  }\n  *(data1_1+0) = (*(buf0+0));\n}\n"
