38 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) test(int* data0_1, int* data1_1, bool* data2_) {\n  __shared__ __align__(16) int buf0[1];\n  __shared__ __align__(16) int buf1[1];\n  int val0 = (*(data0_1+0));\n  for (;;) {\n    *(buf0+0) = val0;\n    __syncthreads();\n    int val1 = (*(buf1+0));\n    *(data1_1+0) = val1;\n    if (!(data2_)) { break; }\n  }\n}"
