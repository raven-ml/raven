44 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_256; device float* data1_256; device float* data2_4; };\nkernel void E_4_16_4(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_256 = args.data0_256; device float* data1_256 = args.data1_256; device float* data2_4 = args.data2_4;\n  int lidx0 = lid.x; /* 4 */\n  float val0 = (*(data2_4+lidx0));\n  int lidx1 = lid.y; /* 16 */\n  int alu0 = ((lidx0<<6)+(lidx1<<2));\n  float4 val1 = (*((device float4*)((data1_256+alu0))));\n  float alu1 = (1/val0);\n  *((device float4*)((data0_256+alu0))) = float4((val1.x*alu1),(val1.y*alu1),(val1.z*alu1),(val1.w*alu1));\n}"
