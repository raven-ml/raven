36 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_256; device float* data1_256; device float* data2_256; };\nkernel void custom_gemm_16_16_16(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_256 = args.data0_256; device float* data1_256 = args.data1_256; device float* data2_256 = args.data2_256;\n  int gidx0 = gid.x; /* 16 */\n  int gidx1 = gid.y; /* 16 */\n  int alu0 = (gidx1<<4);\n  int alu1 = (alu0+gidx0);\n  *(data0_256+alu1) = 0.0f;\n  for (int Lidx2 = 0; Lidx2 < 16; Lidx2++) {\n    float val0 = (*(data1_256+(alu0+Lidx2)));\n    float val1 = (*(data2_256+((Lidx2<<4)+gidx0)));\n    float val2 = (*(data0_256+alu1));\n    *(data0_256+alu1) = (val2+(val0*val1));\n  }\n}"
