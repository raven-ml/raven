41 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(64) E_16_4_4(float* data0_256, float* data1_16, float* data2_256) {\n  int lidx0 = threadIdx.x; /* 16 */\n  float val0 = (*(data1_16+lidx0));\n  int lidx1 = threadIdx.y; /* 4 */\n  int alu0 = ((lidx0<<4)+(lidx1<<2));\n  float4 val1 = (*((float4*)((data2_256+alu0))));\n  *((float4*)((data0_256+alu0))) = make_float4((val0+val1.x),(val0+val1.y),(val0+val1.z),(val0+val1.w));\n}"
