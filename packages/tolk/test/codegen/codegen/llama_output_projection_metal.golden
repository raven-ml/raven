71 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct r_2_2_16_8_args { device float* arg0; device float* arg1; device float* arg2; };\nkernel void r_2_2_16_8(constant struct r_2_2_16_8_args* args, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_64 = args->arg0;\n  device float* data1_16 = args->arg1;\n  device float* data2_256 = args->arg2;\n  int lidx0 = lid.x; /* 2 */\n  int alu0 = (lidx0<<3);\n  float4 val0 = (*((device float4*)((data1_16+(alu0+4)))));\n  float4 val1 = (*((device float4*)((data1_16+alu0))));\n  int gidx0 = gid.x; /* 2 */\n  int lidx1 = lid.y; /* 16 */\n  int alu1 = ((gidx0<<7)+(lidx1<<3));\n  float4 val2 = (*((device float4*)((data2_256+(alu1+4)))));\n  float4 val3 = (*((device float4*)((data2_256+alu1))));\n  *(data0_64+((gidx0<<4)+lidx1+(lidx0<<5))) = fma(val0.w,val2.w,fma(val0.z,val2.z,fma(val0.y,val2.y,fma(val0.x,val2.x,fma(val1.w,val3.w,fma(val1.z,val3.z,fma(val1.y,val3.y,(val1.x*val3.x))))))));\n}"
