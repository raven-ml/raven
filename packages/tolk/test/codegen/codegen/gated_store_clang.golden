25 Ops.SOURCE dtypes.void [] "\nvoid gated_store(float* restrict data0_256, float* restrict data1_256, float* restrict data2_256) {\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val0 = (*(data0_256+Lidx0));\n    float val1 = (*(data1_256+Lidx0));\n    if ((Lidx0<200)) {\n      *(data2_256+Lidx0) = (val0+val1);\n    }\n  }\n}\n"
