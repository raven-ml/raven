25 Ops.SOURCE dtypes.void [] "\nstruct gated_store_args { float* data0_256; float* data1_256; float* data2_256; };\n__attribute__((min_vector_width(512))) void gated_store(const struct gated_store_args* args) {\n  float* restrict data0_256 = args->data0_256;\n  float* restrict data1_256 = args->data1_256;\n  float* restrict data2_256 = args->data2_256;\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val0 = (*(data0_256+Lidx0));\n    float val1 = (*(data1_256+Lidx0));\n    if ((Lidx0<200)) {\n      *(data2_256+Lidx0) = (val0+val1);\n    }\n  }\n}\n"
