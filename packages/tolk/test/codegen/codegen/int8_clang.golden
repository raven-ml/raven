22 Ops.SOURCE dtypes.void [] "\nvoid E_64(signed char* restrict data0_64, signed char* restrict data1_64, signed char* restrict data2_64, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    signed char val0 = (*(data1_64+alu0));\n    signed char val1 = (*(data2_64+alu0));\n    *(data0_64+alu0) = ((val0+val1)*((signed char)(3)));\n  }\n}\n"
