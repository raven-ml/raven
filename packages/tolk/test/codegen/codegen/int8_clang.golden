54 Ops.SOURCE dtypes.void [] "\nvoid E_16_4(signed char* restrict data0_64, signed char* restrict data1_64, signed char* restrict data2_64) {\n  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n    int alu0 = (Lidx0<<2);\n    int alu1 = (alu0+1);\n    signed char val0 = (*(data1_64+alu1));\n    int alu2 = (alu0+2);\n    signed char val1 = (*(data1_64+alu2));\n    int alu3 = (alu0+3);\n    signed char val2 = (*(data1_64+alu3));\n    signed char val3 = (*(data1_64+alu0));\n    signed char val4 = (*(data2_64+alu1));\n    signed char val5 = (*(data2_64+alu2));\n    signed char val6 = (*(data2_64+alu3));\n    signed char val7 = (*(data2_64+alu0));\n    *(data0_64+alu1) = ((val0+val4)*((signed char)(3)));\n    *(data0_64+alu2) = ((val1+val5)*((signed char)(3)));\n    *(data0_64+alu3) = ((val2+val6)*((signed char)(3)));\n    *(data0_64+alu0) = ((val3+val7)*((signed char)(3)));\n  }\n}\n"
