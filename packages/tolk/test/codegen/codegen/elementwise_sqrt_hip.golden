14 Ops.SOURCE dtypes.void [] "extern \"C\" __attribute__((device, const)) float __ocml_sqrt_f32(float);\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) elementwise_sqrt(float* data0_256, float* data1_256) {\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val0 = (*(data0_256+Lidx0));\n    *(data1_256+Lidx0) = __ocml_sqrt_f32(val0);\n  }\n}"
