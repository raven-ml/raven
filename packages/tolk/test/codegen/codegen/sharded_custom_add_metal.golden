42 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_128; device float* data1_128; device float* data2_128; };\nkernel void custom_add_kernel_128(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_128 = args.data0_128; device float* data1_128 = args.data1_128; device float* data2_128 = args.data2_128;\n  int lidx0 = lid.x; /* 32 */\n  int alu0 = (lidx0<<2);\n  float4 val0 = (*((device float4*)((data1_128+alu0))));\n  float4 val1 = (*((device float4*)((data2_128+alu0))));\n  *((device float4*)((data0_128+alu0))) = float4((val0.x+val1.x),(val0.y+val1.y),(val0.z+val1.z),(val0.w+val1.w));\n}"
