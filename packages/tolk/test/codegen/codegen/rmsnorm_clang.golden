43 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_4_16_4(float* restrict data0_256, float* restrict data1_256, float* restrict data2_4) {\n  for (int Lidx0 = 0; Lidx0 < 4; Lidx0++) {\n    float val0 = (*(data2_4+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      int alu0 = ((Lidx0<<6)+(Lidx1<<2));\n      float4 val1 = (*((float4*)((data1_256+alu0))));\n      *((float4*)((data0_256+alu0))) = (float4){(val1[0]/val0),(val1[1]/val0),(val1[2]/val0),(val1[3]/val0)};\n    }\n  }\n}\n"
