30 Ops.SOURCE dtypes.void [] "\nvoid E_4_64(float* restrict data0_256, float* restrict data1_256, float* restrict data2_4, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < 4; Lidx0++) {\n    float val0 = (*(data2_4+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n      int alu0 = ((Lidx0<<6)+(block_lo_+Lidx1));\n      float val1 = (*(data1_256+alu0));\n      *(data0_256+alu0) = (val1*(1.0f/val0));\n    }\n  }\n}\n"
