71 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) lorenz_fold(float* data0_16, float* data1_16, float* data2_16, float* data3_16) {\n  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n    float val0 = (*(data0_16+Lidx0));\n    float val1 = (*(data1_16+Lidx0));\n    float val2 = (*(data2_16+Lidx0));\n    float alu0 = (val0+(0.0625f*(10.0f*(val1-val0))));\n    float alu1 = (val1+(0.0625f*((val0*(28.0f-val2))-val1)));\n    float alu2 = (val2+(0.0625f*((val0*val1)-(2.5f*val2))));\n    float alu3 = (alu0+(0.0625f*(10.0f*(alu1-alu0))));\n    float alu4 = (alu1+(0.0625f*((alu0*(28.0f-alu2))-alu1)));\n    float alu5 = (alu2+(0.0625f*((alu0*alu1)-(2.5f*alu2))));\n    *(data3_16+Lidx0) = (alu3+(0.0625f*(10.0f*(alu4-alu3)))+(alu4+(0.0625f*((alu3*(28.0f-alu5))-alu4)))+(alu5+(0.0625f*((alu3*alu4)-(2.5f*alu5)))));\n  }\n}"
