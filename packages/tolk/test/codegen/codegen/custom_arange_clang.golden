30 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid custom_arange_16(float* restrict data0_16, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<2);\n    *((float4*)((data0_16+alu0))) = (float4){((float)(alu0)),((float)((alu0+1))),((float)((alu0+2))),((float)((alu0+3)))};\n  }\n}\n"
