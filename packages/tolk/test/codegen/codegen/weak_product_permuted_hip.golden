36 Ops.SOURCE dtypes.void [] "typedef long unsigned int size_t;\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_group_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_size(unsigned int);\ntypedef int int4 __attribute__((ext_vector_type(4)));\nstatic inline __attribute__((device)) int4 make_int4(int x, int y, int z, int w) { return { x, y, z, w }; }\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 2))) E_2_4(int* data0_8, int* data1_8) {\n  int lidx0 = __ockl_get_local_id(0); /* 2 */\n  int val0 = (*(data1_8+lidx0));\n  int val1 = (*(data1_8+(lidx0+2)));\n  int val2 = (*(data1_8+(lidx0+4)));\n  int val3 = (*(data1_8+(lidx0+6)));\n  *((int4*)((data0_8+(lidx0<<2)))) = make_int4((val0<<31),(val1<<31),(val2<<31),(val3<<31));\n}"
