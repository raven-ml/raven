44 Ops.SOURCE dtypes.void [] "typedef long unsigned int size_t;\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_group_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_size(unsigned int);\ntypedef float float4 __attribute__((ext_vector_type(4)));\nstatic inline __attribute__((device)) float4 make_float4(float x, float y, float z, float w) { return { x, y, z, w }; }\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 32))) E_8_32_4(float* data0_1024, float* data1_1024) {\n  int gidx0 = __ockl_get_group_id(0); /* 8 */\n  int lidx0 = __ockl_get_local_id(0); /* 32 */\n  int alu0 = ((gidx0<<7)+(lidx0<<2));\n  float4 val0 = (*((float4*)((data1_1024+alu0))));\n  *((float4*)((data0_1024+alu0))) = make_float4((val0.x*2.0f),(val0.y*2.0f),(val0.z*2.0f),(val0.w*2.0f));\n}"
