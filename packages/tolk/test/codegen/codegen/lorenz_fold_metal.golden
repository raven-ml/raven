71 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_16; device float* data1_16; device float* data2_16; device float* data3_16; };\nkernel void lorenz_fold(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_16 = args.data0_16; device float* data1_16 = args.data1_16; device float* data2_16 = args.data2_16; device float* data3_16 = args.data3_16;\n  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n    float val0 = (*(data0_16+Lidx0));\n    float val1 = (*(data1_16+Lidx0));\n    float val2 = (*(data2_16+Lidx0));\n    float alu0 = (val0+(0.0625f*(10.0f*(val1-val0))));\n    float alu1 = (val1+(0.0625f*((val0*(28.0f-val2))-val1)));\n    float alu2 = (val2+(0.0625f*((val0*val1)-(2.5f*val2))));\n    float alu3 = (alu0+(0.0625f*(10.0f*(alu1-alu0))));\n    float alu4 = (alu1+(0.0625f*((alu0*(28.0f-alu2))-alu1)));\n    float alu5 = (alu2+(0.0625f*((alu0*alu1)-(2.5f*alu2))));\n    *(data3_16+Lidx0) = (alu3+(0.0625f*(10.0f*(alu4-alu3)))+(alu4+(0.0625f*((alu3*(28.0f-alu5))-alu4)))+(alu5+(0.0625f*((alu3*alu4)-(2.5f*alu5)))));\n  }\n}"
