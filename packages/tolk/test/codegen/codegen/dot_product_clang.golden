67 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void dot_product(float* restrict data0_128, float* restrict data1_128, float* restrict data2_1) {\n  float buf0[1];\n  *(buf0+0) = 0.0f;\n  for (int Lidx0 = 0; Lidx0 < 32; Lidx0++) {\n    int alu1 = (Lidx0<<2);\n    float4 val0 = (*((float4*)((data0_128+alu1))));\n    float4 val1 = (*((float4*)((data1_128+alu1))));\n    *(buf0+0) = ((*(buf0+0))+__builtin_fmaf(val0[3],val1[3],__builtin_fmaf(val0[2],val1[2],__builtin_fmaf(val0[1],val1[1],(val0[0]*val1[0])))));\n  }\n  *(data2_1+0) = (*(buf0+0));\n}\n"
