24 Ops.SOURCE dtypes.void [] "typedef long unsigned int size_t;\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_group_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_size(unsigned int);\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) custom_sum_64(float* data0_1, float* data1_64) {\n  int gidx0 = __ockl_get_group_id(0); /* 64 */\n  float val0 = (*(data1_64+gidx0));\n  *(data0_1+0) = 0.0f;\n  float val1 = (*(data0_1+0));\n  *(data0_1+0) = (val1+val0);\n}"
