37 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_128; device float* data1_128; };\nkernel void E_32_4(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_128 = args.data0_128; device float* data1_128 = args.data1_128;\n  int lidx0 = lid.x; /* 32 */\n  int alu0 = (lidx0<<2);\n  float4 val0 = (*((device float4*)((data1_128+alu0))));\n  *((device float4*)((data0_128+alu0))) = float4((val0.x+1.0f),(val0.y+1.0f),(val0.z+1.0f),(val0.w+1.0f));\n}"
