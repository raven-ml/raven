34 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(4),ext_vector_type(4)));\nstruct flip_contract_32_args { float* arg0; float* arg1; int arg2; int arg3; };\n__attribute__((min_vector_width(512))) void flip_contract_32(const struct flip_contract_32_args* args) {\n  float* data0_32 = args->arg0;\n  float* data1_32 = args->arg1;\n  int block_lo_ = args->arg2;\n  int block_hi_ = args->arg3;\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<2);\n    float4 val0 = (*((float4*)((data1_32+alu0))));\n    *((float4*)((data0_32+alu0))) = (float4){val0[3],val0[2],val0[1],val0[0]};\n  }\n}\n"
