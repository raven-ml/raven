32 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid flip_contract_32(float* restrict data0_32, float* restrict data1_32, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<2);\n    float4 val0 = (*((float4*)((data1_32+alu0))));\n    *((float4*)((data0_32+alu0))) = (float4){val0[3],val0[2],val0[1],val0[0]};\n  }\n}\n"
