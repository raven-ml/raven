111 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(16) reduce_rows(float* data0_256, float* data1_8) {\n  float buf0[1];\n  float buf1[1];\n  __shared__ __align__(16) float buf2[16];\n  int lidx0 = threadIdx.x; /* 16 */\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    *(buf0+0) = 0.0f;\n    for (int Lidx1 = 0; Lidx1 < 2; Lidx1++) {\n      float val0 = (*(data0_256+((lidx0<<1)+Lidx1+(Lidx0<<5))));\n      *(buf0+0) = ((*(buf0+0))+val0);\n    }\n    *(buf2+lidx0) = (*(buf0+0));\n    __syncthreads();\n    *(buf1+0) = 0.0f;\n    for (int Lidx102 = 0; Lidx102 < 16; Lidx102++) {\n      float val1 = (*(buf2+Lidx102));\n      *(buf1+0) = ((*(buf1+0))+val1);\n    }\n    if ((lidx0==0)) {\n      *(data1_8+Lidx0) = (*(buf1+0));\n    }\n    __syncthreads();\n  }\n}"
