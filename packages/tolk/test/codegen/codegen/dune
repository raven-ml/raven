; The tests of programs on disk make their caches under the working directory,
; which the sandbox makes fresh. The suite runs as three shards, which dune
; runs in parallel. Its tensor-core tests run on the first CUDA GPU and skip
; without one.

(executable
 (name test_codegen)
 (libraries
  windtrap
  tolk
  tolk_test
  tolk_run
  tolk_gpus
  tolk.engine
  rig
  rig.cuda
  rig.metal
  rig.nv.nvidia
  rig.amd.amdgpu
  rig.elf
  unix))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (run %{exe:test_codegen.exe} --shard 1/3)))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (run %{exe:test_codegen.exe} --shard 2/3)))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (run %{exe:test_codegen.exe} --shard 3/3)))
