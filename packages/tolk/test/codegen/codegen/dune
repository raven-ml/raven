; The tests of programs on disk make their caches under the working directory,
; which the sandbox makes fresh. The suite runs as three shards, which dune
; runs in parallel.

(executable
 (name test_codegen)
 (libraries windtrap tolk tolk_test tolk_run tolk.engine nx.device unix))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (run %{exe:test_codegen.exe} --shard 1/3)))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (run %{exe:test_codegen.exe} --shard 2/3)))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (run %{exe:test_codegen.exe} --shard 3/3)))
