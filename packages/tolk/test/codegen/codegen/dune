; Settings are read when the program starts, so CACHEDB is set here, to a
; directory of the sandbox: programs kept on disk by one run are not read back
; by the next.

(test
 (name test_codegen)
 (package tolk)
 (libraries windtrap tolk tolk_test tolk_run tolk.engine nx.device unix)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test} --exclude-tag slow))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_codegen.exe} --tag slow)))
