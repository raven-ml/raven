; Settings are read when the program starts, so CACHEDB is set here, to a
; directory of the sandbox: programs kept on disk by one run are not read back
; by the next. The suite runs as three shards, which dune runs in parallel.

(executable
 (name test_codegen)
 (libraries windtrap tolk tolk_test tolk_run tolk.engine nx.device unix))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_codegen.exe} --exclude-tag slow --shard 1/3))))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_codegen.exe} --exclude-tag slow --shard 2/3))))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_codegen.exe} --exclude-tag slow --shard 3/3))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_codegen.exe} --tag slow)))
