; The tests of programs on disk make their caches under the working directory,
; which the sandbox makes fresh. The suite runs in three worker processes. Its
; tensor-core tests run on the first CUDA GPU and skip without one. Those
; tagged no-elementwise run in a process of their own, where CC names a script
; that runs the suite's Clang, which it passes as TOLK_CLANG, without its
; elementwise builtins.

(executable
 (name test_codegen)
 (libraries
  windtrap
  tolk
  tolk_test
  tolk_run
  tolk_gpus
  tolk.engine
  rig
  rig.cuda
  rig.metal
  rig.nv.nvidia
  rig.amd.amdgpu
  rig.elf
  unix))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (run %{exe:test_codegen.exe} -j 3 --exclude-tag no-elementwise)))

(rule
 (alias runtest)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk)
  clang_no_elementwise)
 (action
  (setenv
   TOLK_CLANG
   %{env:CC=clang}
   (setenv
    CC
    ./clang_no_elementwise
    (run %{exe:test_codegen.exe} --tag no-elementwise)))))

; The laws on Metal run again under Metal's API validation, which aborts a
; launch whose bound arguments break the rules of the function it calls.
; GitHub's macOS machines have a device without residency sets, and there
; the validation layer aborts in the call that opens it.

(rule
 (alias runtest)
 (package tolk)
 (enabled_if
  (and
   (= %{system} macosx)
   (<> %{env:GITHUB_ACTIONS=false} true)))
 (deps
  (sandbox always)
  (glob_files *.golden)
  (glob_files *.tolk))
 (action
  (setenv
   MTL_DEBUG_LAYER
   1
   (run
    %{exe:test_codegen.exe}
    -f
    "casts to an 8-bit float › on each GPU › Metal"
    -f
    "constants past the width › on each GPU › Metal"))))
