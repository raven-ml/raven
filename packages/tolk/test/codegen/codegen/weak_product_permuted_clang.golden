39 Ops.SOURCE dtypes.void [] "typedef int int4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_2_4(int* restrict data0_8, int* restrict data1_8, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    int val0 = (*(data1_8+alu0));\n    int val1 = (*(data1_8+(alu0+2)));\n    int val2 = (*(data1_8+(alu0+4)));\n    int val3 = (*(data1_8+(alu0+6)));\n    *((int4*)((data0_8+(alu0<<2)))) = (int4){(val0<<31),(val1<<31),(val2<<31),(val3<<31)};\n  }\n}\n"
