59 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\n__attribute__((min_vector_width(512))) void sum_reduce(float* restrict data0_256, float* restrict data1_1) {\n  float buf0[1];\n  *(buf0+0) = 0.0f;\n  for (int Lidx0 = 0; Lidx0 < 64; Lidx0++) {\n    float4 val0 = (*((float4*)((data0_256+(Lidx0<<2)))));\n    *(buf0+0) = ((*(buf0+0))+(val0[0]+val0[1]+val0[2]+val0[3]));\n  }\n  *(data1_1+0) = (*(buf0+0));\n}\n"
