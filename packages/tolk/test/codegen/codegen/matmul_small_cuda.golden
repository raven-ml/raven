54 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) matmul_small(float* data0_16, float* data1_16, float* data2_16) {\n  for (int Lidx0 = 0; Lidx0 < 4; Lidx0++) {\n    int alu0 = (Lidx0<<2);\n    float4 val0 = (*((float4*)((data0_16+alu0))));\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      float val1 = (*(data1_16+(Lidx1+12)));\n      float val2 = (*(data1_16+(Lidx1+4)));\n      float val3 = (*(data1_16+(Lidx1+8)));\n      float val4 = (*(data1_16+Lidx1));\n      *(data2_16+(alu0+Lidx1)) = ((val0.x*val4)+(val0.y*val2)+(val0.z*val3)+(val0.w*val1));\n    }\n  }\n}"
