29 Ops.SOURCE dtypes.void [] "\nvoid E_256_256(float* restrict data0_65536, float* restrict data1_65536, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 256; Lidx1++) {\n      int alu1 = ((alu0<<8)+Lidx1);\n      float val0 = (((Lidx1<alu0)!=1)?*(data1_65536+alu1):0.0f);\n      *(data0_65536+alu1) = val0;\n    }\n  }\n}\n"
