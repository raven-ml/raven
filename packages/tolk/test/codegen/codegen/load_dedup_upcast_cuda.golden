29 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) E_3(float* data0_3, float* data1_4) {\n  float4 val0 = (*((float4*)((data1_4+0))));\n  *(data0_3+2) = (val0.z+val0.w);\n  *((float2*)((data0_3+0))) = make_float2((val0.x+val0.y),(val0.y+val0.z));\n}"
