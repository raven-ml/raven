82 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void simple_qkv_8_4(float* restrict data0_32, float* restrict data1_32, float* restrict data2_32, float* restrict data3_32, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  float buf1[1];\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    int alu1 = (alu0<<2);\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      *(buf1+0) = 0.0f;\n      for (int Lidx2 = 0; Lidx2 < 8; Lidx2++) {\n        *(buf0+0) = 0.0f;\n        int alu4 = (Lidx2<<2);\n        for (int Lidx3 = 0; Lidx3 < 4; Lidx3++) {\n          float val0 = (*(data1_32+(alu1+Lidx3)));\n          float val1 = (*(data2_32+(alu4+Lidx3)));\n          *(buf0+0) = ((*(buf0+0))+(val0*val1));\n        }\n        float val2 = (*(data3_32+(alu4+Lidx1)));\n        *(buf1+0) = ((*(buf1+0))+((*(buf0+0))*0.5f*val2));\n      }\n      *(data0_32+(alu1+Lidx1)) = (*(buf1+0));\n    }\n  }\n}\n"
