69 Ops.SOURCE dtypes.void [] "\n__attribute__((min_vector_width(512))) void r_16_16_16(float* restrict data0_256, float* restrict data1_256, float* restrict data2_256, const int block_lo_, const int block_hi_) {\n  float buf0[1];\n  for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n    int alu0 = (block_lo_+Lidx1);\n    int alu1 = (alu0<<4);\n    for (int Lidx2 = 0; Lidx2 < 16; Lidx2++) {\n      *(buf0+0) = 0.0f;\n      for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n        float val0 = (*(data1_256+(alu1+Lidx0)));\n        float val1 = (*(data2_256+((Lidx0<<4)+Lidx2)));\n        *(buf0+0) = __builtin_fmaf(val0,val1,(*(buf0+0)));\n      }\n      *(data0_256+(alu1+Lidx2)) = (*(buf0+0));\n    }\n  }\n}\n"
