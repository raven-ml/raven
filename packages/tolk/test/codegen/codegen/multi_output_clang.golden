18 Ops.SOURCE dtypes.void [] "\nvoid E_1024(float* restrict data0_1024, float* restrict data1_1024, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_1024+alu0));\n    *(data0_1024+alu0) = (val0*2.0f);\n  }\n}\n"
