51 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_8_4(float* restrict data0_32, float* restrict data1_32, float* restrict data2_32, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<2);\n    float4 val0 = (*((float4*)((data1_32+alu0))));\n    float4 val1 = (*((float4*)((data2_32+alu0))));\n    float alu1 = ((0.0f<val0[0])?val1[0]:1.0f);\n    float alu2 = ((0.0f<val0[1])?val1[1]:1.0f);\n    float alu3 = ((0.0f<val0[2])?val1[2]:1.0f);\n    float alu4 = ((0.0f<val0[3])?val1[3]:1.0f);\n    *((float4*)((data0_32+alu0))) = (float4){alu1,alu2,alu3,alu4};\n  }\n}\n"
