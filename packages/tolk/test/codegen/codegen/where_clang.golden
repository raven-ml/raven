24 Ops.SOURCE dtypes.void [] "\nvoid E_32(float* restrict data0_32, float* restrict data1_32, float* restrict data2_32, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_32+alu0));\n    float val1 = (*(data2_32+alu0));\n    float alu1 = ((0.0f<val0)?val1:1.0f);\n    *(data0_32+alu0) = alu1;\n  }\n}\n"
