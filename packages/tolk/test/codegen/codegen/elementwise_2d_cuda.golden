17 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) elementwise_2d(float* data0_128, float* data1_128, float* data2_128) {\n  for (int Lidx0 = 0; Lidx0 < 128; Lidx0++) {\n    float val0 = (*(data0_128+Lidx0));\n    float val1 = (*(data1_128+Lidx0));\n    *(data2_128+Lidx0) = (val0+val1);\n  }\n}"
