41 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct E_16_4_4_args { device float* data0_256; device float* data1_16; device float* data2_256; };\nkernel void E_16_4_4(constant struct E_16_4_4_args* args, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_256 = args->data0_256;\n  device float* data1_16 = args->data1_16;\n  device float* data2_256 = args->data2_256;\n  int lidx0 = lid.x; /* 16 */\n  float val0 = (*(data1_16+lidx0));\n  int lidx1 = lid.y; /* 4 */\n  int alu0 = ((lidx0<<4)+(lidx1<<2));\n  float4 val1 = (*((device float4*)((data2_256+alu0))));\n  *((device float4*)((data0_256+alu0))) = float4((val0+val1.x),(val0+val1.y),(val0+val1.z),(val0+val1.w));\n}"
