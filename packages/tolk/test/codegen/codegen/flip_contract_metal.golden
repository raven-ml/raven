29 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_32; device float* data1_32; };\nkernel void flip_contract_32(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_32 = args.data0_32; device float* data1_32 = args.data1_32;\n  int gidx0 = gid.x; /* 8 */\n  int alu0 = (gidx0<<2);\n  float4 val0 = (*((device float4*)((data1_32+alu0))));\n  *((device float4*)((data0_32+alu0))) = float4(val0.w,val0.z,val0.y,val0.x);\n}"
