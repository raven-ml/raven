35 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) custom_gemm_16_16_16(float* data0_256, float* data1_256, float* data2_256) {\n  int gidx0 = blockIdx.x; /* 16 */\n  int gidx1 = blockIdx.y; /* 16 */\n  int alu0 = (gidx1<<4);\n  int alu1 = (gidx0+alu0);\n  *(data0_256+alu1) = 0.0f;\n  for (int Ridx2 = 0; Ridx2 < 16; Ridx2++) {\n    float val0 = (*(data1_256+(alu0+Ridx2)));\n    float val1 = (*(data2_256+(gidx0+(Ridx2<<4))));\n    float val2 = (*(data0_256+alu1));\n    *(data0_256+alu1) = (val2+(val0*val1));\n  }\n}"
