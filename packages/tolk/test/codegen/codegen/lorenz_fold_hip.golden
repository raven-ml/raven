68 Ops.SOURCE dtypes.void [] "\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) lorenz_fold(float* data0_16, float* data1_16, float* data2_16, float* data3_16) {\n  for (int Lidx0 = 0; Lidx0 < 16; Lidx0++) {\n    float val0 = (*(data0_16+Lidx0));\n    float val1 = (*(data1_16+Lidx0));\n    float val2 = (*(data2_16+Lidx0));\n    float alu0 = (val0+((val1-val0)*0.625f));\n    float alu1 = (val1+(0.0625f*((val0*(28.0f-val2))-val1)));\n    float alu2 = (val2+(0.0625f*((val0*val1)+(val2*-2.5f))));\n    float alu3 = (alu0+((alu1-alu0)*0.625f));\n    float alu4 = (alu1+(0.0625f*((alu0*(28.0f-alu2))-alu1)));\n    float alu5 = (alu2+(0.0625f*((alu0*alu1)+(alu2*-2.5f))));\n    *(data3_16+Lidx0) = (alu3+((alu4-alu3)*0.625f)+alu4+(0.0625f*((alu3*(28.0f-alu5))-alu4))+alu5+(0.0625f*((alu3*alu4)+(alu5*-2.5f))));\n  }\n}"
