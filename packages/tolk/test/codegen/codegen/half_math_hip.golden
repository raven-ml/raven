52 Ops.SOURCE dtypes.void [] "typedef long unsigned int size_t;\n#define half _Float16\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_group_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_size(unsigned int);\nextern \"C\" __attribute__((device, pure)) half __ocml_exp2_f16(half);\nextern \"C\" __attribute__((device, const)) half __ocml_sqrt_f16(half);\ntypedef half half4 __attribute__((ext_vector_type(4)));\nstatic inline __attribute__((device)) half4 make_half4(half x, half y, half z, half w) { return { x, y, z, w }; }\ntypedef float float4 __attribute__((ext_vector_type(4)));\nstatic inline __attribute__((device)) float4 make_float4(float x, float y, float z, float w) { return { x, y, z, w }; }\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 4))) E_4_4(float* data0_16, half* data1_16, half* data2_16) {\n  int lidx0 = __ockl_get_local_id(0); /* 4 */\n  int alu0 = (lidx0<<2);\n  half4 val0 = (*((half4*)((data1_16+alu0))));\n  half4 val1 = (*((half4*)((data2_16+alu0))));\n  *((float4*)((data0_16+alu0))) = make_float4(((float)((__ocml_exp2_f16(val0.x)+__ocml_sqrt_f16(val1.x)))),((float)((__ocml_exp2_f16(val0.y)+__ocml_sqrt_f16(val1.y)))),((float)((__ocml_exp2_f16(val0.z)+__ocml_sqrt_f16(val1.z)))),((float)((__ocml_exp2_f16(val0.w)+__ocml_sqrt_f16(val1.w)))));\n}"
