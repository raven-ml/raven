34 Ops.SOURCE dtypes.void [] "\nvoid E_8_128(float* restrict data0_1024, float* restrict data1_1024, float* restrict data2_8, float* restrict data3_8, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    float val0 = (*(data2_8+Lidx0));\n    float val1 = (*(data3_8+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n      int alu0 = ((Lidx0<<7)+(block_lo_+Lidx1));\n      float val2 = (*(data1_1024+alu0));\n      *(data0_1024+alu0) = ((val2-val0)*(1.0f/val1));\n    }\n  }\n}\n"
