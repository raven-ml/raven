52 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_8_32_4(float* restrict data0_1024, float* restrict data1_1024, float* restrict data2_8, float* restrict data3_8) {\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    float val0 = (*(data2_8+Lidx0));\n    float val1 = (*(data3_8+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < 32; Lidx1++) {\n      int alu0 = ((Lidx0<<7)+(Lidx1<<2));\n      float4 val2 = (*((float4*)((data1_1024+alu0))));\n      *((float4*)((data0_1024+alu0))) = (float4){((val2[0]-val0)/val1),((val2[1]-val0)/val1),((val2[2]-val0)/val1),((val2[3]-val0)/val1)};\n    }\n  }\n}\n"
