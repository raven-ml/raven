49 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_32_16_4(float* restrict data0_2048, float* restrict data1_2048, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      int alu1 = ((Lidx1<<7)+alu0);\n      float val0 = (*(data1_2048+(alu1+32)));\n      float val1 = (*(data1_2048+(alu1+64)));\n      float val2 = (*(data1_2048+(alu1+96)));\n      float val3 = (*(data1_2048+alu1));\n      *((float4*)((data0_2048+((alu0<<6)+(Lidx1<<2))))) = (float4){val3,val0,val1,val2};\n    }\n  }\n}\n"
