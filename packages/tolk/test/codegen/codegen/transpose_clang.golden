121 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_32_4_16(float* restrict data0_2048, float* restrict data1_2048, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      int alu1 = ((Lidx1<<9)+alu0);\n      float val0 = (*(data1_2048+(alu1+128)));\n      float val1 = (*(data1_2048+(alu1+160)));\n      float val2 = (*(data1_2048+(alu1+192)));\n      float val3 = (*(data1_2048+(alu1+224)));\n      float val4 = (*(data1_2048+(alu1+256)));\n      float val5 = (*(data1_2048+(alu1+288)));\n      float val6 = (*(data1_2048+(alu1+32)));\n      float val7 = (*(data1_2048+(alu1+320)));\n      float val8 = (*(data1_2048+(alu1+352)));\n      float val9 = (*(data1_2048+(alu1+384)));\n      float val10 = (*(data1_2048+(alu1+416)));\n      float val11 = (*(data1_2048+(alu1+448)));\n      float val12 = (*(data1_2048+(alu1+480)));\n      float val13 = (*(data1_2048+(alu1+64)));\n      float val14 = (*(data1_2048+(alu1+96)));\n      float val15 = (*(data1_2048+alu1));\n      int alu2 = ((alu0<<6)+(Lidx1<<4));\n      *((float4*)((data0_2048+(alu2+12)))) = (float4){val9,val10,val11,val12};\n      *((float4*)((data0_2048+(alu2+4)))) = (float4){val0,val1,val2,val3};\n      *((float4*)((data0_2048+(alu2+8)))) = (float4){val4,val5,val7,val8};\n      *((float4*)((data0_2048+alu2))) = (float4){val15,val6,val13,val14};\n    }\n  }\n}\n"
