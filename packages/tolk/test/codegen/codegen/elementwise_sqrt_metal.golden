33 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nkernel void elementwise_sqrt(device unsigned char* args_16, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  unsigned long val0 = (*(((device unsigned long*)(args_16))+0));\n  unsigned long val1 = (*(((device unsigned long*)(args_16))+1));\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val2 = (*(((device float*)(val0))+Lidx0));\n    *(((device float*)(val1))+Lidx0) = sqrt(val2);\n  }\n}"
