19 Ops.SOURCE dtypes.void [] "\nvoid custom_add_kernel_128(float* restrict data0_128, float* restrict data1_128, float* restrict data2_128, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_128+alu0));\n    float val1 = (*(data2_128+alu0));\n    *(data0_128+alu0) = (val0+val1);\n  }\n}\n"
