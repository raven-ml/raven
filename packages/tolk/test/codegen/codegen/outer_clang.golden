27 Ops.SOURCE dtypes.void [] "\nvoid E_32_48(float* restrict data0_1536, float* restrict data1_32, float* restrict data2_48, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < 32; Lidx0++) {\n    float val0 = (*(data1_32+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n      int alu0 = (block_lo_+Lidx1);\n      float val1 = (*(data2_48+alu0));\n      *(data0_1536+((Lidx0*48)+alu0)) = (val0*val1);\n    }\n  }\n}\n"
