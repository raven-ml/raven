49 Ops.SOURCE dtypes.void [] "\nvoid E_32_16_3(float* restrict data0_1536, float* restrict data1_32, float* restrict data2_48, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    float val0 = (*(data1_32+alu0));\n    for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n      int alu1 = (Lidx1*3);\n      float val1 = (*(data2_48+(alu1+1)));\n      float val2 = (*(data2_48+(alu1+2)));\n      float val3 = (*(data2_48+alu1));\n      int alu2 = ((alu0*48)+alu1);\n      *(data0_1536+(alu2+1)) = (val0*val1);\n      *(data0_1536+(alu2+2)) = (val0*val2);\n      *(data0_1536+alu2) = (val0*val3);\n    }\n  }\n}\n"
