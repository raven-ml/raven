17 Ops.SOURCE dtypes.void [] "\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) elementwise_add(float* data0_256, float* data1_256, float* data2_256) {\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val0 = (*(data0_256+Lidx0));\n    float val1 = (*(data1_256+Lidx0));\n    *(data2_256+Lidx0) = (val0+val1);\n  }\n}"
