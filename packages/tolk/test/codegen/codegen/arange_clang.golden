69 Ops.SOURCE dtypes.void [] "typedef int int4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_2_16(int* restrict data0_32, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<4);\n    int alu1 = (alu0+12);\n    int alu2 = (alu0+4);\n    int alu3 = (alu0+8);\n    *((int4*)((data0_32+alu1))) = (int4){alu1,(alu0+13),(alu0+14),(alu0+15)};\n    *((int4*)((data0_32+alu2))) = (int4){alu2,(alu0+5),(alu0+6),(alu0+7)};\n    *((int4*)((data0_32+alu3))) = (int4){alu3,(alu0+9),(alu0+10),(alu0+11)};\n    *((int4*)((data0_32+alu0))) = (int4){alu0,(alu0+1),(alu0+2),(alu0+3)};\n  }\n}\n"
