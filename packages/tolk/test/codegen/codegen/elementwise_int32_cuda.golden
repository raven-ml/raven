17 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) elementwise_int32(int* data0_256, int* data1_256, int* data2_256) {\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    int val0 = (*(data0_256+Lidx0));\n    int val1 = (*(data1_256+Lidx0));\n    *(data2_256+Lidx0) = (val0+val1);\n  }\n}"
