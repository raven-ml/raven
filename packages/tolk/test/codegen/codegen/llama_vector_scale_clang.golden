34 Ops.SOURCE dtypes.void [] "\nvoid E_2_8(float* restrict data0_16, float* restrict data1_16, float* restrict data2_2, float* restrict data3_8, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < 2; Lidx0++) {\n    float val0 = (*(data2_2+Lidx0));\n    for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n      int alu0 = (block_lo_+Lidx1);\n      int alu1 = ((Lidx0<<3)+alu0);\n      float val1 = (*(data1_16+alu1));\n      float val2 = (*(data3_8+alu0));\n      *(data0_16+alu1) = (val1*(1.0f/val0)*val2);\n    }\n  }\n}\n"
