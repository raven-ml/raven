41 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_8_4_4(float* restrict data0_128, float* restrict data1_128) {\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    int alu0 = (Lidx0<<4);\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      float4 val0 = (*((float4*)((data1_128+(alu0+(Lidx1*-4)+12)))));\n      *((float4*)((data0_128+(alu0+(Lidx1<<2))))) = (float4){val0[3],val0[2],val0[1],val0[0]};\n    }\n  }\n}\n"
