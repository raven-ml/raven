66 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_8_16(float* restrict data0_128, float* restrict data1_128, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = ((block_lo_+Lidx0)<<4);\n    int alu1 = (alu0+12);\n    float4 val0 = (*((float4*)((data1_128+alu1))));\n    int alu2 = (alu0+4);\n    float4 val1 = (*((float4*)((data1_128+alu2))));\n    int alu3 = (alu0+8);\n    float4 val2 = (*((float4*)((data1_128+alu3))));\n    float4 val3 = (*((float4*)((data1_128+alu0))));\n    *((float4*)((data0_128+alu1))) = (float4){val3[3],val3[2],val3[1],val3[0]};\n    *((float4*)((data0_128+alu2))) = (float4){val2[3],val2[2],val2[1],val2[0]};\n    *((float4*)((data0_128+alu3))) = (float4){val1[3],val1[2],val1[1],val1[0]};\n    *((float4*)((data0_128+alu0))) = (float4){val0[3],val0[2],val0[1],val0[0]};\n  }\n}\n"
