27 Ops.SOURCE dtypes.void [] "\nvoid E_8_16(float* restrict data0_128, float* restrict data1_128, const int block_lo_, const int block_hi_) {\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    int alu0 = (Lidx0<<4);\n    for (int Lidx1 = 0; Lidx1 < (block_hi_-block_lo_); Lidx1++) {\n      int alu1 = (block_lo_+Lidx1);\n      float val0 = (*(data1_128+((alu0-alu1)+15)));\n      *(data0_128+(alu0+alu1)) = val0;\n    }\n  }\n}\n"
