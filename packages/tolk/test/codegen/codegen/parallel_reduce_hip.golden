169 Ops.SOURCE dtypes.void [] "typedef long unsigned int size_t;\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_group_id(unsigned int);\nextern \"C\" __attribute__((device, const)) size_t __ockl_get_local_size(unsigned int);\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 16))) parallel_reduce(float* data0_128, float* data1_1, float* data2_1) {\n  float buf0[1];\n  float buf1[1];\n  float buf2[1];\n  float buf3[1];\n  __attribute__((shared, aligned(16)))float buf4[16];\n  __attribute__((shared, aligned(16)))float buf5[16];\n  int lidx0 = __ockl_get_local_id(0); /* 16 */\n  *(buf0+0) = 0.0f;\n  *(buf2+0) = 0.0f;\n  for (int Lidx0 = 0; Lidx0 < 8; Lidx0++) {\n    float val0 = (*(data0_128+((lidx0<<3)+Lidx0)));\n    *(buf0+0) = ((*(buf0+0))+val0);\n    *(buf2+0) = ((*(buf2+0))+(val0*val0));\n  }\n  *(buf4+lidx0) = (*(buf0+0));\n  __builtin_amdgcn_fence(__ATOMIC_RELEASE, \"workgroup\");__builtin_amdgcn_s_barrier();__builtin_amdgcn_fence(__ATOMIC_ACQUIRE, \"workgroup\");\n  *(buf5+lidx0) = (*(buf2+0));\n  __builtin_amdgcn_fence(__ATOMIC_RELEASE, \"workgroup\");__builtin_amdgcn_s_barrier();__builtin_amdgcn_fence(__ATOMIC_ACQUIRE, \"workgroup\");\n  *(buf1+0) = 0.0f;\n  *(buf3+0) = 0.0f;\n  for (int Lidx101 = 0; Lidx101 < 16; Lidx101++) {\n    float val1 = (*(buf4+Lidx101));\n    float val2 = (*(buf5+Lidx101));\n    *(buf1+0) = ((*(buf1+0))+val1);\n    *(buf3+0) = ((*(buf3+0))+val2);\n  }\n  bool alu14 = (lidx0==0);\n  if (alu14) {\n    *(data1_1+0) = (*(buf1+0));\n  }\n  if (alu14) {\n    *(data2_1+0) = (*(buf3+0));\n  }\n}"
