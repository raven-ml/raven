24 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) custom_sum_64(float* data0_1, float* data1_64) {\n  int gidx0 = blockIdx.x; /* 64 */\n  float val0 = (*(data1_64+gidx0));\n  *(data0_1+0) = 0.0f;\n  float val1 = (*(data0_1+0));\n  *(data0_1+0) = (val1+val0);\n}"
