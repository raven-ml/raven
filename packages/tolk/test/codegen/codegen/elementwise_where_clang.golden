17 Ops.SOURCE dtypes.void [] "\nstruct relu_args { float* data0_256; float* data1_256; };\n__attribute__((min_vector_width(512))) void relu(const struct relu_args* args) {\n  float* restrict data0_256 = args->data0_256;\n  float* restrict data1_256 = args->data1_256;\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    float val0 = (*(data0_256+Lidx0));\n    float alu0 = ((0.0f<val0)?val0:0.0f);\n    *(data1_256+Lidx0) = alu0;\n  }\n}\n"
