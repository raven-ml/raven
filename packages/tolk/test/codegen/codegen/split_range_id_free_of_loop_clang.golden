48 Ops.SOURCE dtypes.void [] "typedef float float2 __attribute__((aligned(8),ext_vector_type(2)));\n__attribute__((min_vector_width(512))) void E_2_2(float* restrict data0_4, float* restrict data1_4, const int block_lo_, const int block_hi_) {\n  int buf0[1];\n  for (int Lidx0 = 0; Lidx0 < (block_hi_-block_lo_); Lidx0++) {\n    int alu0 = (block_lo_+Lidx0);\n    *(buf0+0) = 0;\n    for (;;) {\n      int alu2 = ((*(buf0+0))+1);\n      *(buf0+0) = alu2;\n      if (!((alu2<3))) { break; }\n    }\n    int alu5 = (alu0<<1);\n    float2 val0 = (*((float2*)((data1_4+alu5))));\n    *((float2*)((data0_4+alu5))) = (val0+((float)((*(buf0+0)))));\n  }\n}\n"
