(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_amd_gfx1100.actual
  stage5_amd_gfx1201.actual
  stage7_amd_gfx1100.actual
  stage7_amd_gfx1201.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_amd_gfx1100.tolk.expected stage5_amd_gfx1100.actual)
   (diff stage5_amd_gfx1201.tolk.expected stage5_amd_gfx1201.actual)
   (diff stage7_amd_gfx1100.tolk.expected stage7_amd_gfx1100.actual)
   (diff stage7_amd_gfx1201.tolk.expected stage7_amd_gfx1201.actual))))
