(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_cuda_sm80.actual
  stage5_cuda_sm90.actual
  stage7_cuda_sm80.actual
  stage7_cuda_sm90.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_cuda_sm80.expected stage5_cuda_sm80.actual)
   (diff stage5_cuda_sm90.expected.diff stage5_cuda_sm90.actual.diff)
   (diff stage7_cuda_sm80.expected stage7_cuda_sm80.actual)
   (diff stage7_cuda_sm90.expected.diff stage7_cuda_sm90.actual.diff))))

(rule
 (package tolk)
 (target stage5_cuda_sm90.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_cuda_sm90.expected} %{dep:stage5_cuda_sm90.actual}))))

(rule
 (package tolk)
 (target stage7_cuda_sm90.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage7_cuda_sm90.expected} %{dep:stage7_cuda_sm90.actual}))))
