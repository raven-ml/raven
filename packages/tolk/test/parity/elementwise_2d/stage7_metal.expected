#include <metal_stdlib>
using namespace metal;
struct args_t { device float* data0_128; device float* data1_128; device float* data2_128; };
kernel void elementwise_2d(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  device float* data0_128 = args.data0_128; device float* data1_128 = args.data1_128; device float* data2_128 = args.data2_128;
  int gidx0 = gid.x; /* 128 */
  float val0 = (*(data0_128+gidx0));
  float val1 = (*(data1_128+gidx0));
  *(data2_128+gidx0) = (val0+val1);
}
