(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_amd_gfx950.actual
  stage7_amd_gfx950.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_amd_gfx950.expected.diff stage5_amd_gfx950.actual.diff)
   (diff stage7_amd_gfx950.expected.diff stage7_amd_gfx950.actual.diff))))

(rule
 (package tolk)
 (target stage5_amd_gfx950.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_amd_gfx950.expected} %{dep:stage5_amd_gfx950.actual}))))

(rule
 (package tolk)
 (target stage7_amd_gfx950.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage7_amd_gfx950.expected} %{dep:stage7_amd_gfx950.actual}))))
