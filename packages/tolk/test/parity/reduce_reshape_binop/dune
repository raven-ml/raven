(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_amd.actual
  stage5_cpu.actual
  stage5_cuda.actual
  stage5_metal.actual
  stage5_opencl.actual
  stage7_amd.actual
  stage7_cpu.actual
  stage7_cuda.actual
  stage7_metal.actual
  stage7_opencl.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_amd.expected.diff stage5_amd.actual.diff)
   (diff stage5_cpu.expected.diff stage5_cpu.actual.diff)
   (diff stage5_cuda.expected.diff stage5_cuda.actual.diff)
   (diff stage5_metal.expected.diff stage5_metal.actual.diff)
   (diff stage5_opencl.expected.diff stage5_opencl.actual.diff)
   (diff stage7_amd.expected.diff stage7_amd.actual.diff)
   (diff stage7_cpu.expected.diff stage7_cpu.actual.diff)
   (diff stage7_cuda.expected.diff stage7_cuda.actual.diff)
   (diff stage7_metal.expected.diff stage7_metal.actual.diff)
   (diff stage7_opencl.expected.diff stage7_opencl.actual.diff))))

(rule
 (package tolk)
 (target stage5_amd.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_amd.expected} %{dep:stage5_amd.actual}))))

(rule
 (package tolk)
 (target stage5_cpu.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_cpu.expected} %{dep:stage5_cpu.actual}))))

