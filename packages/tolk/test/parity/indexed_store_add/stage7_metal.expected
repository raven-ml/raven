#include <metal_stdlib>
using namespace metal;
kernel void indexed_store_add(device float* data0_-1, device int* data1_-1, device float* data2_-1, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  int gidx0 = gid.x; /* 8 */
  for (int Ridx1 = 0; Ridx1 < 5; Ridx1++) {
    int val0 = (*(data1_-1+Ridx1));
    bool alu0 = ((-1<val0)&(val0<16));
    float val1 = (alu0?*(data0_-1+(gidx0+(val0<<3))):0.0f);
    float val2 = (*(data2_-1+(gidx0+(Ridx1<<3))));
    if (alu0) {
      *(data0_-1+(gidx0+(val0<<3))) = (val1+val2);
    }
  }
}
