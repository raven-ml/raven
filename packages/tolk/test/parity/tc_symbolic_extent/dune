(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  eligibility.actual
  stage5_aligned_metal.actual
  stage7_aligned_metal.actual
  stage5_aligned_cuda.actual
  stage7_aligned_cuda.actual)
 (action (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff eligibility.expected eligibility.actual)
   (diff stage5_aligned_metal.expected.diff stage5_aligned_metal.actual.diff)
   (diff stage7_aligned_metal.expected.diff stage7_aligned_metal.actual.diff)
   (diff stage5_aligned_cuda.expected stage5_aligned_cuda.actual)
   (diff stage7_aligned_cuda.expected stage7_aligned_cuda.actual))))

(rule
 (package tolk)
 (target stage5_aligned_metal.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_aligned_metal.expected} %{dep:stage5_aligned_metal.actual}))))

(rule
 (package tolk)
 (target stage7_aligned_metal.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage7_aligned_metal.expected} %{dep:stage7_aligned_metal.actual}))))
