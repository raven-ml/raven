(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_cuda.actual
  stage5_metal.actual
  stage7_cuda.actual
  stage7_metal.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_cuda.expected.diff stage5_cuda.actual.diff)
   (diff stage5_metal.expected stage5_metal.actual)
   (diff stage7_cuda.expected.diff stage7_cuda.actual.diff)
   (diff stage7_metal.expected stage7_metal.actual))))

(rule
 (package tolk)
 (target stage5_cuda.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_cuda.expected} %{dep:stage5_cuda.actual}))))

(rule
 (package tolk)
 (target stage7_cuda.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage7_cuda.expected} %{dep:stage7_cuda.actual}))))
