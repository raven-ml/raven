#include <metal_stdlib>
using namespace metal;
kernel void indexed_store_unique(device float* data0_-1, device int* data1_-1, device float* data2_-1, uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {
  int gidx0 = gid.x; /* 5 */
  int val0 = (*(data1_-1+gidx0));
  int gidx1 = gid.y; /* 8 */
  float val1 = (*(data2_-1+(gidx1+(gidx0<<3))));
  if (((-1<val0)&(val0<16))) {
    *(data0_-1+(gidx1+(val0<<3))) = val1;
  }
}
