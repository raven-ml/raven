(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets stage7_cpu.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (diff stage7_cpu.expected.diff stage7_cpu.actual.diff)))

(rule
 (package tolk)
 (target stage7_cpu.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage7_cpu.expected} %{dep:stage7_cpu.actual}))))
