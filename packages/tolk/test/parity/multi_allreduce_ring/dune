(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_cpu.actual
  stage5_cuda.actual
  stage7_cpu.actual
  stage7_cuda.actual)
 (action
  (setenv
   LATE_ALLREDUCE
   0
   (setenv
    RING
    2
    (run ./main.exe .)))))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_cpu.tolk.expected stage5_cpu.actual)
   (diff stage5_cuda.tolk.expected stage5_cuda.actual)
   (diff stage7_cpu.tolk.expected stage7_cpu.actual)
   (diff stage7_cuda.tolk.expected stage7_cuda.actual))))
