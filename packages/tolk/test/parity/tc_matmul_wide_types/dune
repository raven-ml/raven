(executable
 (name main)
 (libraries tolk tolk.uop tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_metal_bf16.actual
  stage7_metal_bf16.actual
  stage5_cuda_bf16.actual
  stage7_cuda_bf16.actual
  stage5_amd_gfx1100_bf16.actual
  stage7_amd_gfx1100_bf16.actual
  stage5_amd_gfx1201_bf16.actual
  stage7_amd_gfx1201_bf16.actual
  stage5_amd_gfx942_bf16.actual
  stage7_amd_gfx942_bf16.actual
  stage5_amd_gfx950_bf16.actual
  stage7_amd_gfx950_bf16.actual
  stage5_amd_gfx942_e4m3fnuz.actual
  stage7_amd_gfx942_e4m3fnuz.actual
  stage5_amd_gfx942_e5m2fnuz.actual
  stage7_amd_gfx942_e5m2fnuz.actual)
 (action (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_metal_bf16.expected stage5_metal_bf16.actual)
   (diff stage7_metal_bf16.expected stage7_metal_bf16.actual)
   (diff stage5_cuda_bf16.expected.diff stage5_cuda_bf16.actual.diff)
   (diff stage7_cuda_bf16.expected.diff stage7_cuda_bf16.actual.diff)
   (diff stage5_amd_gfx1100_bf16.expected.diff stage5_amd_gfx1100_bf16.actual.diff)
   (diff stage7_amd_gfx1100_bf16.expected.diff stage7_amd_gfx1100_bf16.actual.diff)
   (diff stage5_amd_gfx1201_bf16.expected.diff stage5_amd_gfx1201_bf16.actual.diff)
   (diff stage7_amd_gfx1201_bf16.expected.diff stage7_amd_gfx1201_bf16.actual.diff)
   (diff stage5_amd_gfx942_bf16.expected.diff stage5_amd_gfx942_bf16.actual.diff)
   (diff stage7_amd_gfx942_bf16.expected.diff stage7_amd_gfx942_bf16.actual.diff)
   (diff stage5_amd_gfx950_bf16.expected.diff stage5_amd_gfx950_bf16.actual.diff)
   (diff stage7_amd_gfx950_bf16.expected.diff stage7_amd_gfx950_bf16.actual.diff)
   (diff stage5_amd_gfx942_e4m3fnuz.expected.diff stage5_amd_gfx942_e4m3fnuz.actual.diff)
   (diff stage7_amd_gfx942_e4m3fnuz.expected.diff stage7_amd_gfx942_e4m3fnuz.actual.diff)
   (diff stage5_amd_gfx942_e5m2fnuz.expected.diff stage5_amd_gfx942_e5m2fnuz.actual.diff)
   (diff stage7_amd_gfx942_e5m2fnuz.expected.diff stage7_amd_gfx942_e5m2fnuz.actual.diff))))

(rule
 (package tolk)
 (target stage5_amd_gfx1100_bf16.actual.diff)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../expected_diff.py}
    %{dep:stage5_amd_gfx1100_bf16.expected} %{dep:stage5_amd_gfx1100_bf16.actual}))))

