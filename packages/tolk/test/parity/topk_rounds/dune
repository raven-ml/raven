(executable
 (name main)
 (libraries tolk tolk.uop tolk.frontend tolk_parity_helpers))

(rule
 (package tolk)
 (targets
  stage5_cpu.actual
  stage5_metal.actual
  stage7_cpu.actual
  stage7_metal.actual)
 (action
  (run ./main.exe .)))

(rule
 (alias runtest)
 (package tolk)
 (action
  (progn
   (diff stage5_cpu.tolk.expected stage5_cpu.actual)
   (diff stage5_metal.tolk.expected stage5_metal.actual)
   (diff stage7_cpu.tolk.expected stage7_cpu.actual)
   (diff stage7_metal.tolk.expected stage7_metal.actual))))
