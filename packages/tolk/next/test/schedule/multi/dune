(test
 (name test_multi)
 (modules test_multi)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test)
 (deps
  (glob_files *.golden))
 (action
  (run %{test} --exclude-tag slow)))

; LATE_ALLREDUCE is read when the library is initialised, so the rules it
; enables run in a process of their own.

(test
 (name test_multi_early)
 (modules test_multi_early)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test)
 (deps
  (glob_files *.golden))
 (action
  (setenv
   LATE_ALLREDUCE
   0
   (run %{test} --exclude-tag slow))))
