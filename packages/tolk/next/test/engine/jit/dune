; CACHEDB is a directory of the sandbox, as Clang's compiler is made with its
; cache.

(test
 (name test_jit)
 (modules test_jit)
 (package tolk)
 (libraries
  windtrap
  tolk.next
  tolk.next.engine
  tolk_next_test
  tolk_next_run
  nx.device
  zarith)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test} --exclude-tag slow))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_jit.exe} --tag slow))))

; JITBEAM is read once per process, so each of its settings is a run of its
; own.

(test
 (name test_jitbeam)
 (modules test_jitbeam)
 (package tolk)
 (libraries windtrap tolk.next tolk.next.engine tolk_next_run)
 (deps
  (sandbox always))
 (action
  (setenv
   CACHEDB
   cache
   (progn
    (run %{test} -f "JITBEAM unset")
    (setenv
     JITBEAM
     3
     (run %{test} -f "JITBEAM=3"))
    (setenv
     JITBEAM
     0
     (run %{test} -f "JITBEAM=0"))))))
