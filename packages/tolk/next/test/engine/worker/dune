(test
 (name test_worker)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test tolk_next_run tolk.next.engine nx.device unix zarith)
 (deps
  (sandbox always)
  ../../runtime/support/compiler_cpu/kernels.golden)
 (action
  (setenv
   CACHEDB
   cache
   (run %{test} --exclude-tag slow))))
