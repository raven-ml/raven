; MV and MV_* are read once per process, so the cases under them run in
; processes of their own, with the variables set.

(test
 (name test_heuristic)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test)
 (deps
  (glob_files *.golden))
 (action
  (progn
   (run
    %{test}
    --exclude-tag
    slow
    --exclude-tag
    mv_0
    --exclude-tag
    mv_block_rows_1
    --exclude-tag
    mv_sizes_1)
   (setenv
    MV
    0
    (run %{test} --tag mv_0))
   (setenv
    MV_BLOCKSIZE
    1
    (setenv
     MV_ROWS_PER_THREAD
     1
     (run %{test} --tag mv_block_rows_1)))
   (setenv
    MV_BLOCKSIZE
    1
    (setenv
     MV_THREADS_PER_ROW
     1
     (setenv
      MV_ROWS_PER_THREAD
      1
      (run %{test} --tag mv_sizes_1)))))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_heuristic.exe} --tag slow)))
