17 Ops.SOURCE dtypes.void [] "typedef float float2 __attribute__((ext_vector_type(2)));\nstatic inline __attribute__((device)) float2 make_float2(float x, float y) { return { x, y }; }\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) E_2(float* data0_2, float* data1_1, float* data2_1) {\n  float val0 = (*(data1_1+0));\n  float val1 = (*(data2_1+0));\n  *((float2*)((data0_2+0))) = make_float2(val1,val0);\n}"
