49 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((ext_vector_type(4)));\nstatic inline __attribute__((device)) float4 make_float4(float x, float y, float z, float w) { return { x, y, z, w }; }\nextern \"C\" __attribute__((global)) void __attribute__((amdgpu_flat_work_group_size(1, 1))) matmul_small(float* data0_16, float* data1_16, float* data2_16) {\n  for (int Lidx0 = 0; Lidx0 < 4; Lidx0++) {\n    int alu0 = (Lidx0<<2);\n    float4 val0 = (*((float4*)((data0_16+alu0))));\n    for (int Lidx1 = 0; Lidx1 < 4; Lidx1++) {\n      float val1 = (*(data1_16+(Lidx1+12)));\n      float val2 = (*(data1_16+(Lidx1+4)));\n      float val3 = (*(data1_16+(Lidx1+8)));\n      float val4 = (*(data1_16+Lidx1));\n      *(data2_16+(alu0+Lidx1)) = __builtin_fmaf(val0.w,val1,__builtin_fmaf(val0.z,val3,__builtin_fmaf(val0.y,val2,(val0.x*val4))));\n    }\n  }\n}"
