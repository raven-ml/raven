25 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_16; };\nkernel void custom_arange_16(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_16 = args.data0_16;\n  int lidx0 = lid.x; /* 4 */\n  int alu0 = (lidx0<<2);\n  *((device float4*)((data0_16+alu0))) = float4(((float)(alu0)),((float)((alu0+1))),((float)((alu0+2))),((float)((alu0+3))));\n}"
