34 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_64; };\nkernel void custom_eye_64(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_64 = args.data0_64;\n  int lidx0 = lid.x; /* 8 */\n  int lidx1 = lid.y; /* 2 */\n  int alu0 = (lidx1<<2);\n  *((device float4*)((data0_64+((lidx0<<3)+alu0)))) = float4(((float)((lidx0==alu0))),((float)((lidx0==(alu0+1)))),((float)((lidx0==(alu0+2)))),((float)((lidx0==(alu0+3)))));\n}"
