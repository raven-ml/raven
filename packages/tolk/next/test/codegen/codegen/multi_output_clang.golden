36 Ops.SOURCE dtypes.void [] "typedef float float4 __attribute__((aligned(16),ext_vector_type(4)));\nvoid E_256_4(float* restrict data0_1024, float* restrict data1_1024) {\n  for (int Lidx0 = 0; Lidx0 < 256; Lidx0++) {\n    int alu0 = (Lidx0<<2);\n    float4 val0 = (*((float4*)((data1_1024+alu0))));\n    *((float4*)((data0_1024+alu0))) = (float4){(val0[0]*2.0f),(val0[1]*2.0f),(val0[2]*2.0f),(val0[3]*2.0f)};\n  }\n}\n"
