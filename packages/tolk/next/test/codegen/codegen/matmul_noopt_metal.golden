55 Ops.SOURCE dtypes.void [] "#include <metal_stdlib>\nusing namespace metal;\nstruct args_t { device float* data0_256; device float* data1_256; device float* data2_256; };\nkernel void r_16_16_16(constant args_t& args [[buffer(0)]], uint3 gid [[threadgroup_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]]) {\n  device float* data0_256 = args.data0_256; device float* data1_256 = args.data1_256; device float* data2_256 = args.data2_256;\n  float buf0[1];\n  int gidx0 = gid.x; /* 16 */\n  int gidx1 = gid.y; /* 16 */\n  int alu0 = (gidx1<<4);\n  *(buf0+0) = 0.0f;\n  for (int Ridx0 = 0; Ridx0 < 16; Ridx0++) {\n    float val0 = (*(data1_256+(alu0+Ridx0)));\n    float val1 = (*(data2_256+(gidx0+(Ridx0<<4))));\n    *(buf0+0) = ((*(buf0+0))+(val0*val1));\n  }\n  *(data0_256+(gidx0+alu0)) = (*(buf0+0));\n}"
