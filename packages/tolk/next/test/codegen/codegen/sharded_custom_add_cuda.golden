40 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(32) custom_add_kernel_128(float* data0_128, float* data1_128, float* data2_128) {\n  int lidx0 = threadIdx.x; /* 32 */\n  int alu0 = (lidx0<<2);\n  float4 val0 = (*((float4*)((data1_128+alu0))));\n  float4 val1 = (*((float4*)((data2_128+alu0))));\n  *((float4*)((data0_128+alu0))) = make_float4((val0.x+val1.x),(val0.y+val1.y),(val0.z+val1.z),(val0.w+val1.w));\n}"
