61 Ops.SOURCE dtypes.void [] "\nvoid r_16_16_16(float* restrict data0_256, float* restrict data1_256, float* restrict data2_256) {\n  float buf0[1];\n  for (int Lidx1 = 0; Lidx1 < 16; Lidx1++) {\n    int alu0 = (Lidx1<<4);\n    for (int Lidx2 = 0; Lidx2 < 16; Lidx2++) {\n      *(buf0+0) = 0.0f;\n      for (int Ridx0 = 0; Ridx0 < 16; Ridx0++) {\n        float val0 = (*(data1_256+(alu0+Ridx0)));\n        float val1 = (*(data2_256+((Ridx0<<4)+Lidx2)));\n        *(buf0+0) = ((*(buf0+0))+(val0*val1));\n      }\n      *(data0_256+(alu0+Lidx2)) = (*(buf0+0));\n    }\n  }\n}\n"
