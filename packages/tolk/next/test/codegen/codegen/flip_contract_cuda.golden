29 Ops.SOURCE dtypes.void [] "typedef unsigned int uint;\n#define INFINITY (__int_as_float(0x7f800000))\n#define NAN (__int_as_float(0x7fffffff))\ntemplate <class T, class F> __device__ __forceinline__ T tg_bitcast(F v) { union U { F f; T t; }; U u; u.f = v; return u.t; }\nextern \"C\" __global__ void __launch_bounds__(1) flip_contract_32(float* data0_32, float* data1_32) {\n  int gidx0 = blockIdx.x; /* 8 */\n  int alu0 = (gidx0<<2);\n  float4 val0 = (*((float4*)((data1_32+alu0))));\n  *((float4*)((data0_32+alu0))) = make_float4(val0.w,val0.z,val0.y,val0.x);\n}"
