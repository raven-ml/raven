; Settings are read once per process, so the cases rendered under EXPAND_SSA or
; ALIGNED run in processes of their own, each with its variable set. Metal
; exists on macOS alone.

(test
 (name test_cstyle)
 (package tolk)
 (libraries
  windtrap
  tolk.next
  tolk_next_test
  tolk_next_run
  tolk.next.engine
  nx.device
  (select
   metal.ml
   from
   (nx.metal.device -> metal.macos.ml)
   (-> metal.other.ml)))
 (deps
  (glob_files *.golden))
 (action
  (progn
   (run
    %{test}
    --exclude-tag
    slow
    --exclude-tag
    expand-ssa
    --exclude-tag
    unaligned)
   (setenv
    EXPAND_SSA
    1
    (run %{test} --tag expand-ssa))
   (setenv
    ALIGNED
    0
    (run %{test} --tag unaligned)))))

(rule
 (alias slow)
 (package tolk)
 (deps
  (glob_files *.golden))
 (action
  (run %{exe:test_cstyle.exe} --tag slow)))
