(test
 (name test_ops_nv)
 (modules test_ops_nv)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test zarith)
 (deps
  (glob_files *.golden))
 (action
  (run %{test} --exclude-tag slow)))

; Running batches on the GPU needs an NVIDIA GPU, and is slow: without one, each
; test skips.

(executable
 (name test_ops_nv_exec)
 (modules test_ops_nv_exec)
 (libraries windtrap tolk.next tolk.next.engine nx.device nx.nv.device))

(rule
 (alias slow)
 (package tolk)
 (deps
  (sandbox always))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_ops_nv_exec.exe} --tag slow))))
