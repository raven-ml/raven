; Settings are read when the program starts, so CACHEDB is set here, to a
; directory of the sandbox: the suite clears the cache it writes to.

(test
 (name test_helpers)
 (package tolk)
 (libraries windtrap tolk.next tolk_next_test unix)
 (deps
  (sandbox always)
  (glob_files *.golden))
 (action
  (setenv
   CACHEDB
   cache
   (run %{test} --exclude-tag slow))))
