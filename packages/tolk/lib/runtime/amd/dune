(include_subdirs unqualified)

(library
 (name tolk_amd)
 (public_name tolk.amd)
 (libraries tolk tolk_uop tolk_hcq tolk_cpu unix)
 (foreign_stubs
  (language c)
  (names tolk_amd_stubs tolk_amd_comgr_stubs)
  (include_dirs ../support))
 ; The stubs dlopen the ROCm code-object manager. pthread needs no flag
 ; of its own: the OCaml runtime already links it for its domain support.
 (c_library_flags
  (:include dl_flags.sexp)))

; dlopen lives in libSystem on macOS, where an explicit -ldl only makes the
; linker report a duplicate library, and Windows loads through kernel32;
; elsewhere it is its own library.

(rule
 (target dl_flags.sexp)
 (enabled_if
  (or
   (= %{system} macosx)
   (= %{system} mingw64)
   (= %{system} win64)))
 (action
  (with-stdout-to
   dl_flags.sexp
   (echo "()"))))

(rule
 (target dl_flags.sexp)
 (enabled_if
  (not
   (or
    (= %{system} macosx)
    (= %{system} mingw64)
    (= %{system} win64))))
 (action
  (with-stdout-to
   dl_flags.sexp
   (echo "(-ldl)"))))
