; The engine runs the compiler's schedules on nx.device: the only part of tolk
; that opens a device.

(library
 (name tolk_engine)
 (public_name tolk.engine)
 (libraries
  tolk
  nx.device
  nx.dtype
  nx.cuda.device
  nx.amd.device
  nx.nv.device
  nx.metal.device)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))
