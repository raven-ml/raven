; The engine runs the compiler's schedules on rig: the only part of tolk that
; opens nothing, and loads and runs programs on the devices callers pass.

(library
 (name tolk_engine)
 (public_name tolk.engine)
 (libraries
  tolk
  rig
  rig.program
  rig.metal.abi
  rig.cuda.abi
  rig.amd.abi
  rig.nv.abi)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

; The digest of the engine's sources: what is kept of a compiled schedule
; is what this code reads of one.

(rule
 (target engine_digest.ml)
 (deps
  (sandbox always)
  (source_tree .))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../tools/source_digest.exe} .))))
