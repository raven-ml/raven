; gpt-oss's model is examples/06-gpt-oss's: kaun ships no model.

(copy_files#
 (files ../../examples/06-gpt-oss/{moe,gpt_oss,layer_loop}.{ml,mli}))

(executable
 (name bench_decode)
 (modules bench_decode moe gpt_oss layer_loop metal)
 (libraries
  nx
  nx.cuda
  nx.amd
  nx.metal
  nx.device
  nx.io
  nx.quant
  rune
  kaun
  kaun.hf
  jsont
  thumper
  unix
  (select
   metal.ml
   from
   (nx.metal.device -> metal.macos.ml)
   (-> metal.other.ml))))

; Not attached to runtest on purpose: run with `dune build @bench`.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (action
  (progn
   (run %{exe:bench_decode.exe})
   (diff? kaun_decode.thumper kaun_decode.thumper.corrected))))
