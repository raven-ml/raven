(executable
 (name bench_decode)
 (libraries
  nx
  nx.cuda
  nx.amd
  nx.metal
  nx.metal.device
  nx.device
  nx.quant
  rune
  kaun
  thumper
  unix))

; Not attached to runtest on purpose: run with `dune build @bench`. [--warm]
; compiles every case into tolk's disk cache first, in a process of its own, so
; the measurement compiles nothing.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_decode.exe} --warm)
   (run %{exe:bench_decode.exe}))))
