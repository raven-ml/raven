; gpt-oss-20b's decode step and prefill, for focused work on the model's
; performance; the regular suites guard its kernels (kaun's bench/decode).

(executable
 (name bench_gpt_oss)
 (modules bench_gpt_oss)
 (libraries
  gpt_oss
  nx
  rig
  rig.cuda
  rig.amd.amdgpu
  nx.io
  nx.quant
  rune
  kaun
  kaun.hf
  jsont
  thumper
  unix))

; [--warm] compiles the kernels into tolk's disk cache first, in a process of
; its own, so the measurement compiles nothing.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_gpt_oss.exe} --warm)
   (run %{exe:bench_gpt_oss.exe}))))
