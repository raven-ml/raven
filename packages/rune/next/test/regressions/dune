; Every test of old rune (packages/rune/test) has a row in the regressions
; ledger: a rune.next test or a named drop. Each windtrap suite lists its tests
; with -l; test_read_lifetime, a plain executable, and exhaustive.t are one
; test each. test_jit_metal builds on macOS only: elsewhere it is one test too.

(executable
 (name check_regressions)
 (modules check_regressions))

(rule
 (with-stdout-to
  test_grad.ml.list
  (setenv
   DEV
   CPU
   (run %{exe:../../../test/test_grad.exe} -l))))

(rule
 (with-stdout-to
  test_ops.ml.list
  (setenv
   DEV
   CPU
   (run %{exe:../../../test/test_ops.exe} -l))))

