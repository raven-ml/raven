(rule
 (enabled_if
  (= %{system} macosx))
 (action
  (with-stdout-to
   test_jit_metal.ml.list
   (setenv
    DEV
    CPU
    (run %{exe:../../../test/test_jit_metal.exe} -l)))))

(rule
 (enabled_if
  (<> %{system} macosx))
 (action
  (with-stdout-to
   test_jit_metal.ml.list
   (echo "*\n"))))

(rule
 (with-stdout-to
  test_read_lifetime.ml.list
  (echo "*\n")))

(rule
 (with-stdout-to
  exhaustive.t.list
  (echo "*\n")))

(rule
 (alias runtest)
 (package rune)
 (deps
  (glob_files *.list))
 (action
  (run %{exe:check_regressions.exe} %{dep:../../../REGRESSIONS.md} %{deps})))
