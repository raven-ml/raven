; The compiled backend, and the rules under the compiled call, run on the host
; by default, their programs from the compile cache; their Metal, CUDA and NV
; tests, the rules' rows and the backend's cost figures are slow. The slow alias
; sets CACHEDB to a directory of the sandbox, so that it compiles every program:
; it is the check of compilation from a cold cache.

(tests
 (names test_compiled test_compiled_rules)
 (modules test_compiled test_compiled_rules)
 (package rune)
 (libraries
  windtrap
  rune.next
  rune_next_test
  rune_next_rules
  nx_test
  nx
  nx.array
  nx.backend
  nx.cpu
  nx.device
  nx.dtype
  tolk.next)
 (action
  (run %{test} --exclude-tag slow)))

(rule
 (alias slow)
 (package rune)
 (deps
  (sandbox always))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_compiled.exe} --tag slow))))

(rule
 (alias slow)
 (package rune)
 (deps
  (sandbox always))
 (action
  (setenv
   CACHEDB
   cache
   (run %{exe:test_compiled_rules.exe} --tag slow))))

