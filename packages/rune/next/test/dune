; Each suite's default run excludes its slow tests; the slow alias runs them.

(tests
 (names
  test_derivatives
  test_scan
  test_structure
  test_nesting
  test_composition
  test_constructs
  test_custom
  test_total)
 (modules
  test_derivatives
  test_scan
  test_structure
  test_nesting
  test_composition
  test_constructs
  test_custom
  test_total)
 (package rune)
 (libraries windtrap rune.next rune_next_test nx nx.dtype)
 (action
  (run %{test} --exclude-tag slow)))

(rule
 (alias slow)
 (package rune)
 (action
  (run %{exe:test_composition.exe} --tag slow)))

