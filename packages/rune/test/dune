; The linear algebra suite runs as six shards, which dune runs in parallel.

(executable
 (name test_lower_linalg)
 (modules test_lower_linalg)
 (libraries
  windtrap
  rune_internals
  rune_lowering_test
  tolk_test
  nx_test
  nx
  nx.dtype
  nx.device
  tolk))

(rule
 (alias runtest)
 (package rune)
 (deps
  (glob_files golden/lower_linalg/*.golden))
 (action
  (run %{exe:test_lower_linalg.exe} --shard 1/6)))

