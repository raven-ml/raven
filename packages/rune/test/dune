; Each suite's default run excludes its slow tests; the slow alias runs them.

(tests
 (names
  test_derivatives
  test_laws
  test_structure
  test_nesting
  test_composition
  test_constructs
  test_custom
  test_total
  test_allocation)
 (modules
  test_derivatives
  test_laws
  test_structure
  test_nesting
  test_composition
  test_constructs
  test_custom
  test_total
  test_allocation)
 (package rune)
 (libraries windtrap rune rune_test nx nx.dtype nx.ragged)
 (action
  (run %{test} --exclude-tag slow)))

(test
 (name test_scan)
 (modules test_scan)
 (package rune)
 (libraries windtrap rune_internals rune_test nx nx.dtype)
