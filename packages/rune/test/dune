 (name test_jit)
 (modules test_jit)
 (libraries
  windtrap
  rune
  rune_test
  nx_test
  nx
  nx.array
  nx.backend
  nx.cpu
  nx.device
  nx.dtype
  nx.ragged
  nx.metal
  nx.cuda
  nx.nv
  nx.amd
  tolk))

(rule
 (alias runtest)
 (package rune)
 (action
  (run %{exe:test_jit.exe} --shard 1/8)))

(rule
 (alias runtest)
 (package rune)
 (action
  (run %{exe:test_jit.exe} --shard 2/8)))

(rule
 (alias runtest)
 (package rune)
 (action
  (run %{exe:test_jit.exe} --shard 3/8)))

(rule
 (alias runtest)
 (package rune)
 (action
  (run %{exe:test_jit.exe} --shard 4/8)))

