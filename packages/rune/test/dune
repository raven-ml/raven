; Alone in its executable: the compiled programs of a process share the
; memory planner's arenas, which only grow. It runs on the CPU device and, on
; macOS, on Metal.

(tests
 (names test_remat_memory)
 (modules test_remat_memory)
 (package rune)
 (libraries rune nx tolk windtrap))

(rule
 (alias runtest)
 (package rune)
 (enabled_if
  (= %{system} macosx))
 (action
  (setenv
   DEV
   METAL
   (run %{dep:test_remat_memory.exe}))))

; A plain executable: whether a temporary is dead at the copy it checks
; depends on how its caller is compiled.

(test
 (name test_read_lifetime)
 (modules test_read_lifetime)
 (package rune)
 (action
  (setenv
   DEV
   CPU
   (run %{test})))
 (libraries rune nx nx.buffer nx.dtype unix))

