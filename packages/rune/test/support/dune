 (name rune_lowering_test)
 (wrapped false)
 (modules programs traces)
 (libraries
  windtrap
  rune_internals
  tolk
  tolk_test
  tolk_run
  tolk.engine
  nx
  nx.array
  nx.device
  nx.dtype))

