; rune's bench suite. Not attached to runtest: run it with `dune build
; @bench`, or run the built exe from its directory under _build/default.

(executable
 (name bench_rune2)
 (libraries nx rune thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_rune2.exe})))
