(executable
 (name bench_rune)
 (libraries nx rune thumper unix))

; Not attached to runtest on purpose: run with `dune build @bench`
; (or run the built exe directly; `list` prints case ids). [--warm] fills
; tolk's disk cache with what the cases compile, so the measurement compiles
; nothing.

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend
 ; for cores and distort measurements.
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_rune.exe} --warm)
   (run %{exe:bench_rune.exe}))))
