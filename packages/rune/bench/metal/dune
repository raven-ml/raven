; rune's compiled calls on the Mac's GPU. Not attached to runtest: run it
; with `dune build @bench`, or run the built exe from its directory under
; _build/default. [--warm] compiles every case first, in a process of its
; own, into tolk's disk cache and Metal's cache of the pipelines it builds: a
; worker forked to measure a case cannot reach Metal's compiler.

(executable
 (name bench_metal)
 (libraries nx rig rig.metal rune thumper unix))

(rule
 (alias bench)
 (locks %{workspace_root}/bench %{workspace_root}/gpu)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_metal.exe} --warm)
   (run %{exe:bench_metal.exe}))))
