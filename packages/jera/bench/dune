(executable
 (name bench_jera)
 (libraries jera rune nx nx.device thumper unix))

; Not attached to runtest on purpose: run with `dune build @bench`, or run the
; built exe directly. [--warm] fills tolk's disk cache with what the cases
; compile, so the compiled rows compile nothing while measured; the cold rows
; compile in a fresh process with the cache off.

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend for
 ; cores and distort measurements.
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_jera.exe} --warm)
   (run %{exe:bench_jera.exe}))))
