; ConnectX NICs of this machine, opened through Linux's RDMA subsystem and
; driven once open: regions, completion queues and queue pairs.

; The record below the interface's stop comment, (**/**), has fields whose
; types are hidden there too, and odoc 3 warns for it although the record is
; hidden as well. Its warnings are not errors here; see the root dune.
(env
 (_
  (odoc
   (warnings nonfatal))))

(library
 (name rig_mlx5)
 (public_name rig.mlx5)
 (libraries rig_edge rig_edge_primitive rig_mlx5_abi unix)
 (modules_without_implementation path)
 (private_modules defs path uverbs)
 (foreign_stubs
  (language c)
  (names rig_mlx5_stubs rig_mlx5_uverbs_stubs)))
