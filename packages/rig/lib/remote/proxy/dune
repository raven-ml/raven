(library
 (name rig_remote_proxy)
 (public_name rig.remote.proxy)
 (libraries rig_remote_abi rig_edge rig_edge_primitive unix)
 (foreign_stubs
  (language c)
  (names rig_remote_wire rig_remote_link rig_remote_proxy rig_remote_probe)
  (flags
   (:standard -DRIG_REMOTE_PROXY_EXTERN=extern)))
 (c_library_flags
  (:include socket_flags.sexp)))

; On Windows the stubs call Winsock, which their DLL links itself, as the unix
; library's does: flexdll resolves at load only what the executable and the
; DLLs loaded before export, and none exports Winsock.

(rule
 (target socket_flags.sexp)
 (enabled_if
  (= %{os_type} Win32))
 (action
  (write-file %{target} "(-lws2_32)")))

(rule
 (target socket_flags.sexp)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (write-file %{target} "()")))
