; Devices, their memory, and the order of work across them.

(library
 (name rig)
 (public_name rig)
 (libraries rig_edge rig_elf rig_pool)
 (modules_without_implementation def)
 (private_modules
  buffer
  claim
  copy
  def
  dev
  host_code
  image
  lock
  memory
  memory_device
  point
  profile
  submission
  tbl)
 (install_c_headers rig)
 (foreign_stubs
  (language c)
  (names
   rig_device
   rig_stamps
   rig_heap
   rig_host_code
   rig_memory)))

; On ELF, a compiler of PIC code takes an exported function for one another
; library may interpose, so it calls the symbol where it would inline the
; function. Nothing interposes the functions of rig or of its drivers, whose C
; calls its own exported functions too, so the C of every library under lib/
; compiles without semantic interposition. Mach-O interposes nothing within an
; image, and Apple's clang refuses the flag as unused.

(env
 (_
  (c_flags
   (:standard
    (:include interposition_flags.sexp)))))

(rule
 (target interposition_flags.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

(rule
 (target interposition_flags.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "(-fno-semantic-interposition)"))))
