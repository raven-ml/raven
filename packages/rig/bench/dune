; Benches run with `dune build @bench`, never in runtest, each under the lock
; %{workspace_root}/bench. A suite or bench that acts on a GPU also takes
; %{workspace_root}/gpu, so one build runs one at a time. A bench's C that
; calls a library's C sits in a library: GNU ld resolves it only from an
; archive listed after the caller.

(library
 (name rig_bench)
 (modules)
 (libraries rig rig_edge)
 (foreign_stubs
  (language c)
  (names rig_bench_stubs)))

(executable
 (name bench_rig)
 (modules bench_rig)
 (libraries rig rig_bench rig_support thumper))

(executable
 (name bench_profile)
 (modules bench_profile)
 (libraries rig thumper))

; The GPU rows link every GPU driver, which makes each full collection longer:
; they run in an executable of their own, beside the host rows' lean one.

(executable
 (name bench_gpu)
 (modules bench_gpu)
 (libraries
  rig
  rig_edge
  rig_bench
  rig_gpu_support
  rig_metal
  rig_cuda
  rig_amd
  rig_amd_amdgpu
  rig_nv
  rig_nv_nvidia
  rig_metal_support
  rig_cuda_support
  rig_nv_support
  rig_amd_support
  rig_disk
  thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench %{workspace_root}/gpu)
 (deps
  (glob_files *.thumper)
  (source_tree ../test/metal/fixtures)
  (source_tree ../test/cuda/fixtures)
  (source_tree ../test/nv/fixtures)
  (source_tree ../test/amd/fixtures))
 (action
  (progn
   (run %{exe:bench_rig.exe})
   (run %{exe:bench_profile.exe})
   (run %{exe:bench_gpu.exe}))))
