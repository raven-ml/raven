(executable
 (name main)
 (libraries rig rig.gpus))

; The program uses the first GPU here, so it takes the GPU suites' lock.

(rule
 (alias runtest)
 (deps
  (glob_files kernels/add*))
 (locks %{workspace_root}/gpu)
 (action
  (progn
   (with-stdout-to
    main.output
    (run ./main.exe))
   (diff? main.expected main.output))))
