 (modules test_interrupt)
 (locks %{workspace_root}/gpu)
 (libraries
  rig_amd
  rig_amd_amdgpu
  rig_amd_support
  rig_edge
  rig_gpu_support
  rig_support
  windtrap)
 (deps abi/fixtures/many_gfx1201.hsaco))
