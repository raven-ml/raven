(tests
 (names
  test_open
  test_buffer
  test_submit
  test_launch
  test_args
  test_loss
  test_turn
  test_commit
  test_fork
  test_fail
  test_keep
  test_stamps
  test_memory
  test_claim
  test_image
  test_io
  test_walk
  test_interrupt
  test_point
  test_local
  test_limit
  test_reuse
  test_copy_parts
  test_copy)
 (modules :standard \ test_profile test_readers test_model test_model_fork
  rig_model)
 (libraries rig rig_edge rig_support rig_gpu_support threads.posix unix
  windtrap)
 ; The C library scribbles over the memory it frees (MallocScribble on macOS,
 ; MALLOC_PERTURB_ on glibc), so a read of freed memory, such as a walk of
 ; freed stamps, reads garbage and fails its test.
 (action
  (setenv
   MallocScribble
   1
   (setenv
    MALLOC_PERTURB_
    85
    (run %{test})))))

(test
 (name test_profile)
 (modules test_profile)
 (libraries rig rig_support windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_profile.ml test_profile.ml.corrected))))

(executable
 (name test_readers)
 (modules test_readers)
 (modes native byte)
 (libraries rig rig_support windtrap))

(rule
 (alias runtest)
 (action
  (run %{dep:test_readers.exe})))

; The bytecode run checks that rig's stubs resolve when ocamlrun loads them
; from CAML_LD_LIBRARY_PATH.

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{profile} sanitize)
   (<> %{profile} tsan)))
 (deps
  ../lib/dllrig_stubs.so
  ../lib/pool/dllrig_pool_stubs.so
  support/dllrig_support_stubs.so)
 (action
  (setenv
   CAML_LD_LIBRARY_PATH
   "../lib:../lib/edge:../lib/pool:support:%{lib:windtrap:../stublibs}"
   (run %{dep:test_readers.bc}))))

(tests
 (names test_model test_model_fork)
 (modules test_model test_model_fork rig_model)
 (locks %{workspace_root}/gpu)
 (libraries
  rig
  rig_support
  rig_disk
  rig_metal
  rig_metal_support
  rig_cuda
  rig_cuda_support
  rig_nv
  rig_nv_nvidia
  rig_nv_support
  rig_amd
  rig_amd_amdgpu
  rig_amd_support
  threads.posix
  unix
  windtrap))
