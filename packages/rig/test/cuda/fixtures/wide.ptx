// The conformance suite's wide and the CUDA suite's widest, apart from
// launch.ptx since PTX 8.1 for sm_70 is the first to take more than 4,096
// bytes of parameters: a GPU or a driver below that loads launch.ptx still.

.version 8.1
.target sm_70
.address_size 64

// Stores the 32-bit words at bytes 4,096 and 8,188 of its 8,192 bytes of
// parameters into words 0 and 1 at out, its first 8.
.visible .entry wide(.param .u64 out, .param .align 4 .b8 w[8184])
{
  .reg .u32 %r<3>;
  .reg .u64 %rd<2>;
  ld.param.u64 %rd1, [out];
  ld.param.u32 %r1, [w+4088];
  ld.param.u32 %r2, [w+8180];
  st.u32 [%rd1], %r1;
  st.u32 [%rd1+4], %r2;
  ret;
}

// Stores the 32-bit words at bytes 8, 16,384 and 32,760 of its 32,764 bytes
// of parameters, the most PTX 8.1 takes, into words 0 to 2 at out, its
// first 8.
.visible .entry widest(.param .u64 out, .param .align 4 .b8 w[32756])
{
  .reg .u32 %r<4>;
  .reg .u64 %rd<2>;
  ld.param.u64 %rd1, [out];
  ld.param.u32 %r1, [w];
  ld.param.u32 %r2, [w+16376];
  ld.param.u32 %r3, [w+32752];
  st.u32 [%rd1], %r1;
  st.u32 [%rd1+4], %r2;
  st.u32 [%rd1+8], %r3;
  ret;
}
