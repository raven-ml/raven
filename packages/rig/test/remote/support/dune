; The agent for the suites, a library so that a suite of any package builds
; its own program of it: dune-project gives each package a directory, and a
; build of one package drops the programs of the others' directories.

(library
 (name rig_agent)
 (modules rig_agent)
 (libraries
  rig
  rig_disk
  rig_metal
  rig_remote
  rig_remote_proxy
  rig_support
  threads.posix
  unix))

(executable
 (name agent)
 (modules agent)
 (libraries rig_agent))

(executables
 (names controller launched)
 (modules controller launched)
 (libraries rig rig_remote rig_support unix))

(executable
 (name two)
 (modules two)
 (libraries
  rig
  rig.program
  rig.remote
  rig.remote.abi
  rig.amd.abi
  rig.amd.amdgpu
  rig.nv.abi
  rig.nv.nvidia
  rig_amd_support
  rig_nv_support
  rig_cuda_support))
