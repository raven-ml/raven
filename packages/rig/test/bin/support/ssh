# ssh for the tests, first on PATH. It plays every machine on this one:
# machine M is the directory machines/M of the current directory.
#
# [ssh -G M] prints M's configuration as ssh does, its hostname alone: the
# contents of machines/M/hostname if it exists, else M, as an alias does
# and as no alias does. While machines/M/unconfigured exists, it fails as
# ssh does on a configuration it cannot read.
#
# [ssh [OPTION...] M COMMAND...] runs COMMAND here as sshd runs it, in
# the login shell, /bin/sh, with HOME and TMPDIR machines/M, so each machine
# has its own profile and agent lock. A machine's ~/.profile, unless a
# test writes one, puts machines/M/bin and then this PATH first on its
# PATH. While machines/M/down exists, M does not answer, as ssh says when a
# machine is off. machines/M/pid holds the process that plays M's end of
# the session: killing it loses the session.

config=no
while [ $# -gt 0 ]; do
  case $1 in
  -G) config=yes && shift ;;
  -o) shift 2 ;;
  -*) shift ;;
  *) break ;;
  esac
done

m=$1
shift
dir=$PWD/machines/$m

if [ $config = yes ]; then
  if [ -e "$dir/unconfigured" ]; then
    echo "/etc/ssh/ssh_config: line 1: Bad configuration option: $m" >&2
    echo "/etc/ssh/ssh_config: terminating, 1 bad configuration options" >&2
    exit 255
  fi
  if [ -e "$dir/hostname" ]; then
    echo "hostname $(cat "$dir/hostname")"
  else
    echo "hostname $m"
  fi
  exit 0
fi

if [ -e "$dir/down" ]; then
  echo "ssh: connect to host $m port 22: Connection refused" >&2
  exit 255
fi

mkdir -p "$dir"
echo $$ >"$dir/pid"
[ -e "$dir/.profile" ] || echo "PATH='$dir/bin:$PATH'" >"$dir/.profile"
SHELL=/bin/sh HOME=$dir TMPDIR=$dir exec /bin/sh -c "$*"
