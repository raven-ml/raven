# [await FILE WORD] returns once a line of FILE starts with WORD. After 60 s
# it fails, printing FILE: a hang guard above every bound of rig run (10 s
# of silence, 15 s for a failed job's processes to end, twice that to end
# them), never a bound on the code's time.

i=0
while ! grep -q "^$2" "$1" 2>/dev/null; do
  i=$((i + 1))
  if [ $i -gt 600 ]; then
    echo "await: no line starting with '$2' in $1 after 60 s:" >&2
    cat "$1" >&2
    exit 1
  fi
  sleep 0.1
done
