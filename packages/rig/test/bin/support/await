# [await FILE WORD [N]] returns once N lines of FILE (defaults to 1) start
# with WORD. After 60 s
# it fails, printing FILE: a hang guard above every bound of rig run (10 s
# of silence, 15 s for a failed job's processes to end, twice that to end
# them), never a bound on the code's time.

# The lines of FILE starting with WORD, 0 while FILE does not exist.
lines() {
  n=$(grep -c "^$2" "$1" 2>/dev/null)
  echo "${n:-0}"
}

i=0
while [ "$(lines "$1" "$2")" -lt "${3:-1}" ]; do
  i=$((i + 1))
  if [ $i -gt 600 ]; then
    echo "await: fewer than ${3:-1} lines starting with '$2' in $1 after 60 s:" >&2
    cat "$1" >&2
    exit 1
  fi
  sleep 0.1
done
