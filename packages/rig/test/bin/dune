; A hang in rig run ends its file after 300 s, above the longest file's
; run.

(cram
 (package rig)
 (enabled_if
  (<> %{os_type} Win32))
 (timeout 300)
 (deps
  %{bin:rig}
  support/env.sh
  support/ssh
  support/curl
  support/await
  support/state
  support/gone
  support/ctl.exe
  support/firmware_test.exe
  support/sig.exe
  support/gap.exe
  support/high.exe
  support/version))

; rig run's agents listen on the loopback, which opam's sandbox on macOS
; refuses, and dune runs a cram file whole or not at all. These files skip
; the release profile on macOS, which opam builds in; macOS dev builds,
; raven's CI included, still run them.

(cram
 (applies_to agent descriptors hung interrupt machines restart run start)
 (enabled_if
  (or
   (<> %{system} macosx)
   (<> %{profile} release))))

; sandbox-exec is macOS's, and cannot run inside opam's sandbox there.

(cram
 (applies_to refused)
 (enabled_if
  (and
   (= %{system} macosx)
   (<> %{profile} release))))
