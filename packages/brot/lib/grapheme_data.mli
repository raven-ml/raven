(** The Unicode 17.0.0 properties grapheme clusters are made of, generated by
    [test/gen/gen_grapheme.py].

    Code points from [starts.(k)] up to [starts.(k + 1) - 1] have the class
    [Char.code classes.[k]]: its Grapheme_Cluster_Break in bits 0 to 3 (Other,
    CR, LF, Control, Extend, ZWJ, Regional_Indicator, Prepend, SpacingMark, L,
    V, T, LV, LVT, numbered from 0), its Indic_Conjunct_Break in bits 4 and 5
    (None, Consonant, Extend, Linker) and Extended_Pictographic in bit 6. *)

val unicode_version : string
(** [unicode_version] is the version of the data, ["17.0.0"]. *)

val starts : int array
(** [starts] are the first code points of the ranges, ascending from [0]. *)

val classes : string
(** [classes] holds one class per range. *)
