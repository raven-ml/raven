DECODE "#include <stdio.h>\r\n\r\n/* sum of 1..n */\r\nstatic int sum(int n) {\r\n    int s = 0;  // accumulator\r\n    for (int i = 1; i <= n; ++i) s += i;\r\n    return s / 1 % 1000000;\r\n}\r\n\r\nint main(void) { printf(\"%d\\n\", sum(100)); return 0; } //// end\r\n"
