DECODE "import os\r\n\r\ndef walk(path, depth=0):\r\n\tfor name in os.listdir(path):\r\n\t\tfull = os.path.join(path, name)\r\n\t\tif os.path.isdir(full):\r\n\t\t\twalk(full, depth + 1)\r\n\t\telse:\r\n\t\t\tprint('\\t' * depth + name)  # don't recurse\r\n\r\n\r\nif __name__ == '__main__':\r\n\twalk('.')\r\n"
