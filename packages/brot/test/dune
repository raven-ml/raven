(data_only_dirs fixtures scripts)

; Data-file location shared by both suites below; a module cannot belong to
; two stanzas, so it is a library.
(library
 (name fixture)
 (modules fixture)
 (libraries windtrap))

(tests
 (names
  test_tokenization
  test_vocab
  test_encoding
  test_unicode
  test_bpe
  test_unigram
  test_wordpiece
  test_hf_tokenizers
  test_processors
  test_pretokenizers
  test_added_tokens
  test_json)
 (modules
  test_tokenization
  test_vocab
  test_encoding
  test_unicode
  test_bpe
  test_unigram
  test_wordpiece
  test_hf_tokenizers
  test_processors
  test_pretokenizers
  test_added_tokens
  test_json)
 (package brot)
 (deps
  (glob_files fixtures/parity/*)
  ; Downloaded by bench/download_data.sh; a missing tokenizer is skipped
  ; unless BROT_REQUIRE_FIXTURES is set.
  (glob_files %{project_root}/packages/brot/bench/data/*.json))
 (libraries brot fixture windtrap unix jsont jsont.bytesrw))

; These two suites run twice: the native binary exercises the C kernels, the
; byte_complete one (stubs linked statically; a plain .bc could not find them)
; the OCaml reference that Sys.backend_type selects. The tests stanza runs
; only the native exe on runtest, so the bytecode runs are explicit rules.
(tests
 (names test_parity test_kernels)
 (modules test_parity test_kernels)
 (modes exe byte_complete)
 (package brot)
 (deps
  (glob_files fixtures/parity/*)
  (glob_files %{project_root}/packages/brot/bench/data/*.json))
 (libraries brot fixture windtrap unix jsont jsont.bytesrw))

(rule
 (alias runtest)
 (package brot)
 (deps
  (glob_files fixtures/parity/*)
  (glob_files %{project_root}/packages/brot/bench/data/*.json))
 (action
  ; Bytecode runs the whole suite ~8x slower; the default slow-test threshold
  ; would flag tests that are fast natively.
  (run %{dep:test_parity.bc.exe} --slow-threshold 10)))

(rule
 (alias runtest)
 (package brot)
 (deps
  (glob_files fixtures/parity/*)
  (glob_files %{project_root}/packages/brot/bench/data/*.json))
 (action
  (run %{dep:test_kernels.bc.exe} --slow-threshold 10)))

; The native-vs-bytecode differential: the same deterministic dump from the
; kernel and from the reference must be byte-identical. Both files are build
; targets, so a difference fails outright rather than offering promotion.
(executable
 (name dump_kernels)
 (modules dump_kernels)
 (modes exe byte_complete)
 (libraries brot))

(rule
 (deps
  (glob_files fixtures/parity/*)
  (glob_files %{project_root}/packages/brot/bench/data/*))
 (action
  (with-stdout-to
   dump.native
   (run %{dep:dump_kernels.exe}))))

(rule
 (deps
  (glob_files fixtures/parity/*)
  (glob_files %{project_root}/packages/brot/bench/data/*))
 (action
  (with-stdout-to
   dump.byte
   (run %{dep:dump_kernels.bc.exe}))))

(rule
 (alias runtest)
 (package brot)
 (action
  (diff dump.native dump.byte)))
