(data_only_dirs data)

(executable
 (name bench_brot)
 (modules bench_brot)
 (libraries brot thumper unix))

; Throughput over a large corpus, run by hand (see bench_owt.ml); not on any
; alias.
(executable
 (name bench_owt)
 (modules bench_owt)
 (libraries brot unix))

; Not attached to runtest on purpose: run with `dune build @bench`
; (or run the built exe directly; `list` prints case ids).

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend
 ; for cores and distort measurements.
 (locks %{project_root}/bench)
 (deps
  (source_tree data))
 (action
  (progn
   (run %{exe:bench_brot.exe})
   (diff? brot.thumper brot.thumper.corrected))))
