(test
 (name test_ptree)
 (package ppx_ptree)
 (modules test_ptree test_signature)
 (libraries nx nx.array nx.quant nx.wide rig vega kaun windtrap)
 (preprocess
  (pps ppx_ptree)))

(test
 (name test_expansion)
 (package ppx_ptree)
 (modules test_expansion)
 (libraries ppxlib ppxlib.astlib ppx_ptree windtrap)
 (link_flags
  (:standard -linkall))
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_expansion.ml test_expansion.ml.corrected))))

(executable
 (name pp)
 (modules pp)
 (libraries ppxlib ppx_ptree)
 (link_flags
  (:standard -linkall)))

; OCaml's errors in derived walks. ocamlc hands -ppx to the platform shell,
; and cmd.exe cannot start a "./" program, so these cases do not run on
; Windows.

(cram
 (applies_to typing)
 (package ppx_ptree)
 (enabled_if
  (and
   (<> %{system} mingw64)
   (<> %{system} win64)))
 (deps %{exe:pp.exe} %{bin:ocamlc}))
