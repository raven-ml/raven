; The suites compile without naming a device and assert CPU semantics; pin
; the process-wide default so they do not auto-select a GPU backend.

(env
 (_
  (env-vars
   (DEV CPU))))

(test
 (name test_ptree)
 (package ppx_ptree)
 (modules test_ptree test_signature)
 (libraries nx rune vega kaun windtrap)
 (preprocess
  (pps ppx_ptree)))

(test
 (name test_locations)
 (package ppx_ptree)
 (modules test_locations)
 (libraries ppxlib ppx_ptree windtrap)
 (link_flags -linkall)
 (deps
  (glob_files cases/*.ml))
 (action
  (setenv
   PPX_PTREE_CASE
   %{dep:cases/abstract.ml}
   (run %{test}))))

(executable
 (name pp)
 (modules pp)
 (libraries ppxlib ppx_ptree)
 (link_flags -linkall))

(cram
 (package ppx_ptree)
 (deps
  %{exe:pp.exe}
  (glob_files cases/*.ml)))

; The expansions a reader can check by eye.

(rule
 (alias runtest)
 (targets record.actual variant.actual group.actual)
 (deps
  (:pp pp.exe))
 (action
  (progn
   (with-stdout-to
    record.actual
    (run ./%{pp} -impl %{dep:expansion_cases/record.ml}))
   (with-stdout-to
    variant.actual
    (run ./%{pp} -impl %{dep:expansion_cases/variant.ml}))
   (with-stdout-to
    group.actual
    (run ./%{pp} -impl %{dep:expansion_cases/group.ml}))
   (diff expansion_cases/record.expected record.actual)
   (diff expansion_cases/variant.expected variant.actual)
   (diff expansion_cases/group.expected group.actual))))

; Errors the compiler reports in generated code, at the source part. ocamlc
; hands -ppx to the platform shell, and cmd.exe cannot start a "./" program,
; so these cases do not run on Windows.

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{system} mingw64)
   (<> %{system} win64)))
 (targets
  missing_walk.actual
  missing_ptree.actual
  walk_mistyped.actual
  walk_wrong_type.actual
  ptree_other_type.actual)
 (deps
  (:pp pp.exe))
 (action
  (progn
   (with-stderr-to
    missing_walk.actual
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -color
      never
      -c
      -ppx
      "./%{pp} --as-ppx"
      %{dep:compiler_cases/missing_walk.ml}
      -o
      missing_walk.cmo)))
   (with-stderr-to
    missing_ptree.actual
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -color
      never
      -c
      -ppx
      "./%{pp} --as-ppx"
      %{dep:compiler_cases/missing_ptree.ml}
      -o
      missing_ptree.cmo)))
   (with-stderr-to
    walk_mistyped.actual
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -color
      never
      -c
      -ppx
      "./%{pp} --as-ppx"
      %{dep:compiler_cases/walk_mistyped.ml}
      -o
      walk_mistyped.cmo)))
   (with-stderr-to
    walk_wrong_type.actual
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -color
      never
      -c
      -ppx
      "./%{pp} --as-ppx"
      %{dep:compiler_cases/walk_wrong_type.ml}
      -o
      walk_wrong_type.cmo)))
   (with-stderr-to
    ptree_other_type.actual
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -color
      never
      -c
      -ppx
      "./%{pp} --as-ppx"
      %{dep:compiler_cases/ptree_other_type.ml}
      -o
      ptree_other_type.cmo)))
   (diff compiler_cases/missing_walk.expected missing_walk.actual)
   (diff compiler_cases/missing_ptree.expected missing_ptree.actual)
   (diff compiler_cases/walk_mistyped.expected walk_mistyped.actual)
   (diff compiler_cases/walk_wrong_type.expected walk_wrong_type.actual)
   (diff compiler_cases/ptree_other_type.expected ptree_other_type.actual))))
