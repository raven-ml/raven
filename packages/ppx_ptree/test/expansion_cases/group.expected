type 'a tree =
  | Leaf of 'a 
  | Node of 'a tree list 
and 'a t = {
  root: 'a tree ;
  window: int option [@ptree.int ]}
and state = {
  steps: Nx.int32_t ;
  index: Cache_index.t }[@@deriving ptree]
include
  struct
    let _ = fun (_ : 'a tree) -> ()
    let _ = fun (_ : 'a t) -> ()
    let _ = fun (_ : state) -> ()
    let rec walk_tree :
      'a 'b . ('a, 'b) Nx.Ptree.Walk.cursor -> 'a tree -> 'b tree =
      fun ptree__c ->
        function
        | Leaf ptree__0 ->
            (Nx.Ptree.Walk.case ptree__c "Leaf";
             (let ptree__0 = Nx.Ptree.Walk.leaf ptree__c ptree__0 in
              Leaf ptree__0))
        | Node ptree__0 ->
            (Nx.Ptree.Walk.case ptree__c "Node";
             (let ptree__0 = Nx.Ptree.Walk.list walk_tree ptree__c ptree__0 in
              Node ptree__0))
    and walk : 'a 'b . ('a, 'b) Nx.Ptree.Walk.cursor -> 'a t -> 'b t =
      fun ptree__c ptree__x ->
        let ptree__f_root =
          Nx.Ptree.Walk.field ptree__c "root" walk_tree ptree__x.root in
        let ptree__f_window =
          Nx.Ptree.Walk.field ptree__c "window"
            (Nx.Ptree.Walk.option Nx.Ptree.Walk.int) ptree__x.window in
        { root = ptree__f_root; window = ptree__f_window }
    and walk_state : 'a 'b . ('a, 'b) Nx.Ptree.Walk.cursor -> state -> state
      =
      fun ptree__c ptree__x ->
        let ptree__f_steps =
          Nx.Ptree.Walk.field ptree__c "steps" Nx.Ptree.Walk.tensor
            ptree__x.steps in
        let ptree__f_index =
          Nx.Ptree.Walk.field ptree__c "index"
            (Nx.Ptree.Walk.structure Cache_index.ptree) ptree__x.index in
        { steps = ptree__f_steps; index = ptree__f_index }
    let _ = walk_tree
    and _ = walk
    and _ = walk_state
    let ptree_state : state Nx.Ptree.t =
      Nx.Ptree.instantiate (module
        struct type nonrec _ t = state
               let walk = walk_state
               let _ = walk end)
    let _ = ptree_state
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
