(executable
 (name bench_norn)
 (modules bench_norn)
 (libraries nx norn norn.model posteriordb rig rig.cuda rune thumper unix))

; Not attached to runtest on purpose: run with `dune build @bench`
; (or run the built exe directly; `list` prints case ids).

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend
 ; for cores and distort measurements.
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper)
  ../test/model/support/posteriordb.golden)
 (action
  (progn
   (run %{exe:bench_norn.exe})
   (run %{exe:bench_norn.exe} compile))))

; The ensemble sampler's chains for ensemble_gate.py.

(executable
 (name ensemble_gate)
 (modules ensemble_gate)
 (libraries nx nx.io norn))
