(executable
 (name make_store)
 (libraries munin))

(cram
 (package munin)
 (deps make_store.exe %{bin:munin}))

; posix.t holds a run open through a fifo, which Windows lacks, and prints
; paths, which Windows spells with \.

(cram
 (package munin)
 (applies_to posix)
 (enabled_if
  (<> %{os_type} Win32)))

; A run reads crashed only to a reader under its writer's boot, which only
; Linux and macOS name (Munin.Store_format, status).

(cram
 (package munin)
 (applies_to crashed)
 (enabled_if
  (or
   (= %{os} linux)
   (= %{os} macos))))
