; NVIDIA's GPUs, read through rig.nv.nvidia on Linux alone: NVIDIA's kernel
; driver that it reaches is Linux's, and its C has no Windows path. munin.sys
; selects Nvidia.read from this library where it is enabled.

(library
 (name munin_sys_nvidia)
 (package munin)
 (enabled_if
  (= %{system} linux))
 (libraries rig.nv.nvidia))
