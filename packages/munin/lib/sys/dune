(library
 (name munin_sys)
 (public_name munin.sys)
 (private_modules sysstat)
 (libraries unix str munin threads.posix)
 (foreign_stubs
  (language c)
  (names sysstat_stubs))
 (c_library_flags
  (:include c_library_flags.sexp)))

; The stubs read CPU and memory statistics from IOKit on macOS.

(rule
 (target c_library_flags.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "(-framework IOKit -framework CoreFoundation)"))))

(rule
 (target c_library_flags.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))
