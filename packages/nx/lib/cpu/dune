; Kernels for host memory.
;
; On x86-64 every unit but target.c is compiled for x86-64-v3 (AVX2, FMA,
; F16C and BMI2), which nx.cpu requires, and with gcc for Windows with
; vector moves that do not assume the stack 32-byte aligned (probe/v3.ml
; says why). target.c is compiled for the baseline, so that its check of
; the host, and everything that runs before it, runs on any x86-64.
; gemm_vnni.c takes AVX-VNNI-INT8's instructions on top where the C
; compiler has them (probe/vnni.ml asks it). gemm_neon.c holds arm64's
; kernels and gemm_avx2.c x86-64's, each empty off its architecture;
; gemm_amx.c the M1 matrix unit's, empty off Apple's arm64.
;
; gcc vectorises at -O2 only the loops that need no remainder and no check
; of their pointers' overlap, so loops of a run-time count stay scalar
; there: its dynamic cost model vectorises them as clang does at -O2.
; gcc also keeps a loop scalar where its selects join more than four
; values in one place, as the special values of log, log2, log1p and pow
; do: a bound of 16 vectorises every kind. probe/gcc.ml gives these
; settings to gcc under any name, a cross compiler's such as
; x86_64-w64-mingw32-gcc included, and none to clang.

(library
 (name nx_cpu)
 (public_name nx.cpu)
 (libraries nx_array nx_kernel rig rig.pool)
 (foreign_stubs
  (language c)
  (include_dirs ../array ../kernel)
  (flags :standard (:include vector_flags.sexp))
  (names target))
 (foreign_stubs
  (language c)
  (include_dirs ../array ../kernel)
  (flags :standard (:include vector_flags.sexp) (:include v3_flags.sexp))
  (names job walk stage copy apply map rows reduce index sort assemble convert gemm gemm_complex gemm_quads gemm_runs gemm_rounded gemm_scales gemm_segments gemm_view gemm_generic gemm_neon gemm_avx2 gemm_amx linalg fft))
 (foreign_stubs
  (language c)
  (include_dirs ../array ../kernel)
  (flags :standard (:include v3_flags.sexp) (:include vnni_flags.sexp))
  (names gemm_vnni)))

(rule
 (target v3_flags.sexp)
 (enabled_if
  (= %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (run %{ocaml} %{dep:probe/v3.ml} %{cc}))))

(rule
 (target v3_flags.sexp)
 (enabled_if
  (<> %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

(rule
 (target vnni_flags.sexp)
 (enabled_if
  (= %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (run %{ocaml} %{dep:probe/vnni.ml} %{cc}))))

(rule
 (target vnni_flags.sexp)
 (enabled_if
  (<> %{architecture} amd64))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

(rule
 (target vector_flags.sexp)
 (action
  (with-stdout-to
   %{target}
   (run %{ocaml} %{dep:probe/gcc.ml} %{cc}))))
