; The benchmark calls the backend's private owned-GEMM hook without using Nx_cpu
; from OCaml. Keep the backend archive live for single-pass ELF linkers.

(executable
 (name bench_owned_gemm)
 (modules bench_owned_gemm)
 (libraries nx_cpu nx_array nx_dtype nx.device thumper)
 (link_flags -linkall)
 (foreign_stubs
  (language c)
  (names owned_gemm_stubs)
  (flags :standard -I ..)))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_owned_gemm.exe})))
