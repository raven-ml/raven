; nx links no driver: a program opens its devices with rig's drivers.

(library
 (name nx)
 (public_name nx)
 (modules :standard \ prelude)
 (modules_without_implementation ptree_intf)
 (private_modules
  grid
  device
  placement
  value
  move
  op
  route
  place
  kernels
  dispatch
  intercept
  entry
  frontend
  special
  special_tables
  samplers
  ptree
  ptree_intf)
 (libraries
  nx_dtype
  nx_array
  nx_backend
  nx_cpu
  rig)
 (foreign_stubs
  (language c)
  (names nx_claim_stubs nx_format_stubs))
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

; The toplevel prints a float through the C library's printf, whose digits and
; exponents Windows' msvcrt writes otherwise (5.5511151231257827e-017): the
; examples' expected floats are POSIX's.

(mdx
 (package nx)
 (files nx.mli)
 (preludes prelude.ml)
 (enabled_if
  (and
   (<> %{profile} sanitize)
   (<> %{profile} tsan)
   (<> %{os_type} Win32)))
 (libraries nx unix))
