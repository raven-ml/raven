; nx links no vendor runtime: a vendor's devices come from its own library
; (nx.cuda, nx.metal, nx.nv, nx.amd).

(library
 (name nx)
 (public_name nx)
 (modules :standard \ prelude)
 (modules_without_implementation ptree_intf)
 (private_modules
  grid
  device
  placement
  value
  move
  op
  route
  place
  kernels
  dispatch
  intercept
  entry
  frontend
  special
  special_tables
  samplers
  ptree
  ptree_intf)
 (libraries
  nx_dtype
  nx_array
  nx_backend
  nx_cpu
  nx_device)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

(mdx
 (package nx)
 (files nx.mli)
 (preludes prelude.ml)
 (libraries nx unix))
