(test
 (name test_backend_c)
 (modules test_backend_c)
 (libraries nx_c nx_dtype nx.core nx.device windtrap)
 (foreign_stubs
  (language c)
  (names nx_c_test_stubs)
  (flags :standard -I ..)))

; These two suites call private C symbols from the backend archive. -linkall
; keeps that archive live even though no OCaml value from Nx_backend is used;
; otherwise single-pass ELF linkers see the test stub references too late.

(test
 (name engine_test)
 (modules engine_test)
 (libraries nx_c nx_dtype nx.device unix windtrap)
 (link_flags -linkall)
 (foreign_stubs
  (language c)
  (names nx_c_selftest)
  (flags :standard -I ..)))

(test
 (name kernel_test)
 (modules kernel_test)
 (libraries nx_c nx_dtype nx.device nx_c_test_buf windtrap)
 (link_flags -linkall)
 (foreign_stubs
  (language c)
  (names kernel_test_stubs)
  (flags :standard -I ..)))

(test
 (name matmul_test)
 (modules matmul_test)
 (libraries nx_c nx_dtype nx.device nx_c_test_buf windtrap)
 (foreign_stubs
  (language c)
  (names matmul_test_stubs)
  (flags :standard -I ..)))

(executable
 (name linalg_test)
 (modules linalg_test)
 (libraries nx_c nx_dtype nx.device nx_c_test_buf windtrap))

(executable
 (name eig_test)
 (modules eig_test)
 (libraries nx_c nx_dtype nx.device nx_c_test_buf))

(executable
 (name fold_stress_test)
 (modules fold_stress_test)
 (libraries nx_c nx.core nx.device windtrap))

(rule
 (alias backend-stress)
 (action
  (progn
   (run %{exe:linalg_test.exe})
   (run %{exe:eig_test.exe})
   (run %{exe:fold_stress_test.exe}))))

(library
 (name nx_c_test_buf)
 (modules nx_c_test_buf)
 (libraries nx.device nx.dtype nx.core))
