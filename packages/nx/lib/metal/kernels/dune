; nx.metal's metallib, which build.sh compiles by hand on a Mac with the
; Metal toolchain. It is not committed: a checkout without it fails here,
; naming the script.

(rule
 (targets kernels.metallib)
 (mode fallback)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (echo "packages/nx/lib/metal/kernels/kernels.metallib is missing: build it with `packages/nx/lib/metal/kernels/build.sh`, or copy it in\n")
   (system "exit 1"))))

; The metallib nx.metal embeds: the one build.sh makes from the tree's
; sources, listed here in build.sh's order. A metallib from older sources
; fails the build. The harness's metallib is checked the same way
; (test/metal/support).

(executable
 (name fresh)
 (enabled_if
  (= %{system} macosx))
 (modules fresh stamp))

(rule
 (targets embedded.metallib)
 (enabled_if
  (= %{system} macosx))
 (action
  (progn
   (chdir
    %{workspace_root}
    (run
     %{exe:fresh.exe}
     %{dep:kernels.metallib}
     %{dep:build.sh}
     %{dep:../kernels.h}
     %{dep:../../array/nx_dtype.h}
     %{dep:src/elements.h}
     %{dep:src/contract.metal}))
   (copy kernels.metallib embedded.metallib))))
