; nx.amd: nx's kernels for AMD GPUs of RDNA4, compiled ahead of time into a
; gfx12-generic code object (kernels/) and embedded, planned in OCaml and
; launched as rig's Launch parts, one submission a call. kernels/gen.py
; writes kernels.ml from kernels/src/kernels.h, which the device code reads.
; nx_amd_fft_stubs.c makes the transforms' tables on the host in double-double
; arithmetic, without contraction, so that they have the same bits on every
; host.

(library
 (name nx_amd)
 (public_name nx.amd)
 (libraries nx_array nx_kernel rig)
 (foreign_stubs
  (language c)
  (include_dirs ../kernel)
  (extra_deps kernels/embedded.co ../kernel/nx_kernel.h)
  (flags :standard -DNX_AMD_CODE_OBJECT=kernels/embedded.co)
  (names nx_amd_stubs))
 (foreign_stubs
  (language c)
  (flags :standard -ffp-contract=off)
  (names nx_amd_fft_stubs)))
