; nx.cpu's floors for the kernel bench: loops that move or read a row's
; bytes and fused multiply-adds at their peak, in C. They take the vector
; flags and, on x86-64, the instructions of nx.cpu's floor that it installs
; (lib/cpu/dune), so that the compiler builds their loops as it does the
; kernels'.

(library
 (name nx_cpu_floors)
 (modules nx_cpu_floors)
 (libraries nx_array rig rig.pool thumper)
 (foreign_stubs
  (language c)
  (include_dirs
   (lib rig.pool))
  (flags
   :standard
   (:include %{lib:nx.cpu:vector_flags.sexp})
   (:include %{lib:nx.cpu:avx2_flags.sexp}))
  (names nx_cpu_bench_stubs nx_cpu_bench_fma)))
