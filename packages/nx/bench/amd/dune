; bench_amd.exe holds the AMD rows against this machine's baseline;
; bench_amd.exe gate prints their device times and floors, and
; bench_amd.exe compare their idle times for compare.py.

(executable
 (name bench_amd)
 (modules rows bench_amd)
 (libraries
  nx
  nx_array
  nx_kernel
  nx_cpu
  nx_amd
  nx_amd_support
  nx_gpu_ref
  rig
  thumper
  unix))

(rule
 (alias bench)
 (locks %{workspace_root}/bench %{workspace_root}/gpu)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_amd.exe})))
