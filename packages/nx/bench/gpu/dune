(executable
 (name bench_nx_gpu)
 (modules bench_nx_gpu)
 (libraries nx nx_array rig rig.gpus rig_cuda_support thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench %{workspace_root}/gpu)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_nx_gpu.exe})))

; The host reference the GPU kernel libraries' suites and benches check
; results against.

(library
 (name nx_gpu_ref)
 (modules nx_gpu_ref)
 (libraries nx_array)
 (foreign_stubs
  (language c)
  (include_dirs ../../lib/array)
  (names ref nx_gpu_ref_stubs)))
