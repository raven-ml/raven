; nx links no vendor runtime: these suites link nx, and the build refuses them
; if any vendor's library reaches them. Metal's runtime exists on macOS alone,
; and links_no_metal checks it there.

(tests
 (names
  test_placement
  test_rng
  test_ptree
  test_values
  test_creation
  test_indexing
  test_movement
  test_properties
  test_elementwise
  test_reductions
  test_sorting
  test_windows
  test_fft
  test_runtime
  test_backend
  test_conformance
  test_buffers
  test_intercept
  test_allocation
  test_lost
  test_bit
  test_segments
  test_accuracy
  test_special)
 (package nx)
 (modules :standard \ test_linalg test_format links_no_metal)
 (libraries
  nx.dtype
  nx
  nx.array
  nx.backend
  nx.cpu
  nx.device
  unix
  windtrap
  nx_test)
 (deps
  (glob_files golden/special/*.golden))
 (forbidden_libraries
  nx.cuda.device
  nx.nv.device
  nx.amd.device
  nx.remote.device
  nx.rdma.device))

; The linear algebra suite runs as four shards, which dune runs in parallel.

(executable
 (name test_linalg)
 (modules test_linalg)
 (libraries nx windtrap nx_test)
 (forbidden_libraries
  nx.cuda.device
  nx.nv.device
  nx.amd.device
  nx.remote.device
  nx.rdma.device))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 1/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 2/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 3/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 4/4)))

(test
 (name test_format)
 (package nx)
 (modules test_format)
 (libraries nx nx.dtype windtrap)
 (deps golden/float_text.txt)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_format.ml test_format.ml.corrected))))


(executable
 (name links_no_metal)
 (modules links_no_metal)
 (enabled_if
  (= %{system} macosx))
 (libraries nx)
 (forbidden_libraries nx.metal.device))

(rule
 (alias runtest)
 (package nx)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{exe:links_no_metal.exe})))
