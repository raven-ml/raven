; nx links no driver: these suites link nx, and the build refuses them if any
; of rig's GPU drivers reaches them.

(tests
 (names
  test_rng
  test_ptree
  test_values
  test_creation
  test_indexing
  test_movement
  test_properties
  test_elementwise
  test_reductions
  test_sorting
  test_windows
  test_fft
  test_runtime
  test_conformance
  test_buffers
  test_intercept
  test_allocation
  test_lost
  test_bit
  test_segments
  test_accuracy
  test_special)
 (package nx)
 (modules :standard \ test_linalg test_format test_backend test_placement)
 (libraries
  nx.dtype
  nx
  nx.array
  nx.backend
  nx.cpu
  rig
  rig.disk
  unix
  windtrap
  nx_test)
 (deps
  (glob_files golden/special/*.golden))
 (forbidden_libraries rig.cuda rig.nv rig.amd rig.metal rig.remote rig.mlx5))

; These suites open a GPU, where the machine has one, for a device without a
; backend.

(tests
 (names test_backend test_placement)
 (package nx)
 (modules test_backend test_placement)
 (locks %{workspace_root}/gpu)
 (libraries
  nx
  nx.array
  nx.backend
  nx.cpu
  nx.dtype
  rig
  rig.disk
  rig.gpus
  windtrap
  nx_test))

; The linear algebra suite runs as four shards, which dune runs in parallel.

(executable
 (name test_linalg)
 (modules test_linalg)
 (libraries nx windtrap nx_test)
 (forbidden_libraries rig.cuda rig.nv rig.amd rig.metal rig.remote rig.mlx5))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 1/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 2/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 3/4)))

(rule
 (alias runtest)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --shard 4/4)))

(test
 (name test_format)
 (package nx)
 (modules test_format)
 (libraries nx nx.dtype windtrap)
 (deps golden/float_text.txt)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_format.ml test_format.ml.corrected))))
