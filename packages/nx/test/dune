; nx links no vendor runtime: these suites link nx, and the build refuses them
; if any vendor's library reaches them. Metal's runtime exists on macOS alone,
; and links_no_metal checks it there. Each suite's default run excludes its
; slow tests; the slow alias runs them.

(tests
 (names
  test_placement
  test_rng
  test_ptree
  test_values
  test_creation
  test_indexing
  test_movement
  test_properties
  test_elementwise
  test_reductions
  test_sorting
  test_linalg
  test_windows
  test_fft
  test_runtime
  test_backend
  test_conformance
  test_buffers
  test_intercept
  test_allocation
  test_lost)
 (package nx)
 (modules :standard \ test_format links_no_metal)
 (libraries
  nx.dtype
  nx
  nx.array
  nx.backend
  nx.cpu
  nx.device
  unix
  windtrap
  nx_test)
 (forbidden_libraries
  nx.cuda.device
  nx.nv.device
  nx.amd.device
  nx.remote.device
  nx.rdma.device)
 (action
  (run %{test} --exclude-tag slow)))

(rule
 (alias slow)
 (package nx)
 (action
  (run %{exe:test_elementwise.exe} --tag slow)))

(rule
 (alias slow)
 (package nx)
 (action
  (run %{exe:test_indexing.exe} --tag slow)))

(rule
 (alias slow)
 (package nx)
 (action
  (run %{exe:test_linalg.exe} --tag slow)))

(rule
 (alias slow)
 (package nx)
 (action
  (run %{exe:test_reductions.exe} --tag slow)))

(rule
 (alias slow)
 (package nx)
 (action
  (run %{exe:test_rng.exe} --tag slow)))

(test
 (name test_format)
 (package nx)
 (modules test_format)
 (libraries nx windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_format.ml test_format.ml.corrected))))


(executable
 (name links_no_metal)
 (modules links_no_metal)
 (enabled_if
  (= %{system} macosx))
 (libraries nx)
 (forbidden_libraries nx.metal.device))

(rule
 (alias runtest)
 (package nx)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{exe:links_no_metal.exe})))
