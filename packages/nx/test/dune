; Widths past what an array holds, for a function that allocates by its
; widths before its result exists, under a limit of its memory (see
; test_widths.ml). macOS's limits do not bound allocations, so the suite runs
; on Linux and Windows alone.

(test
 (package nx)
 (name test_widths)
 (modules test_widths)
 (foreign_stubs
  (language c)
  (names test_widths_stubs))
 (libraries nx windtrap)
 (enabled_if
  (or
   (= %{system} linux)
   (= %{os_type} Win32))))

; Checks on a device of another machine, served by rig's test agent over the
; loopback.

(test
 (package nx)
 (name test_check_remote)
 (modules test_check_remote)
 (deps support/agent.exe)
 (libraries nx rig rig_remote rig_remote_job windtrap))

; Opens this machine's first GPU: the rule of GPU suites below runs it.

(executable
 (name test_place_gpu)
 (modules test_place_gpu)
 (libraries nx nx_array nx_support rig rig.gpus windtrap))

; The suite above, as the rule of GPU suites below runs it.

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:support/suites.exe} list %{dep:test_place_gpu.exe}))))

; nx's suites that act on a GPU, one after another in one process under the
; lock GPU tests share: those of each gpu.suites, here and in the
; directories below, which each directory writes beside the suites it
; declares. dune holds a rule's locks through its whole action but gives
; each process its own job slot, in the order asked. A suite in a rule's
; second process, or in a rule that took the lock from another, asked after
; every other suite of the runtest and waited, the lock held, until all of
; them had started. One process asks once, at the start. Each suite runs
; from its own directory, as in a rule of its own. nx.kernel's suites read
; its kinds goldens.
;
; The rule depends on the lists, not on the programs they name, so it runs
; unsandboxed, where those programs are. Each list holds its programs'
; digests, so a relinked suite changes its list and reruns the rule.

(rule
 (package nx)
 (alias runtest)
 (locks %{workspace_root}/gpu)
 (deps
  (sandbox none)
  (:suites
   (glob_files_rec gpu.suites))
  (glob_files kernel/golden/kinds/*.golden))
 (action
  (run %{exe:support/suites.exe} run %{suites})))

; place_fixed.t compiles against the installed nx: which walks place_fixed
; takes is a matter of types.

(cram
 (applies_to place_fixed)
 (package nx)
 (deps
  (package nx)))
