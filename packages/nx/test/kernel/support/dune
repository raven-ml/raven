; nx_kinds.h's kinds by name, and their loops as nx.cpu compiles its rows,
; both with the vectoriser flags and, on x86-64, x86-64-v3's instructions,
; whose fma the header requires.

(library
 (name nx_kinds_support)
 (modules nx_kinds_support)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/array ../../../lib/kernel)
  (extra_deps
   ../../../lib/kernel/nx_kinds.h
   ../../../lib/kernel/nx_kinds_real.h
   ../../../lib/kernel/nx_kinds_complex.h
   ../../../lib/array/nx_dtype.h
   nx_kinds_support.h)
  (flags
   :standard
   (:include ../../../lib/cpu/vector_flags.sexp)
   (:include ../../../lib/cpu/v3_flags.sexp))
  (names nx_kinds_support_stubs))
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/array ../../../lib/kernel)
  (extra_deps
   ../../../lib/kernel/nx_kinds.h
   ../../../lib/kernel/nx_kinds_real.h
   ../../../lib/kernel/nx_kinds_complex.h
   ../../../lib/array/nx_dtype.h
   nx_kinds_support.h)
  (flags
   :standard
   (:include ../../../lib/cpu/vector_flags.sexp)
   (:include ../../../lib/cpu/v3_flags.sexp))
  (names nx_kinds_support_loops)))

; The kernel libraries the suite runs its laws through, and nx.cpu's target
