 (modules nx_kernels_support)
 (libraries nx_array nx_kernel nx_cpu rig rig.pool)
 (foreign_stubs
  (language c)
  (include_dirs ../../../lib/cpu ../../../lib/array ../../../lib/kernel)
  (names nx_kernels_support_stubs)))

; What nx.kernel's suites and nx.cpu's share: elements as their bits, and
; the cases, references and laws of copies, casts and maps, of reductions
; and scans, of contractions, of gathers and scatters, and of
; factorisations.

(library
 (name nx_kernel_cases)
 (wrapped false)
 (modules
  elements
  kernels_cases
  reduce_cases
  contract_cases
  index_cases
  linalg_cases
  exact)
 (libraries
  nx_array
  nx_array_gen
  nx_array_support
  nx_cpu
  nx_kernel
  nx_kernels_support
  nx_kinds_support
  rig
  windtrap))
