; nx_kinds.h's kinds by name, and their loops as nx.cpu compiles its rows,
; both with the vectoriser flags and, on x86-64, nx.cpu's floor, AVX2,
; FMA, F16C and BMI2, whose fma the header requires, read from the flags nx.cpu installs
; (lib/cpu/dune).

(library
 (name nx_kinds_support)
 (modules nx_kinds_support)
 (foreign_stubs
  (language c)
  (include_dirs
   (lib nx.array)
   (lib nx.kernel))
  (flags
   :standard
   (:include %{lib:nx.cpu:vector_flags.sexp})
   (:include %{lib:nx.cpu:avx2_flags.sexp}))
  (names nx_kinds_support_stubs))
 (foreign_stubs
  (language c)
  (include_dirs
   (lib nx.array)
   (lib nx.kernel))
  (flags
   :standard
   (:include %{lib:nx.cpu:vector_flags.sexp})
   (:include %{lib:nx.cpu:avx2_flags.sexp}))
  (names nx_kinds_support_loops)))

; The kernel libraries the suite runs its laws through, nx.cuda's on the
; machine's NVIDIA GPU, nx.amd's on its AMD GPU and nx.metal's on its Metal
; GPU among them, and nx.cpu's target tables.

(library
 (name nx_kernels_support)
 (modules nx_kernels_support)
 (libraries
  nx_array
  nx_kernel
  nx_cpu
  nx_cuda
  nx_amd
  nx_metal
  rig
  rig.pool
  rig.cuda
  rig.nv.nvidia
  rig.amd.amdgpu
  rig.metal
  windtrap)
 (foreign_stubs
  (language c)
  (names nx_kernels_support_stubs))
 ; nx_cpu.mli's orders of a contraction's sum: no product fused into a sum
 ; the text keeps apart, and x86-64's fma instruction, from nx.cpu's floor.
 (foreign_stubs
  (language c)
  (flags
   :standard
   -ffp-contract=off
   (:include %{lib:nx.cpu:avx2_flags.sexp}))
  (names nx_kernels_support_order)))

; What nx.kernel's suites and nx.cpu's share: elements as their bits, and
; the cases, references and laws of copies, casts and maps, of reductions
; and scans, of contractions, of gathers and scatters, of factorisations,
; and of calls that do not fit.

(library
 (name nx_kernel_cases)
 (wrapped false)
 (modules
  elements
  kernels_cases
  reduce_cases
  contract_cases
  index_cases
  linalg_cases
  linalg_laws
  exact
  misfit)
 (libraries
  nx_array
  nx_array_gen
  nx_array_support
  nx_cpu
  nx_kernel
  nx_kernels_support
  nx_kinds_support
  rig
  windtrap))
