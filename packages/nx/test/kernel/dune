; nx.kernel's suites through every kernel library the host runs. Their
; nx.cpu groups run here, beside other suites; their nx.cuda, nx.amd and
; nx.metal groups, on the machine's GPUs, run in ../dune's rule of GPU
; suites, as gpu.suites below lists them. There each suite runs its tests
; in 3 processes at once, which together hold at most 12 GiB of the GPU:
; test_fft's transform past 2^31 elements takes 8 GiB. They link the Metal
; suites' property list, which gives their nx.metal groups a Metal cache of
; their own (../metal/support/dune). A tests stanza takes no link_deps, so
; an edit to the list relinks them only with another change.

(tests
 (package nx)
 (names
  test_kinds
  test_kernels
  test_contract
  test_reduce
  test_index
  test_ranges
  test_sort
  test_unique
  test_fold
  test_assemble
  test_linalg
  test_attention
  test_fft)
 (modules
  test_kinds
  test_kernels
  test_contract
  test_reduce
  test_index
  test_ranges
  test_sort
  test_unique
  test_fold
  test_assemble
  test_linalg
  test_attention
  test_fft)
 (libraries
  nx_array
  nx_array_gen
  nx_array_support
  nx_amd
  nx_cpu
  nx_cuda
  nx_kernel
  nx_kernel_cases
  nx_kernels_support
  nx_kinds_support
  nx_metal
  rig
  windtrap)
 (link_flags
  (:standard
   (:include ../metal/support/plist_flags.sexp)))
 (deps
  (glob_files golden/kinds/*.golden))
 (action
  (setenv
   NX_KERNELS
   cpu
   (run %{test}))))

; The suites' groups on the machine's GPUs, as ../dune's rule of GPU suites
; runs them: for each kernel library, the suites of the families it
; computes.

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../support/suites.exe}
    list
    WINDTRAP_FILTER=metal %{dep:test_kernels.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_contract.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_reduce.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_ranges.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_fold.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_assemble.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_fft.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_sort.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_unique.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_linalg.exe} -j 3 --
    WINDTRAP_FILTER=metal %{dep:test_attention.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_kinds.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_kernels.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_contract.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_reduce.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_index.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_ranges.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_sort.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_unique.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_fold.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_assemble.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_linalg.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_attention.exe} -j 3 --
    WINDTRAP_FILTER=cuda %{dep:test_fft.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_kinds.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_kernels.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_contract.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_reduce.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_index.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_ranges.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_fold.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_assemble.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_fft.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_sort.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_unique.exe} -j 3 --
    WINDTRAP_FILTER=amd %{dep:test_linalg.exe} -j 3))))

; Programs and shapes, through nx.cpu alone.

(tests
 (package nx)
 (names test_prog test_shape)
 (modules test_prog test_shape)
 (libraries
  nx_array
  nx_array_gen
  nx_array_support
  nx_cpu
  nx_kernel
  nx_kernel_cases
  rig
  windtrap))
