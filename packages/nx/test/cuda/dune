; Correctness on the NVIDIA GPU 0, through CUDA and again through rig.nv,
; skipping without one. ../dune's rule of GPU suites runs these. The longer
; ones run their tests in 3 processes at once, which together hold at most
; 13 GiB of the GPU: test_cuda's extents past 2^30 and 2^31.

(executable
 (name test_cuda)
 (modules test_cuda)
 (libraries
  nx_array
  nx_kernel
  nx_cpu
  nx_cuda
  nx_cuda_support
  nx_gpu_ref
  rig
  windtrap))

; The matrix routines' laws against nx_cuda.mli's bounds through CUDA, and
; rig.nv's results as CUDA's bits.

(executable
 (name test_cuda_linalg)
 (modules test_cuda_linalg)
 (libraries
  nx_array
  nx_array_support
  nx_cpu
  nx_cuda
  nx_kernel
  nx_kernel_cases
  nx_kernels_support
  rig
  windtrap))

; nx.cuda's scatter Add as nx_cuda.mli states it, through each rig driver.

(executable
 (name test_cuda_moves)
 (modules test_cuda_moves)
 (libraries
  nx_array
  nx_array_support
  nx_kernel
  nx_kernel_cases
  nx_kernels_support
  rig
  windtrap))

; nx.cuda's kinds as nx_cuda.mli states them: nx.cpu's bits at every float
; and complex dtype, through CUDA.

(executable
 (name test_cuda_kinds)
 (modules test_cuda_kinds)
 (libraries
  nx_array
  nx_kernel_cases
  nx_kernels_support
  rig
  windtrap))

; Nx.Rng's draws on a set of nx.cuda's kernels: the host's bits, through
; CUDA.

(executable
 (name test_cuda_draws)
 (modules test_cuda_draws)
 (libraries nx nx_kernels_support nx_rng_support windtrap))

; nx's operations on a set of nx.cuda's kernels.

(executable
 (name test_cuda_nx)
 (modules test_cuda_nx)
 (libraries nx nx_array nx_cuda rig rig.cuda windtrap))

(executable
 (name test_cuda_place)
 (modules test_cuda_place)
 (libraries nx nx_array nx_cuda_support rig rig.cuda windtrap))

; The suites above, as ../dune's rule of GPU suites runs them.

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../support/suites.exe}
    list
    %{dep:test_cuda.exe} -j 3 --
    NX_CUDA_RIG=nv %{dep:test_cuda.exe} -j 3 --
    %{dep:test_cuda_linalg.exe} -j 3 --
    %{dep:test_cuda_moves.exe} -j 3 --
    %{dep:test_cuda_kinds.exe} -j 3 --
    %{dep:test_cuda_draws.exe} -j 3 --
    %{dep:test_cuda_nx.exe} --
    %{dep:test_cuda_place.exe}))))
