; test_amd runs anywhere. test_amd_hw runs on a machine with an AMD GPU and
; skips elsewhere; over PCI it takes a GPU from its kernel driver, so it does
; only when NX_AMD_PCI_TEST names the index of a GPU it may take.

(test
 (name test_amd)
 (modules test_amd)
 (package nx)
 (libraries
  nx.amd.device
  nx.remote.device
  nx.device
  nx.device.support
  unix
  windtrap))

