; nx.metal's spectral routines, through the laws nx.kernel's suites share,
; and their splitting, limits and workspace.

(executable
 (name test_metal_spectral)
 (modules test_metal_spectral)
 (libraries
  nx_array
  nx_kernel
  nx_kernel_cases
  nx_kernels_support
  nx_metal
  rig
  windtrap))

; The suites above that act on the GPU, as ../dune's rule of GPU suites runs
; them.

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../support/suites.exe}
    list
    %{dep:test_metal.exe}
    -j
    3
    --
    %{dep:test_metal_sorts.exe}
    -j
    3
    --
    %{dep:test_pipelines.exe}
    --
    %{dep:test_fft_kernels.exe}
    -j
    3
    --
    %{dep:test_metal_factor.exe}
    -j
    3
    --
    %{dep:test_metal_product.exe}
    -j
    3
    --
    %{dep:test_metal_moves.exe}
    -j
    3
    --
    %{dep:test_metal_spectral.exe}
    -j
    3))))

; The suites above on a machine without Metal, which NX_KERNELS=cpu stands
; for: each declares its tests without opening a device and skips those that
; need one.

(rule
 (alias runtest)
 (package nx)
 (action
  (setenv
   NX_KERNELS
   cpu
   (run %{exe:test_metal.exe}))))

