; nx.io's suites. They read files of the formats written by numpy, torch,
; Python's zipfile, Pillow, GDAL and a minimal PNG writer, with each image's
; pixels as an npy file, as Pillow decodes it, or as PNG-3 states it where
; Pillow differs, and each TIFF raster as the array GDAL was given, which
; gen/generate.py writes into support/. cut/ holds byte ranges of a
; Sentinel-2 file, whose source and licence cut/NOTICE states.

(tests
 (names
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image
  test_pytorch
  test_tiff)
 (modules
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image
  test_pytorch
  test_tiff
  io_support)
 (libraries nx nx_array nx_io nx_support rig unix lz windtrap)
 (deps
  (glob_files support/*)
  (glob_files cut/*))
 ; A stack of 8 MiB, a common system default, so that a parser that recurses
 ; once per nesting level of a file overflows here.
 (action
  (setenv
   OCAMLRUNPARAM
   l=1M
   (run %{test}))))

; Opens this machine's first GPU in a child, so it holds the lock GPU tests
; share.

(test
 (name test_io_gpu)
 (modules test_io_gpu)
 (locks %{workspace_root}/gpu)
 (libraries nx nx_io rig rig.gpus unix windtrap))
