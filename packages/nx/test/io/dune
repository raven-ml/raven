; nx.io's suites. They read files of the formats written by numpy, torch,
; Python's zipfile, Pillow, GDAL, h5py and a minimal PNG writer, with each
; image's pixels as an npy file, as Pillow decodes it, or as PNG-3 states it
; where Pillow differs, each TIFF raster as the array GDAL was given, and
; each HDF5 file's datasets as h5py reads them, which gen/generate.py writes
; into support/. support/wav_* are WAV files libsndfile wrote and every G.711
; code, each with libsndfile's reading of it as an npy file, from a generator
; kept outside the repository. support/flac_* are FLAC streams built from
; known samples, flac.tsv stating each one's samples' MD5, and streams the
; format forbids, one fault each, from the same generators.
; support/librispeech_* is a LibriSpeech file, whose source and licence
; support/NOTICE states. cut/ holds byte ranges of a Sentinel-2 file and cuts
; of the IETF FLAC test files, whose sources and licences cut/NOTICE states.

(tests
 (package nx)
 (names
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image
  test_pytorch
  test_tiff
  test_hdf5
  test_wav
  test_flac
  test_hostile)
 (modules
  test_save
  test_archive
  test_npy
  test_safetensors
  test_gguf
  test_txt
  test_image
  test_pytorch
  test_tiff
  test_hdf5
  test_wav
  test_flac
  test_hostile
  io_support)
 (libraries
  nx
  nx_array
  nx_io
  nx_support
  nx_limit_support
  rig
  unix
  lz
  windtrap)
 (foreign_stubs
  (language c)
  (names io_support_stubs))
 ; windtrap selects tests and raises counts by the environment, so a run
 ; under other settings, as CI's sanitizer step makes, runs the suites again.
 (deps
  (glob_files support/*)
  (glob_files cut/*)
  (env_var WINDTRAP_TAG)
  (env_var WINDTRAP_EXCLUDE_TAG)
  (env_var WINDTRAP_PROP_COUNT))
 ; A stack of 8 MiB, a common system default, so that a parser that recurses
 ; once per nesting level of a file overflows here. The profile's parameters,
 ; the sanitize profile's collector among them (../../dune), follow it.
 (action
  (setenv
   OCAMLRUNPARAM
   "l=1M,%{env:OCAMLRUNPARAM=}"
   (run %{test}))))

; Opens this machine's first GPU in a child: ../dune's rule of GPU suites runs
; it.

(executable
 (name test_io_gpu)
 (modules test_io_gpu)
 (libraries nx nx_io rig rig.gpus unix windtrap))

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../support/suites.exe} list %{dep:test_io_gpu.exe}))))
