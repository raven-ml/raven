(tests
 (package nx)
 (names
  test_dtype
  test_float_text
  test_move
  test_layout
  test_array
  test_door)
 (modules
  test_dtype
  test_float_text
  test_move
  test_layout
  test_array
  test_door)
 (libraries
  nx_array
  nx_array_support
  nx_array_gen
  nx_release_support
  float_reader
  rig
  rig_support
  windtrap)
 ; windtrap selects tests and raises counts by the environment, so a run
 ; under other settings, as CI's sanitizer step makes, runs the suites again.
 (deps
  golden/float_text.txt
  golden/float_digits.txt
  (env_var WINDTRAP_TAG)
  (env_var WINDTRAP_EXCLUDE_TAG)
  (env_var WINDTRAP_PROP_COUNT)))

; Opens this machine's first GPU: ../dune's rule of GPU suites runs it.

(executable
 (name test_array_gpu)
 (modules test_array_gpu)
 (libraries nx_array rig rig.gpus windtrap))

(rule
 (target gpu.suites)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../support/suites.exe} list %{dep:test_array_gpu.exe}))))
