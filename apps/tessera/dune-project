(lang dune 3.21)

; An app is a program, never released: its package holds the stanzas of its
; directory so that a release build of raven's packages (dune build -p)
; leaves them out.

(name tessera)

(version 1.0.0~beta1)

(implicit_transitive_deps false)

(package
 (name tessera)
 (synopsis "TESSERA, an Earth-observation model, on raven")
 (allow_empty)
 (depends
  (ocaml
   (>= 5.5.0))
  dune
  bytesrw
  jera
  jord
  jsont
  kaun
  nx
  ppx_ptree
  rig
  rune
  vega
  ; tests
  (windtrap :with-test)
  (thumper :with-test)))
