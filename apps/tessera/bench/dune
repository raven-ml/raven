; TESSERA's encoding and distillation step on a real tile, against
; pytorch.py's timings of TESSERA's own code. Not attached to runtest:
;   TESSERA_TILE=DIR dune build @apps/tessera/bench/bench

(executable
 (name bench_tessera)
 (libraries tessera nx rig rig.gpus rune vega thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_tessera.exe} --warm)
   (run %{exe:bench_tessera.exe}))))
