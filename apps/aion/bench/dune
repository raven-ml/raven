; AION-1's rows in ../PERFORMANCE.md that a suite holds, against pytorch.py's
; timings of AION-1's own code. Not attached to runtest:
;   AION_DEVICE=cuda dune build @apps/aion/bench/bench
; AION_DEVICE (cpu or a GPU), AION_EAGER and AION_BATCH choose the rows.
; [--warm] compiles the kernels into tolk's disk cache first, in a process of
; its own, so the measurement compiles nothing.

(executable
 (name bench_aion)
 (libraries aion nx rig rig.gpus rune thumper unix))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (env_var AION_DEVICE)
  (env_var AION_BATCH)
  (env_var AION_EAGER)
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_aion.exe} --warm)
   (run %{exe:bench_aion.exe}))))
