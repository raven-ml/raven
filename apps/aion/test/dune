; The laws on synthetic codebooks and small random networks, the codecs and
; the transformer against narrow upstream networks, and Survey on synthetic
; survey files. The fixtures are recorded by the scripts in gen/, run from
; there with `uv run --locked`, with AION-1's code at db7fba6d and torch
; 2.14.1 on the CPU; each file's metadata names its script, and torch's
; version and upstream's commit where torch wrote it.
;
; - upstream/edges.safetensors and goldens.safetensors, the scalar codecs'
;   codebooks (aion-base at 40541618, codecs/NAME/model.safetensors) and
;   upstream's goldens (tests/test_data, through gen/goldens.py):
;     scalars.py CODECS GOLDENS ../upstream
; - upstream/spectrum_*.safetensors, a few-channel spectrum codec, its outputs
;   and their rounding ensemble: spectrum.py --weights narrow ../upstream
; - upstream/image_*.safetensors, a narrow image codec, its outputs and their
;   rounding ensembles: image.py --weights narrow ../upstream
; - upstream/transformer*.safetensors, a narrow AION with random weights, its
;   outputs and their rounding ensemble:
;     transformer.py --weights narrow ../upstream
; - upstream/roar_golden.safetensors, a random-order step on that network and
;   its rounding ensemble: roar.py ../upstream
; - mmu/*, synthetic Multimodal Universe files and the values Survey must read
;   from them: surveys.py ../mmu
;
; parity/ holds AION-1's released weights against upstream's code, outside
; runtest.

(tests
 (names
  test_hub
  test_modality
  test_scalar
  test_spectrum
  test_fsq
  test_lfq
  test_image
  test_codecs
  test_survey
  test_parity
  test_transformer
  test_roar)
 (modules :standard \ test_gpu)
 (libraries aion aion_support nx nx.io kaun.hf rig rune windtrap ymir)
 (deps
  (glob_files upstream/*.safetensors)
  (glob_files mmu/*)))

; test_gpu.exe runs the compiled transformer, draws and codecs, and main.exe,
; on this machine's first GPU against the narrow fixtures, and skips without
; one. It holds the lock GPU tests share.

(test
 (name test_gpu)
 (modules test_gpu)
 (locks %{workspace_root}/gpu)
 (libraries
  aion
  aion_support
  nx
  nx.io
  rig
  rig.gpus
  rune
  tolk.engine
  unix
  windtrap)
 (deps
  ../bin/main.exe
  bin/cache.exe
  (glob_files upstream/*.safetensors)
  (glob_files mmu/*.h5)))
