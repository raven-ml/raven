; The suites, in runtest, on goldens from upstream's own code at 86098128.
; The scripts in gen/ write every golden under upstream/, each run with
; `uv run apps/whisper/test/gen/NAME.py ARGS` from the repository's root, its
; docstring giving ARGS.

; test_tokenizer.exe compares the tokenizers with upstream's own Tokenizer
; (openai/whisper 86098128, whisper/tokenizer.py) over trimmed rank tables.
; upstream/*.tiktoken and upstream/tokenizer.json are written by
; apps/whisper/test/gen/tokenizer.py.

(test
 (package whisper)
 (name test_tokenizer)
 (modules test_tokenizer)
 (libraries whisper whisper_support windtrap)
 (deps
  upstream/tokenizer.json
  (glob_files upstream/*.tiktoken)))

; test_model.exe compares the model with upstream's Whisper class
; (openai/whisper 86098128, whisper/model.py) on a small randomly initialised
; checkpoint, eager and compiled by rune. upstream/small.pt and
; upstream/small.npz, its inputs and upstream's outputs at float32 and
; float64, are written by apps/whisper/test/gen/small_model.py, and
; upstream/heads.json, every release's alignment heads, by
; apps/whisper/test/gen/heads.py.

(test
 (package whisper)
 (name test_model)
 (modules test_model)
 (libraries whisper whisper_support nx nx.io kaun rune windtrap)
 (deps upstream/small.pt upstream/small.npz upstream/heads.json))

; test_decoding.exe compares decoding with upstream's DecodingTask
; (openai/whisper 86098128, whisper/decoding.py) over the trimmed tokenizers.
; upstream/options.json, upstream/filters.json, upstream/filters.npz,
; upstream/decode.pt, upstream/decode.npz, upstream/decode.json and
; upstream/beam.json are written by apps/whisper/test/gen/decoding.py;
; upstream/ratio.json, upstream's compression_ratio (whisper/utils.py) of
; texts under zlib 1.3.2, by apps/whisper/test/gen/ratio.py; and
; upstream/languages.pt, upstream/languages.npz and upstream/languages.json,
; upstream's detect_language on a small multilingual model, by
; apps/whisper/test/gen/languages.py.

(test
 (package whisper)
 (name test_decoding)
 (modules test_decoding)
 (libraries whisper whisper_support nx nx.io kaun rune lz windtrap)
 (deps
  upstream/ratio.json
  upstream/languages.pt
  upstream/languages.npz
  upstream/languages.json
  upstream/options.json
  upstream/filters.json
  upstream/filters.npz
  upstream/decode.pt
  upstream/decode.npz
  upstream/decode.json
  upstream/beam.json
  (glob_files upstream/*.tiktoken)))

; test_english.exe and test_wer.exe compare the normaliser with upstream's
; EnglishTextNormalizer (openai/whisper 86098128,
; whisper/normalizers/english.py) and word error rates with jiwer 4.0.0.
; upstream/normalize.json is written by apps/whisper/test/gen/normalize.py,
; from LibriSpeech's references and upstream's greedy decodes of them
; (apps/whisper/test/gen/subset.py and greedy.py).

(tests
 (package whisper)
 (names test_english test_wer)
 (modules test_english test_wer)
 (libraries whisper whisper_support windtrap)
 (deps upstream/normalize.json))

; test_audio.exe compares the features with upstream's log_mel_spectrogram
; (openai/whisper 86098128, whisper/audio.py). librispeech/ holds a
; LibriSpeech file (CC BY 4.0, librispeech/NOTICE). upstream/audio.npz and
; upstream/int8.flac are written by apps/whisper/test/gen/audio.py, and
; upstream/resample.npz, upstream's load_audio of the WAV and FLAC files of
; other rates and channel counts beside it, which it writes, by
; apps/whisper/test/gen/resample.py.

(test
 (package whisper)
 (name test_audio)
 (modules test_audio)
 (libraries whisper nx nx.io windtrap)
 (deps
  upstream/audio.npz
  upstream/int8.flac
  upstream/resample.npz
  upstream/mono48.flac
  upstream/mono8.wav
  upstream/stereo44.wav
  upstream/stereo16.wav
  upstream/surround48.flac
  upstream/three22.wav
  upstream/mono43650.wav
  upstream/mono47530.wav
  upstream/mono44101.wav
  upstream/stereo96001.wav
  librispeech/7902-96594-0025.flac))

; test_transcript.exe compares the transcribe loop with upstream's transcribe
; (openai/whisper 86098128, whisper/transcribe.py) over a model whose decode
; returns scripted results, and transcribes with a small random model.
; upstream/transcript.json and upstream/transcript.pt are written by
; apps/whisper/test/gen/transcript.py.

(test
 (package whisper)
 (name test_transcript)
 (modules test_transcript)
 (libraries whisper whisper_support nx rune windtrap)
 (deps
  upstream/transcript.json
  upstream/transcript.pt
  upstream/gpt2-1000.tiktoken))

