; Whisper's rows in PERFORMANCE.md, over the released checkpoints and a
; LibriSpeech recording that fetch.py fetches. Not attached to runtest.

(executable
 (name bench_whisper)
 (libraries whisper nx rig rig.gpus rune thumper unix))

; [--warm] compiles the kernels into tolk's disk cache first, in a process of
; its own, so the measurement compiles nothing.

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (progn
   (run %{exe:bench_whisper.exe} --warm)
   (run %{exe:bench_whisper.exe}))))
