# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0~beta1"
synopsis: "Images for OCaml"
description:
  "Images as Nx tensors: their values and conversions between dtypes, colour transfer and alpha, luma, HSV and CIE Lab, sampling at positions under reconstruction kernels, transforms, band-limited resizing, filtering by correlation and Gaussian and median blurs, gradients and their maxima, erosion and dilation, boxes, masks, COCO's run-length encoding, connected components, reconstruction and non-maximum suppression. Every operation is a composition of nx operations, so rune differentiates, batches and compiles it."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["computer-vision" "image-processing" "resizing" "detection" "science"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://github.com/raven-ml/raven/tree/main/contrib/mynd"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.21"}
  "nx" {>= "1.0.0~beta1"}
  "rune" {>= "1.0.0~beta1"}
  "jsont"
  "bytesrw" {with-test}
  "windtrap" {with-test & >= "0.3.1"}
  "rig" {with-test & >= "1.0.0~beta1"}
  "hugin" {with-test & >= "1.0.0~beta1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
