; mynd's rows: sowilo's, timing the calls that replace them, and mynd's own.
; Not attached to runtest: run it with `dune build @contrib/mynd/bench/bench`,
; or run the built exe (`list` prints the rows, `bless` records them).

(executable
 (name bench_mynd)
 (libraries mynd nx thumper))

(rule
 (alias bench)
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench_mynd.exe})))
