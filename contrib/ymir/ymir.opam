# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0~alpha3"
synopsis: "Astronomy for OCaml"
description:
  "Astronomy over Nx tensors. Exact physical units and quantities: a unit is an exact monomial over primes, pi and named symbols with one canonical text, and a conversion is one correctly rounded multiply, or it raises. The background cosmology: expansion rate, distances, volumes and times of a homogeneous universe, batched, compiled and differentiable."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["units" "physical-quantities" "astronomy" "science"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://github.com/raven-ml/raven/tree/main/contrib/ymir"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.21"}
  "nx" {>= "1.0.0~alpha3"}
  "compress" {>= "1.0.0~alpha3"}
  "rune" {with-test & >= "1.0.0~alpha3"}
  "jera" {with-test & >= "1.0.0~alpha3"}
  "windtrap" {with-test & >= "0.2.0"}
  "thumper" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
