(lang dune 3.21)

(name ymir)

(source
 (github raven-ml/raven))

(authors "Thibaut Mattio <thibaut.mattio@gmail.com>")

(maintainers "Thibaut Mattio <thibaut.mattio@gmail.com>")

(license ISC)

(documentation "https://github.com/raven-ml/raven/tree/main/contrib/ymir")

(bug_reports "https://github.com/raven-ml/raven/issues")

(version 1.0.0~alpha3)

(implicit_transitive_deps false)

(generate_opam_files true)

(package
 (name ymir)
 (synopsis "Astronomy for OCaml")
 (description
  "Astronomy over Nx tensors: exact units and quantities, celestial frames and directions, FITS files (headers, images, tile compression, tables, world coordinates), maps from pixels to the sky, aperture photometry with exact cell overlaps, and the background cosmology. Every function is a formula of nx operations, so it runs batched, compiled and differentiated.")
 (depends
  (ocaml
   (>= 5.2.0))
  dune
  (nx
   (>= 1.0.0~alpha3))
  (compress
   (>= 1.0.0~alpha3))
  (rune
   (and
    :with-test
    (>= 1.0.0~alpha3)))
  (jera
   (>= 1.0.0~alpha3))
  (windtrap
   (and
    :with-test
    (>= 0.2.0)))
  (thumper :with-test))
 (tags
  (astronomy units fits cosmology photometry science)))
