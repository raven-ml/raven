(executable
 (name bench_ymir)
 (libraries ymir ymir.fits ymir.spk rune nx nx.ragged thumper))

; Not attached to runtest on purpose: run with `dune build @bench`, or run the
; built exe directly. [--warm] fills tolk's disk cache with what the cases
; compile, so the compiled rows compile nothing while measured.

(rule
 (alias bench)
 ; Serialize bench rules across the workspace: concurrent suites contend for
 ; cores and distort measurements.
 (locks %{workspace_root}/bench)
 (deps
  (glob_files *.thumper)
  ../test/support/survey/hst-acs-drz.fits
  ../test/spk/golden/de440s-2024.bsp)
 (action
  (progn
   (run %{exe:bench_ymir.exe} --warm)
   (run %{exe:bench_ymir.exe}))))
