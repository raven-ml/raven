# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0~beta1"
synopsis: "Earth observation for OCaml"
description:
  "Earth-observation data placed on the Earth: coordinate reference systems (WGS 84, its UTM zones, ETRS89 / TM35FIN) and the transforms between them, grids, polygons and the cells they cover, warps between grids by sampling and by area, bands and what Sentinel-2, Sentinel-1, Landsat, HLS and MODIS products measure, and instants of UTC with the Sun's place at them. Readers of GeoTIFF tags, GeoJSON, ESRI Shapefiles, STAC items and Sentinel-2 product metadata take bytes or values and do no I/O."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: [
  "earth-observation"
  "geospatial"
  "remote-sensing"
  "crs"
  "geotiff"
  "stac"
  "sentinel"
]
homepage: "https://github.com/raven-ml/raven"
doc: "https://github.com/raven-ml/raven/tree/main/contrib/jord"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.21"}
  "nx" {>= "1.0.0~beta1"}
  "jsont"
  "xmlm" {>= "1.4.0"}
  "rune" {with-test & >= "1.0.0~beta1"}
  "bytesrw" {with-test}
  "windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
