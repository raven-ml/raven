(lang dune 3.21)

; ThreadSanitizer: the root dune's tsan profile, with a compiler built with
; ocaml-option-tsan. Its lock is made once with
; dune pkg lock --workspace dune-workspace.tsan dune-tsan.lock

(lock_dir
 (path dune-tsan.lock)
 (depopts ocaml-option-tsan))

(context
 (default
  (profile tsan)
  (lock_dir dune-tsan.lock)))

; Every link names the standard library it records, as dune-workspace says.

(env
 (_
  (link_flags
   (:standard
    -set-runtime-default
    standard_library_default=%{ocaml-config:standard_library_default}))))
