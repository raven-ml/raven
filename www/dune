;; The site: every page, post and page of the docs. Links in the docs are
;; checked against the files they name, so the files Markdown links to are
;; dependencies: Markdown, interfaces, data, and the dune files that make
;; their directories. The API reference is odoc's, written as JSON by the
;; doc-json alias into _doc/_html.

(rule
 (targets
  (dir site))
 (deps
  ../dune-project
  ../CHANGES.md
  (source_tree ../doc)
  (glob_files_rec ../packages/*.md)
  (glob_files_rec ../packages/*.mli)
  (glob_files_rec ../packages/*.csv)
  (glob_files_rec ../packages/dune)
  (glob_files_rec ../contrib/dune-project)
  (glob_files_rec ../contrib/*.md)
  (glob_files_rec ../contrib/*.mli)
  (glob_files_rec ../contrib/dune)
  ../packages/kaun/examples/06-gpt-oss/gpt_oss.ml
  (source_tree pages)
  (source_tree static)
  (alias_rec ../doc-json))
 (action
  (run gen/www.exe .. . site)))

(rule
 (alias check)
 (deps
  (source_tree ../doc)
  (source_tree pages))
 (action
  (run gen/www.exe --check .. .)))
