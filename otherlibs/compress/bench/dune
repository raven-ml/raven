(data_only_dirs data)

(executable
 (name bench_compress)
 (libraries
  compress.deflate
  compress.snappy
  compress.lz4
  compress.zstd
  thumper))

; Not attached to runtest: run with `dune build @otherlibs/compress/bench/bench`
; after reference.py has written the corpora.

(rule
 (alias bench)
 (locks %{project_root}/bench)
 (deps
  (glob_files *.thumper)
  (source_tree data))
 (action
  (run %{exe:bench_compress.exe})))
