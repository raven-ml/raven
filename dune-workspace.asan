(lang dune 3.21)

; AddressSanitizer and UndefinedBehaviorSanitizer: the root dune's sanitize
; profile holds the flags and options.

(context
 (default
  (profile sanitize)))

; Every link names the standard library it records, as dune-workspace says.

(env
 (_
  (link_flags
   (:standard
    -set-runtime-default
    standard_library_default=%{ocaml-config:standard_library_default}))))
