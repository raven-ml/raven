# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0~alpha3"
synopsis: "Compile functions with Rune.jit without Ptree boilerplate"
description:
  "Ppx_jit provides the [@jit] attribute: let[@jit] f (a : A.t) : B.t = ... expands into the input and output Ptree.S modules (derived with ppx_ptree), the Rune.jit2 call, and a wrapper recovering the original function type. The optional payload [@jit { device = \"NV\"; beam = 8 }] is spliced into the Rune.jit2 call."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["ppx" "jit" "machine-learning"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.21"}
  "ppxlib" {>= "0.38.0"}
  "ppx_ptree" {= version}
  "nx" {= version & with-test}
  "rune" {= version & with-test}
  "windtrap" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
