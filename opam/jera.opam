# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0~alpha3"
synopsis: "Numerical methods for OCaml"
description:
  "Numerical methods over Nx tensors: linear and nonlinear systems, minimisation with bounds, quadrature, splines and Chebyshev fits, ordinary, stiff, differential-algebraic, delay and stochastic differential equations, and symplectic splittings. Every solve meets a stated tolerance and reports a status per lane, and Rune differentiates each answer through its own equation."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: [
  "numerical-methods"
  "linear-algebra"
  "optimization"
  "quadrature"
  "interpolation"
  "differential-equations"
]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "dune" {>= "3.21"}
  "nx" {= version}
  "rune" {= version}
  "windtrap" {with-test & >= "0.2.0"}
  "mdx" {with-test}
  "thumper" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
