opam-version: "2.0"
version: "1.0.0~alpha3"
synopsis: "Probabilistic inference for OCaml"
description:
  "Bayesian inference over the user's own structures: distributions, bijectors, a typed model language, samplers batched over chains, Gaussian approximations, draws and diagnostics. Built on Nx and Rune."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["bayesian" "inference" "mcmc" "probabilistic-programming"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.21"}
  "nx" {= version}
  "rune" {= version}
  "windtrap" {with-test & >= "0.2.0"}
  "mdx" {with-test}
  "thumper" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
